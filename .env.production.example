# Production Environment Variables for Schlep Engine
# IMPORTANT: Keep this file secure and never commit to version control

# Application
ENVIRONMENT=production
DEBUG=false
API_VERSION=1.0.0

# Database
DATABASE_URL=postgresql://postgres:SECURE_PASSWORD_HERE@postgres:5432/schlep_engine
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30

# Security
SECRET_KEY=GENERATE_SECURE_SECRET_KEY_HERE
JWT_SECRET=GENERATE_JWT_SECRET_HERE
ENCRYPTION_KEY=GENERATE_ENCRYPTION_KEY_HERE

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Redis (if using)
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=3600

# Email (for notifications)
SMTP_SERVER=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=noreply@your-domain.com
SMTP_PASS=EMAIL_PASSWORD_HERE
SMTP_USE_TLS=true

# Monitoring
SENTRY_DSN=YOUR_SENTRY_DSN_HERE
LOG_LEVEL=INFO

# Backup Configuration
BACKUP_RETENTION_DAYS=30
VULTR_ACCESS_KEY=YOUR_VULTR_ACCESS_KEY_HERE
VULTR_SECRET_KEY=YOUR_VULTR_SECRET_KEY_HERE
VULTR_BUCKET=your-backup-bucket

# Health Monitoring
HEALTH_CHECK_INTERVAL=300
ALERT_EMAIL=admin@your-domain.com

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
BURST_LIMIT=100

# File Upload
MAX_FILE_SIZE=10485760  # 10MB
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx

# Session Management
SESSION_TIMEOUT=3600
MAX_SESSIONS_PER_USER=5