{
  // Server configuration
  server: {
    host: "0.0.0.0",
    port: 8080
  },

  // Storage configuration
  storage: {
    path: "igris.db"
  },

  // Local LLM fallback (v1.1-v1.4)
  local_fallback: {
    enabled: true,  // Enabled with Phi-3 downloaded

    // NEW in v1.4: Select from multiple models
    // Options: "phi-3-mini-4k", "qwen3-8b", "qwen3-14b", "deepseek-v3-2-7b", "glm-4-9b", "llama-4-8b"
    // If not specified, uses model_path for backward compatibility
    selected_model: "phi-3-mini-4k",

    // v1.1-1.3 compatibility: explicit model path (auto-generated if selected_model is set)
    model_path: "models/phi-3-mini-4k-instruct-q4.gguf",

    lora_adapter_path: null,  // Optional: path to LoRA adapter (set automatically by training)

    // GPU offload (llama.cpp, optional)
    n_gpu_layers: 0,
    main_gpu: null,

    // Prompt/KV caching (optional) - disabled for compatibility
    prompt_cache_dir: null,

    // Batch size tuning (optional, llama.cpp --batch-size)
    batch_size: null,

    // Auto-detected from selected_model if not specified (Qwen3-8B default: 8192)
    context_size: 4096,

    threads: 4,
    max_tokens: 512,
    temperature: 0.7,
    cost_per_1k_tokens: 0.0
  },

  // On-Device QLoRA Fine-Tuning (NEW in v1.3)
  lora_training: {
    enabled: false,  // Enable automatic on-device fine-tuning
    trigger_threshold: 100,  // Train after N requests
    max_adapter_size_mb: 64,  // Maximum adapter size in MB
    lora_rank: 8,  // LoRA rank (smaller = faster, less accurate)
    lora_alpha: 16.0,  // LoRA alpha scaling factor
    epochs: 1,  // Training epochs
    batch_size: 4,  // Batch size for training
    learning_rate: 0.0001,  // Learning rate
    adapter_dir: "lora_adapters",  // Directory to store adapters
    encrypt_adapters: true,  // Encrypt adapters at rest (AES-256-GCM)
    auto_load_adapter: true,  // Auto-load latest adapter on startup
    max_training_time_secs: 1800,  // Max training time (30 minutes)
    training_threads: 4  // Number of threads for training
  },

  // Cloud providers (add your API keys)
  providers: [
    {
      id: "openai-gpt4o-mini",
      name: "OpenAI GPT-4o Mini",
      endpoint: "https://api.openai.com/v1",
      model: "gpt-4o-mini",
      api_key_env: "OPENAI_API_KEY",
      cost_per_1k_input: 0.00015,
      cost_per_1k_output: 0.0006,
      capabilities: ["reasoning", "coding"]
    },
    {
      id: "anthropic-haiku",
      name: "Claude 3 Haiku",
      endpoint: "https://api.anthropic.com/v1",
      model: "claude-3-haiku-20240307",
      api_key_env: "ANTHROPIC_API_KEY",
      cost_per_1k_input: 0.00025,
      cost_per_1k_output: 0.00125,
      capabilities: ["reasoning", "coding", "fast"]
    },
    {
      id: "groq-llama70b",
      name: "Groq Llama 3 70B",
      endpoint: "https://api.groq.com/openai/v1",
      model: "llama3-70b-8192",
      api_key_env: "GROQ_API_KEY",
      cost_per_1k_input: 0.0007,
      cost_per_1k_output: 0.0008,
      capabilities: ["fast", "coding"]
    }
  ],

  // Routing configuration
  routing: {
    thompson_sampling: {
      enabled: true,
      exploration_rate: 0.1
    },
    speculative: {
      enabled: true,
      max_providers: 3,
      first_token_timeout_ms: 5000
    },
    council: {
      enabled: true,
      chairman: "anthropic-haiku"
    }
  },

  // Authentication
  auth: {
    enabled: true,
    api_key: "",  // Set via IGRIS_RUNTIME_SECRET / IGRIS_RUNTIME_API_KEY, or use JWT below
    jwt_hs256_secret: null,
    rate_limit_per_minute: 120,
    rate_limit_burst: 20
  },

  // Tool execution (NEW in v1.4)
  tools: {
    enabled: true,
    enable_http: true,
    enable_shell: false,
    enable_filesystem: false,
    allowed_http_domains: ["example.com", "httpbin.org"],
    allowed_shell_commands: [],
    allowed_shell_working_dirs: [],
    allowed_filesystem_paths: [],
    max_execution_time_ms: 30000,
    max_concurrent_executions: 5
  },

  // Planning agent (NEW in v1.5)
  planning: {
    enabled: false,  // Can be enabled per-request with mode="planning"
    max_steps: 5,
    enable_reflection: true,
    enable_tools: true,
    max_tool_calls: 10
  },

  // Real-time execution (NEW in v1.7 - Phase 1, Dev 1)
  rt: {
    enabled: false,  // Enable real-time deterministic execution
    priority_level: 1,  // 0=Low, 1=Normal, 2=High, 3=Critical
    max_concurrent_tasks: 4,  // Maximum concurrent RT tasks
    enable_metrics: true,  // Track latency and deadline metrics
    warn_threshold_ms: 100  // Log warning if latency exceeds this
  },

  // ROS2 Integration (NEW in v1.8 - Phase 2, Dev 6)
  ros2: {
    enabled: false,  // Enable ROS2 integration
    node_name: "igris_agent",  // ROS2 node name
    namespace: "/igris",  // ROS2 namespace
    domain_id: 0,  // ROS2 DDS domain ID
    enable_nav2: false,  // Enable Nav2 integration
    nav2_action_server: "/navigate_to_pose",  // Nav2 action server
    qos_reliability: 1,  // 0=best_effort, 1=reliable
    qos_depth: 10  // QoS history depth
  },

  // Sensors & Actuators (NEW in v1.8 - Phase 2, Dev 7)
  sensors: {
    enable_gpio: false,  // Enable GPIO support (Raspberry Pi, etc.)
    enable_camera: false,  // Enable camera capture
    enable_lidar: false,  // Enable LIDAR scanning
    camera_device: "/dev/video0",  // Camera device path
    camera_width: 640,  // Camera resolution width
    camera_height: 480,  // Camera resolution height
    lidar_connection: "serial",  // LIDAR connection type (serial, udp, tcp)
    lidar_address: "/dev/ttyUSB0",  // LIDAR device/address
    gpio_output_whitelist: [],  // Whitelisted GPIO pins for output
    actuator_whitelist: [],  // Whitelisted actuator actions
    safety_mode: true  // Require confirmation for actuators
  },

  // Safety & Certification (NEW in v1.8 - Phase 2, Dev 8)
  safety: {
    mode: "normal",  // Safety mode: normal, fail_safe, emergency_stop
    enable_watchdog: false,  // Enable watchdog timer
    watchdog_timeout_secs: 30,  // Watchdog timeout in seconds
    auto_failsafe: true,  // Auto-transition to fail-safe on timeout
    enable_audit_log: false,  // Enable audit logging
    audit_log_path: "audit.log",  // Audit log file path
    audit_log_max_entries: 10000,  // Max audit log entries in memory
    iso26262_compliance: false,  // Enable ISO 26262 compliance hooks
    machine_binding_id: null  // Machine binding ID for licensing
  },

  // Swarm Coordination (NEW in v1.8 - Phase 2, Dev 9)
  swarm: {
    enabled: false,  // Enable swarm coordination
    election_timeout_secs: [5, 10],  // Election timeout range (min, max)
    heartbeat_interval_secs: 2,  // Heartbeat interval
    max_agents: 100,  // Maximum agents in swarm
    enable_conflict_resolution: true,  // Enable conflict resolution
    conflict_strategy: "voting"  // Strategy: leader_decides, voting, priority, consensus
  },

  // Fleet Management (NEW in v1.8 - Phase 2, Dev 10)
  fleet: {
    enabled: false,  // Enable fleet management
    overture_endpoint: "https://overture.igris.dev",  // Overture endpoint URL
    agent_id: null,  // Agent ID (auto-generated if null)
    api_key_env: "FLEET_API_KEY",  // Fleet API key environment variable
    enable_tls: true,  // Enable TLS for secure communication
    sync_interval_secs: 300,  // Config sync interval (5 minutes)
    auto_sync_config: true,  // Auto-sync configuration
    enable_telemetry: true,  // Enable telemetry upload
    telemetry_interval_secs: 60  // Telemetry upload interval (1 minute)
  },

  // EscapeVector Graceful Degradation (NEW in v1.9 - Phase 1, P0)
  // Provides 24-hour cached response fallback when all providers fail
  escapevector: {
    enabled: true,  // Enable EscapeVector response caching
    cache_dir: ".escapevector",  // Cache directory path
    min_quality_score: 0.7,  // Minimum quality score to cache response (0.0-1.0)
    auto_cache: true,  // Enable automatic response caching on successful requests
    fallback_threshold_ms: 5000  // Fall back to cache after this many ms of provider failures
  },

  // Federated Learning (NEW in v1.9 - Phase 3, Dev 11)
  federated: {
    enabled: false,  // Enable federated learning
    min_participants: 3,  // Minimum participants for aggregation
    privacy_budget: 1.0,  // Epsilon for differential privacy
    noise_scale: 0.1,  // Noise scale for DP
    enable_differential_privacy: true,  // Enable DP noise
    aggregation_strategy: "federated_averaging",  // Strategy: federated_averaging, weighted_averaging, median, trimmed_mean
    max_update_size_mb: 100,  // Max update size in MB
    update_timeout_secs: 300,  // Update timeout (5 minutes)
    enable_secure_aggregation: false  // Enable secure aggregation (MPC)
  },

  // Dynamic Model Management (NEW in v1.9 - Phase 3, Dev 12)
  model_manager: {
    enabled: false,  // Enable dynamic model management
    auto_select: true,  // Auto-select model based on task
    auto_download: false,  // Auto-download missing models
    max_loaded_models: 2,  // Max models to keep in memory
    models: [
      // Example model specifications
      // {
      //   id: "gpt-4-mini",
      //   path: "models/gpt-4-mini.gguf",
      //   task_types: ["reasoning", "coding"],
      //   max_tokens: 4096,
      //   priority: 10,
      //   memory_mb: 2048
      // }
    ]
  },

  // Human-in-the-Loop (NEW in v1.9 - Phase 3, Dev 13)
  hitl: {
    enabled: false,  // Enable HITL framework
    auto_approve_threshold: 0.9,  // Auto-approve if confidence >= this
    escalation_endpoint: null,  // Optional webhook for escalations
    timeout_secs: 300  // Human approval timeout (5 minutes)
  },

  // Simulation & Testing (NEW in v1.9 - Phase 3, Dev 14)
  simulation: {
    enabled: false,  // Enable simulation mode
    env_type: "virtual_swarm",  // Environment: virtual_swarm, gazebo, isaac_sim
    chaos_enabled: false,  // Enable chaos injection
    failure_rate: 0.1  // Chaos failure rate (10%)
  }
}
