[Unit]
Description=Igris Runtime v1.1 - AI Routing Engine with Local Fallback
After=network.target
Documentation=https://github.com/rapture-fx/system/tree/main/runtime

[Service]
Type=simple
User=igris
Group=igris
WorkingDirectory=/opt/igris-runtime

# Binary path
ExecStart=/opt/igris-runtime/igris-runtime

# Restart policy
Restart=always
RestartSec=10
StartLimitInterval=0

# Environment variables
Environment="RUST_LOG=info"
Environment="IGRIS_CONFIG=/opt/igris-runtime/config.json5"

# Optional: API keys (or use EnvironmentFile)
# Environment="OPENAI_API_KEY=sk-..."
# Environment="ANTHROPIC_API_KEY=sk-ant-..."
# Environment="GROQ_API_KEY=gsk_..."

# Alternative: Load from file
# EnvironmentFile=/etc/igris-runtime/env

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/igris-runtime/data
ReadOnlyPaths=/opt/igris-runtime/models

# Resource limits
LimitNOFILE=65536
MemoryMax=4G
CPUQuota=400%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=igris-runtime

[Install]
WantedBy=multi-user.target
