  "deployment_checklist": {
    "pre_deployment": [
      {
        "task": "Clean up repository",
        "items": [
          "Remove compiled binaries (schlep-api, schlep-cli, schlep-engine-api)",
          "Delete infra/vultr/ directory",
          "Remove .DS_Store files",
          "Delete .bak and .backup files",
          "Remove development scripts from root",
          "Clean node_modules (will be rebuilt)",
          "Remove .next build artifacts"
        ],
        "priority": "HIGH"
      },
      {
        "task": "Generate secure secrets",
        "items": [
          "JWT_SECRET (min 32 chars, cryptographically random)",
          "VAULT_MASTER_KEY (32 bytes hex-encoded, cryptographically random)",
          "POSTGRES_PASSWORD (strong password)",
          "REDIS_PASSWORD (strong password)"
        ],
        "priority": "CRITICAL",
        "commands": [
          "JWT_SECRET: openssl rand -base64 48",
          "VAULT_MASTER_KEY: openssl rand -hex 32",
          "POSTGRES_PASSWORD: openssl rand -base64 32",
          "REDIS_PASSWORD: openssl rand -base64 32"
        ]
      },
      {
        "task": "Review environment configuration",
        "items": [
          "Copy .env.example to .env.production",
          "Set ENV=production",
          "Set DEBUG=false",
          "Configure DATABASE_URL for production Postgres",
          "Configure REDIS_URL for production Redis",
          "Set PROVIDER_MODE (real or hybrid for production)",
          "Add OPENAI_API_KEY and/or ANTHROPIC_API_KEY if using real providers",
          "Configure MAX_MONTHLY_COST_USD budget limits",
          "Set LOG_LEVEL=info or warn",
          "Enable SSL for database (sslmode=require)"
        ],
        "priority": "CRITICAL"
      },
      {
        "task": "Prepare VPS",
        "items": [
          "Create Hetzner Cloud account",
          "Select appropriate VPS plan (recommended: CX31)",
          "Choose datacenter location",
          "Set up SSH keys",
          "Configure firewall (allow 80, 443, 22 only)",
          "Install Docker and Docker Compose",
          "Set up SSL certificates (Let's Encrypt recommended)"
        ],
        "priority": "HIGH"
      }
    ],

    "deployment": [
      {
        "task": "Build and deploy backend",
        "steps": [
          "Clone repository to VPS",
          "Copy .env.production to .env",
          "Build Docker image: docker build -t schlep-engine-api .",
          "Start services: docker-compose -f docker-compose.production.yml up -d",
          "Run database migrations: docker exec schlep-postgres psql -U schlep_user -d schlep_engine -f /docker-entrypoint-initdb.d/001_create_optimizer_states.sql",
          "Verify health: curl http://localhost:8080/v1/health",
          "Check logs: docker-compose logs -f api"
        ]
      },
      {
        "task": "Configure reverse proxy",
        "steps": [
          "Install nginx or Caddy",
          "Configure SSL termination",
          "Proxy requests to port 8080",
          "Enable gzip compression",
          "Set up rate limiting",
          "Configure CORS if needed"
        ]
      },
      {
        "task": "Deploy frontend (Cloudflare Pages)",
        "steps": [
          "cd web/apps/web-landing",
          "Remove duplicate files",
          "pnpm install",
          "pnpm build",
          "Connect GitHub repo to Cloudflare Pages",
