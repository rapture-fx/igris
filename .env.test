# Test Environment Configuration
# This file contains dummy/test values for required environment variables

# Database Configuration
DATABASE_URL=postgresql+asyncpg://test_user:test_pass@localhost:5432/test_schlep_engine
TEST_DATABASE_URL=postgresql+asyncpg://test_user:test_pass@localhost:5432/test_schlep_engine_test

# JWT Configuration  
JWT_SECRET_KEY=test_jwt_secret_key_for_testing_only_not_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis Configuration
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/3

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME=Schlep Engine Test
DEBUG=true
TESTING=true
ENVIRONMENT=testing

# Security
SECRET_KEY=test_secret_key_for_development_only
ENCRYPTION_KEY=test_encryption_key_32_chars_long
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# OAuth Configuration (Test/Mock)
GOOGLE_CLIENT_ID=test_google_client_id
GOOGLE_CLIENT_SECRET=test_google_client_secret
GITHUB_CLIENT_ID=test_github_client_id
GITHUB_CLIENT_SECRET=test_github_client_secret

# External Services (Test/Mock)
OPENAI_API_KEY=sk-test-key-not-real
ANTHROPIC_API_KEY=test-anthropic-key

# RL Optimization Configuration
RL_ENABLED=true
RL_MAX_CONCURRENT_SESSIONS=3
RL_DEFAULT_STRATEGY=ppo
RL_CHECKPOINT_DIRECTORY=./test_checkpoints/
RL_LOGS_DIRECTORY=./test_logs/
RL_TENSORBOARD_ENABLED=false
RL_PROMETHEUS_METRICS_ENABLED=false

# File Storage (Test)
UPLOAD_DIR=./test_uploads
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=.csv,.json,.parquet

# Monitoring (Disabled for tests)
PROMETHEUS_ENABLED=false
GRAFANA_ENABLED=false
SENTRY_DSN=""

# Email (Test/Mock)
SMTP_TLS=true
SMTP_PORT=587
SMTP_HOST=localhost
SMTP_USER=test@schlepengine.com
SMTP_PASSWORD=test_password

# Cloud Storage (Test/Mock)
AWS_ACCESS_KEY_ID=test_access_key
AWS_SECRET_ACCESS_KEY=test_secret_key
AWS_S3_BUCKET=test-schlep-bucket
AWS_REGION=us-east-1

# Feature Flags
ENABLE_ANALYTICS=false
ENABLE_CACHING=false
ENABLE_RATE_LIMITING=false

# Test-specific overrides
SKIP_AUTH_FOR_TESTING=true
USE_IN_MEMORY_DATABASE=false
MOCK_EXTERNAL_APIS=true