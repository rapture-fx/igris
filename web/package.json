{
  "name": "schlep-engine-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Schlep-engine - The Data Schlep Handler. We handle the schlep so you don't have to",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @igris-inertial/web-landing dev",
    "dev:landing": "pnpm --filter @igris-inertial/web-landing dev",
    "dev:docs": "pnpm --filter @igris/web-docs-hub dev",
    "build": "pnpm --filter @igris-inertial/web-landing build",
    "build:landing": "pnpm --filter @igris-inertial/web-landing build",
    "build:docs": "pnpm --filter @igris/web-docs-hub build",
    "start": "pnpm --filter @igris-inertial/web-landing start",
    "start:landing": "pnpm --filter @igris-inertial/web-landing start",
    "start:docs": "pnpm --filter @igris/web-docs-hub start",
    "lint": "pnpm --filter @igris-inertial/web-landing lint",
    "clean": "pnpm --filter @igris-inertial/web-landing clean",
    "deps:check": "node scripts/check-dependencies.js",
    "deps:sync": "node scripts/sync-dependencies.js",
    "deps:audit": "pnpm audit --audit-level moderate",
    "deps:update": "pnpm update --latest --interactive",
    "deps:outdated": "pnpm outdated --recursive",
    "security:scan": "pnpm audit && node scripts/security-scan.js",
    "security:scan:python": "python3 scripts/check-python-dependencies.py",
    "security:scan:all": "pnpm security:scan && pnpm security:scan:python"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^19.0.7",
      "@types/react-dom": "^19.0.5"
    }
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "@pnpm/find-workspace-packages": "^6.0.9",
    "semver": "^7.6.3",
    "chalk": "^5.3.0",
    "ora": "^8.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wiramahendra/Schlep-engine"
  },
  "keywords": [
    "data-processing",
    "data-cleaning",
    "csv-handler",
    "data-schlep",
    "data-preparation",
    "etl",
    "data-pipeline"
  ],
  "author": "Schlep-engine Team",
  "homepage": "https://schlep-engine.com",
  "dependencyVersions": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.29",
    "lucide-react": "^0.294.0",
    "next": "14.2.29",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.8.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  }
}
