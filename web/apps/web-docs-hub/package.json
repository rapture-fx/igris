{
  "name": "@igris/web-docs-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf .next out tsconfig.tsbuildinfo",
    "dev": "pnpm run clean && node scripts/generate-docs-artifacts.js && node scripts/generate-api-verification-report.js && node scripts/generate-search-index.js && pnpm exec next dev --port 3001",
    "build": "pnpm run clean && node scripts/generate-docs-artifacts.js && node scripts/generate-api-verification-report.js && node scripts/validate-docs.js && node scripts/generate-search-index.js && pnpm exec eslint . --ext .js,.jsx,.ts,.tsx && pnpm exec next build",
    "start": "pnpm exec next start --port 3001",
    "lint": "pnpm exec eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck": "rm -rf .next tsconfig.tsbuildinfo && pnpm exec next typegen && pnpm exec tsc --noEmit",
    "validate": "node scripts/validate-docs.js",
    "docs:generate": "node scripts/generate-docs-artifacts.js",
    "docs:audit": "node scripts/audit-docs-implementation.js",
    "docs:verify-api": "node scripts/generate-api-verification-report.js"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.0.0",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.1.0",
    "fumadocs-core": "^15.8.5",
    "fumadocs-mdx": "^14.2.11",
    "fumadocs-typescript": "^5.2.2",
    "fumadocs-ui": "^15.8.5",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.294.0",
    "next": "15.5.9",
    "next-mdx-remote": "^4.4.1",
    "next-themes": "^0.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-syntax-highlighter": "^15.6.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/mdx": "^2.0.13",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@types/react-syntax-highlighter": "^15.5.13",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.6.3"
  }
}
