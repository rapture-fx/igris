# Clerk Authentication
# Get these from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth?mode=signin
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth?mode=signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/auth?mode=signup

# Optional: Disable Clerk telemetry
CLERK_TELEMETRY_DISABLED=1

# Environment Configuration
# CRITICAL: Set to 'production' in production deployments
# Options: 'development' | 'staging' | 'production'
NEXT_PUBLIC_ENV=development

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8081
NEXT_PUBLIC_API_HEALTH_CHECK_URL=/health

# Application Configuration
NEXT_PUBLIC_APP_NAME=Schlep-engine Developer Console
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_LANDING_URL=http://localhost:3000

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_MONITORING=true

# Production Safety Flags
# CRITICAL: Mock data MUST be disabled in production
# Default: Enabled only in development (when NEXT_PUBLIC_ENV is not 'production')
# Set to 'false' explicitly in production to ensure safety
NEXT_PUBLIC_ENABLE_MOCK_DATA=false
