# Production Environment Configuration for Cloudflare Pages
# ========================================
# CRITICAL: This file shows the REQUIRED configuration for production deployments.
# These environment variables must be set in Cloudflare Pages Dashboard:
# Pages → Your Project → Settings → Environment variables

# Environment Configuration
# MUST be set to 'production' in production
NEXT_PUBLIC_ENV=production

# API Configuration
# MUST point to your VPS where igris-overture/igris-runtime is deployed
# Backend runs on port 8080 (igris-overture Go/Fiber API)
# Example: https://api.igrisinertial.com or https://your-vps-ip:8080
NEXT_PUBLIC_API_URL=https://api.igrisinertial.com
NEXT_PUBLIC_API_HEALTH_CHECK_URL=/v1/health

# Application Configuration
NEXT_PUBLIC_APP_NAME=Igris Inertial Developer Console
NEXT_PUBLIC_APP_URL=https://console.igrisinertial.com
NEXT_PUBLIC_LANDING_URL=https://igrisinertial.com

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_MONITORING=true

# Production Safety Flags
# CRITICAL: Mock data MUST be disabled in production
# This prevents fake data from being shown to customers
NEXT_PUBLIC_ENABLE_MOCK_DATA=false

# Clerk Authentication
# Get production keys from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...

# Clerk URLs (production)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth?mode=signin
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth?mode=signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/auth?mode=signup

# Optional: Disable Clerk telemetry
CLERK_TELEMETRY_DISABLED=1
