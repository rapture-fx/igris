source 'https://rubygems.org'

ruby '>= 3.2.0'

# Rails 7.1 — minimal full-stack
gem 'rails', '~> 7.1.5'
gem 'puma', '~> 6.4'

# Asset pipeline via Propshaft (lightweight, no Sprockets) — serves CSS from app/assets
gem 'propshaft', '~> 0.9'

# HTTP client for the optional Overture API client
gem 'faraday', '~> 2.9'

group :development, :test do
  gem 'debug', platforms: %i[mri windows]
end

group :development do
  gem 'web-console', '~> 4.2'
end

group :test do
  gem 'capybara'
  gem 'selenium-webdriver'
end
