<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Igris Inertial Developer Console</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <meta name="csrf-token" content="<%= form_authenticity_token %>">
    <%# Theme detection — set html.dark before stylesheet paints so light is
        the default and prefers-color-scheme:dark switches over with no flash. %>
    <script>
      (function() {
        try {
          var saved = localStorage.getItem('ic-theme');
          var dark = saved
            ? saved === 'dark'
            : window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (dark) document.documentElement.classList.add('dark');
        } catch (e) {}
      })();
    </script>
    <%= stylesheet_link_tag 'application' %>
    <link rel="preconnect" href="https://rsms.me/">
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css">
    <style>:root { font-family: 'Inter', sans-serif; }</style>
    <%# ldrs LineSpinner — same loader library the landing-page hero uses. %>
    <script type="module">
      import { lineSpinner } from 'https://cdn.jsdelivr.net/npm/ldrs@1.0.2/+esm';
      lineSpinner.register();
    </script>
  </head>
  <body>
    <div class="ig-shell">
      <%= render 'shared/icon_rail' %>
      <%# Every lens is full-pane — the icon rail is the only persistent nav.
          The Runs view switch (Run History / Metrics) lives in-page as tabs. %>
      <main class="ig-main">
        <%= yield %>
      </main>

    </div>

    <%# Syntax highlighting — loaded at end of body so every code block
        is in the DOM before highlightAll() runs. %>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/languages/http.min.js"></script>
    <script>
      if (window.hljs) {
        hljs.configure({ ignoreUnescapedHTML: true });
        document.querySelectorAll('pre code').forEach(function(el) {
          try { hljs.highlightElement(el); } catch (e) {}
        });
      }
    </script>
  </body>
</html>
