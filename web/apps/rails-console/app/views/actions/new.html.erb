<%# Create action — Identity → Target → Policy → Endpoint.
    Onboarding, not configuration: every step earns the next. %>
<% steps = ActionsController::WIZARD_STEPS %>
<% step_index = steps.index(@step) || 0 %>
<% next_step = steps[step_index + 1] %>
<% prev_step = steps[step_index - 1] if step_index > 0 %>
<% errors = @errors || {} %>

<div class="ig-topbar">
  <div class="ig-topbar__group">
    <span class="ig-topbar__title">Create an action</span>
    <span class="ig-topbar__caption">Give your AI agent a safe endpoint to call instead of the tool directly.</span>
  </div>
  <div class="ig-topbar__group">
    <%= link_to 'Cancel', actions_path, class: 'ig-btn' %>
  </div>
</div>

<%= render 'shared/flash' %>

<div class="ig-body ig-body--narrow">
  <nav class="ig-wizard" aria-label="Steps">
    <% steps.each_with_index do |s, i| %>
      <% klass = i < step_index ? 'is-done' : (i == step_index ? 'is-active' : '') %>
      <span class="ig-wizard__step <%= klass %>">
        <span class="ig-wizard__step__num"><%= i + 1 %></span><%= s.titleize %>
      </span>
      <% unless i == steps.size - 1 %><span class="ig-wizard__sep"></span><% end %>
    <% end %>
  </nav>

  <% final = @step == 'endpoint' %>
  <%= form_with url: (final ? actions_path : new_action_path), method: (final ? :post : :get), local: true do %>
    <% unless final %><%= hidden_field_tag :step, next_step %><% end %>

    <%# Persistent hidden state — every field travels through every step. %>
    <% carry = %i[name display_name description target_type target_url method policy]
       skip_on = {
         'identity' => %i[name display_name description],
         'target'   => %i[target_type target_url method],
         'policy'   => %i[policy],
       } %>
    <% carry.each do |k| %>
      <% next if Array(skip_on[@step]).include?(k) %>
      <%= hidden_field_tag k, @draft[k] %>
    <% end %>

    <% case @step %>
    <% when 'identity' %>
      <div class="ig-card ig-card--pad-lg">
        <h2 class="ig-card__title" style="font-size: 14px;">Identity</h2>
        <p class="ig-mut" style="margin: 2px 0 16px;">Name your action and describe what it does.</p>

        <div class="ig-field">
          <label class="ig-field__label" for="name">Action name</label>
          <%= text_field_tag :name, @draft[:name], id: 'name', class: "ig-input #{'is-error' if errors[:name]}",
              placeholder: 'send_email', autofocus: true, autocomplete: 'off',
              pattern: '[a-z][a-z0-9_]{1,63}', spellcheck: 'false' %>
          <% if errors[:name] %>
            <div class="ig-field__error"><%= errors[:name] %></div>
          <% else %>
            <div class="ig-field__help">This becomes the endpoint path your agent calls.</div>
          <% end %>
          <div class="ig-examples">
            <% %w[send_email create_ticket update_customer_record read_private_file].each do |ex| %>
              <code class="ig-examples__item"><%= ex %></code>
            <% end %>
          </div>
        </div>

        <div class="ig-field">
          <label class="ig-field__label" for="display_name">Display name <span class="ig-mut">(optional)</span></label>
          <%= text_field_tag :display_name, @draft[:display_name], id: 'display_name', class: 'ig-input', placeholder: 'Send email' %>
        </div>

        <div class="ig-field">
          <label class="ig-field__label" for="description">What does this action do? <span class="ig-mut">(optional)</span></label>
          <%= text_area_tag :description, @draft[:description], id: 'description', class: 'ig-textarea',
              placeholder: 'Outbound transactional email your agent triggers — policy-checked and recorded.' %>
        </div>
      </div>

    <% when 'target' %>
      <div class="ig-card ig-card--pad-lg">
        <h2 class="ig-card__title" style="font-size: 14px;">Target</h2>
        <p class="ig-mut" style="margin: 2px 0 16px;">Choose where this action actually runs.</p>

        <div class="ig-radio-group">
          <% [
            ['mock_demo',       'Mock demo',         'Try the full flow without external credentials.',                  nil,        false],
            ['hosted_api',      'Hosted API',        'Route an agent action to an external hosted API.',                 :none,      false],
            ['webhook',         'Webhook',           'Forward the action request to a webhook endpoint.',                :none,      false],
            ['local_runtime',   'Local runtime',     'Run near private files, internal APIs, or local databases.',       :required,  false],
            ['hybrid_fallback', 'Hybrid / fallback', 'Coming soon. Fallback only when policy and replay safety allow it.', nil,       true],
          ].each do |val, title, sub, runtime, disabled| %>
            <label class="ig-radio <%= 'is-disabled' if disabled %>">
              <input type="radio" name="target_type" value="<%= val %>"
                <%= 'checked' if @draft[:target_type] == val %> <%= 'disabled' if disabled %>>
              <span>
                <span class="ig-radio__title">
                  <%= title %>
                  <% if disabled %><span class="ig-pill ig-pill--muted" style="margin-left: 6px;">Coming soon</span><% end %>
                  <% if runtime == :none %><span class="ig-pill ig-pill--ok" style="margin-left: 6px;">No runtime needed</span><% end %>
                  <% if runtime == :required %><span class="ig-pill ig-pill--warn" style="margin-left: 6px;">Runtime required</span><% end %>
                </span>
                <span class="ig-radio__sub"><%= sub %></span>
                <% if runtime == :required %>
                  <span class="ig-radio__sub">When to use this: the action needs private files, internal APIs, or local databases. <%= link_to 'Learn how runtimes work', runtimes_path %>.</span>
                <% end %>
              </span>
            </label>
          <% end %>
        </div>

        <div class="ig-field" style="margin-top: 16px;">
          <label class="ig-field__label" for="target_url">Target URL</label>
          <%= url_field_tag :target_url, @draft[:target_url], id: 'target_url',
              class: "ig-input #{'is-error' if errors[:target_url]}",
              placeholder: 'https://api.example.com/v1/...' %>
          <% if errors[:target_url] %>
            <div class="ig-field__error"><%= errors[:target_url] %></div>
          <% else %>
            <div class="ig-field__help">Required for Hosted API and Webhook. Local runtime needs a connected runtime instead — no URL.</div>
          <% end %>
          <% if errors[:target_type] %>
            <div class="ig-field__error"><%= errors[:target_type] %></div>
          <% end %>
        </div>

        <div class="ig-field">
          <label class="ig-field__label" for="method">HTTP method</label>
          <%= select_tag :method, options_for_select(%w[POST GET PUT PATCH DELETE], @draft[:method] || 'POST'), id: 'method', class: 'ig-select' %>
        </div>
      </div>

    <% when 'policy' %>
      <div class="ig-card ig-card--pad-lg">
        <h2 class="ig-card__title" style="font-size: 14px;">Policy</h2>
        <p class="ig-mut" style="margin: 2px 0 16px;">How Igris should behave when this action is called.</p>

        <div class="ig-radio-group">
          <% ActionsController::POLICY_PRESETS.each do |key, cfg| %>
            <label class="ig-radio">
              <input type="radio" name="policy" value="<%= key %>" <%= 'checked' if @draft[:policy] == key %>>
              <span>
                <span class="ig-radio__title"><%= cfg[:label] %></span>
                <span class="ig-radio__sub"><%= cfg[:blurb] %></span>
              </span>
            </label>
          <% end %>
        </div>
      </div>

    <% when 'endpoint' %>
      <% endpoint = action_endpoint_url(@draft[:name]) %>
      <div class="ig-card ig-card--pad-lg">
        <h2 class="ig-card__title" style="font-size: 14px;">Endpoint</h2>
        <p class="ig-mut" style="margin: 2px 0 16px;">
          Use this endpoint where your agent would normally call the tool directly.
        </p>

        <%= code_snippet endpoint, language: 'http', label: 'POST endpoint' %>
        <div style="height: 14px;"></div>
        <%= code_snippet action_curl_snippet(endpoint), language: 'bash', label: 'curl' %>
        <div style="height: 14px;"></div>
        <%= code_snippet action_js_snippet(endpoint), language: 'javascript', label: 'JavaScript' %>

        <div class="ig-divider"></div>
        <div class="ig-mut" style="font-size: 11.5px;">
          Review:
          <strong style="color: var(--ig-text-primary);"><%= @draft[:name] %></strong>,
          target <strong style="color: var(--ig-text-primary);"><%= @draft[:target_type].titleize %></strong>,
          policy <strong style="color: var(--ig-text-primary);"><%= ActionsController::POLICY_PRESETS.dig(@draft[:policy], :label) || @draft[:policy] %></strong>
          <% if demo_mode? %>
            <br><span style="color: var(--ic-amber);">Demo mode — creating this action is inert and creates no real action.</span>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="ig-row ig-row--spread" style="margin-top: 16px;">
      <% if prev_step %>
        <%= link_to "← #{prev_step.titleize}", new_action_path(step: prev_step, **@draft.compact), class: 'ig-btn' %>
      <% else %>
        <span></span>
      <% end %>
      <% if final %>
        <%= submit_tag 'Create action', class: 'ig-btn ig-btn--primary ig-btn--lg' %>
      <% else %>
        <%= submit_tag "Continue to #{next_step.titleize}", class: 'ig-btn ig-btn--primary ig-btn--lg' %>
      <% end %>
    </div>
  <% end %>
</div>
