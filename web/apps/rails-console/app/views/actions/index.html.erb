<%# Actions list — hero typography, full-pane (no lens sidebar). %>
<div class="ic-topbar">
  <div class="ic-topbar__group">
    <span class="ic-topbar__title">Actions</span>
    <span class="ic-chip"><%= @actions.size %> registered</span>
  </div>
  <div class="ic-topbar__group">
    <%= link_to 'New action', new_action_path, class: 'ic-btn ic-btn--accent' %>
  </div>
</div>

<%= render 'shared/flash', degraded_error: @degraded_error %>

<div class="ic-body ic-scroll">
  <% if @actions.empty? %>
    <div style="text-align: center; padding: 64px 16px; color: var(--ic-text-6); font-size: 12.5px;">
      <div style="color: var(--ic-text-bright); font-size: 14px; font-weight: 500; margin-bottom: 4px;">Create your first action</div>
      <div style="margin-bottom: 16px;">A named endpoint your agent can POST to. Igris adds policy, routing, recovery, and a signed receipt.</div>
      <%= link_to 'New action', new_action_path, class: 'ic-btn ic-btn--accent' %>
    </div>
  <% else %>
    <div class="ic-actions-list">
      <% @actions.each do |a| %>
        <% st = a[:last_run_status].to_s %>
        <% dot_mod = case st when 'bad' then 'failed' when 'warn' then 'running' when '' then 'ok' else 'ok' end %>
        <%= link_to action_path(a[:id]), class: 'ic-action-row' do %>
          <span class="ic-action-row__dot ic-action-row__dot--<%= dot_mod %>"></span>
          <div class="ic-action-row__main">
            <div class="ic-action-row__name"><%= a[:name] %></div>
            <div class="ic-action-row__meta">
              <%= a[:target_label] %> · <%= a[:policy] %>
            </div>
          </div>
          <div class="ic-action-row__endpoint mono"><%= a[:endpoint] %></div>
          <div class="ic-action-row__proof"><%= a[:proof] %></div>
          <div class="ic-action-row__when"><%= a[:last_run_at] ? time_ago(a[:last_run_at]) : 'no runs yet' %></div>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
