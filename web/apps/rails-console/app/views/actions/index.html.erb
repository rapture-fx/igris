<%#
  Actions — the core product object: endpoints your agent calls. Laid out to
  match the Runs surface (topbar, filter + search bar over the loaded window,
  one row per action linking to its detail).
%>
<div class="igris-console" style="display: flex; flex-direction: column; flex: 1; min-height: 0;">
  <style>
    .ic-action-path {
      margin: 10px 16px 0; padding: 10px 12px;
      border: 1px solid var(--ic-border-soft); border-radius: 8px;
      background: var(--ic-overlay-bg);
      display: flex; align-items: center; justify-content: space-between;
      gap: 12px;
    }
    .ic-action-path__copy { min-width: 0; }
    .ic-action-path__title { font-size: 12.5px; font-weight: 600; color: var(--ic-text-bright); }
    .ic-action-path__text { margin-top: 2px; font-size: 11.5px; color: var(--ic-text-6); line-height: 1.5; }
    .ic-action-path__links { display: inline-flex; gap: 8px; flex-wrap: wrap; flex-shrink: 0; }
    @media (max-width: 760px) {
      .ic-action-path { align-items: flex-start; flex-direction: column; }
      .ic-action-path__links { width: 100%; }
    }
  </style>

  <div class="ic-topbar">
    <div class="ic-topbar__group">
      <span class="ic-topbar__title">Actions</span>
      <%= project_chip %>
      <span class="ic-chip"><%= @all_actions.size %> registered</span>
    </div>
    <div class="ic-topbar__group">
      <%= link_to 'New action', new_action_path, class: 'ic-btn ic-btn--accent' %>
      <%= link_to 'Open Runs', runs_path, class: 'ic-btn' %>
    </div>
  </div>

  <%= render 'shared/flash', degraded_error: @degraded_error %>

  <div class="ic-action-path" role="region" aria-label="Action path">
    <div class="ic-action-path__copy">
      <div class="ic-action-path__title">Actions are controlled execution capabilities</div>
      <div class="ic-action-path__text">
        An agent requests an action. The action defines the target, policy,
        approval behavior, recovery expectations, and the run record to review afterward.
      </div>
    </div>
    <div class="ic-action-path__links">
      <%= link_to 'Connect agent', agents_path(view: 'adoption'), class: 'ic-btn' %>
      <%= link_to 'Review runs', runs_path, class: 'ic-btn' %>
    </div>
  </div>

  <%# Filter + search bar — server-rendered, custom dropdowns (no native
      <select>). Dropdowns narrow by readiness / policy; search matches action
      name, target, policy, or endpoint and preserves the active filters. %>
  <div class="ic-filters">
    <%= render 'filter_dropdown', param: :readiness, selected: @readiness,
          placeholder: 'All readiness',
          options: ActionsController::READINESS.to_a %>
    <%= render 'filter_dropdown', param: :policy, selected: @policy,
          placeholder: 'All policies', options: @policies.map { |p| [p, p] } %>

    <form class="ic-runsearch" method="get" action="<%= actions_path %>" role="search" data-turbo="false">
      <% if @readiness.present? %><input type="hidden" name="readiness" value="<%= @readiness %>"><% end %>
      <% if @policy.present?    %><input type="hidden" name="policy" value="<%= @policy %>"><% end %>
      <svg class="ic-runsearch__ico" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/>
        <path d="M20 20l-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
      <input type="text" name="q" value="<%= @query %>" autocomplete="off"
             placeholder="Search actions" class="ic-input ic-runsearch__input"
             aria-label="Search actions">
    </form>
  </div>

  <%# Close any open filter dropdown on outside-click / Escape (mirrors the
      Runs filter bar). %>
  <script>
    (function () {
      var bar = document.currentScript.previousElementSibling;
      if (!bar) return;
      var menus = bar.querySelectorAll('details.ic-dropdown');
      menus.forEach(function (d) {
        d.addEventListener('toggle', function () {
          if (d.open) menus.forEach(function (o) { if (o !== d) o.open = false; });
        });
      });
      document.addEventListener('click', function (e) {
        menus.forEach(function (d) { if (d.open && !d.contains(e.target)) d.open = false; });
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') menus.forEach(function (d) { d.open = false; });
      });
    })();
  </script>

  <%= render 'list' %>
</div>
