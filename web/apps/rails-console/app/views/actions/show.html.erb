<%# Action detail — the place where you copy the endpoint and send the first
    test request. Next-step card sits above the tabs. %>
<% latest = @runs_for_action.first %>
<div class="ic-topbar ic-topbar--wrap">
  <div class="ic-topbar__group">
    <%= link_to 'Actions', actions_path, class: 'ic-topbar__crumb' %>
    <span class="ic-topbar__sep">/</span>
    <span class="ic-topbar__title"><%= @action[:name] %></span>
    <span class="ic-chip"><%= @action[:target_label] %></span>
    <span class="ic-chip">policy: <%= @action[:policy] %></span>
    <span class="ic-chip">replay: <%= @action[:replay] == 'On' ? 'allowed' : 'blocked' %></span>
    <span class="ic-chip">proof: <%= latest ? latest[:proof] : 'no runs yet' %></span>
    <span class="ic-topbar__hint">
      Last run <%= @action[:last_run_at] ? time_ago(@action[:last_run_at]) : 'never' %>
    </span>
  </div>
</div>

<%= render 'shared/flash', degraded_error: @degraded_error %>

<% tabs = %w[overview endpoint target policy secrets] %>
<nav class="ig-tabs ig-tabs--detail">
  <% tabs.each do |t| %>
    <%= link_to t.titleize, action_path(@action[:id], tab: t),
        class: "ig-tabs__item #{'is-active' if @tab == t}" %>
  <% end %>
</nav>

<div class="ig-body ig-body--detail<%= ' ig-body--fixed' if @tab == 'overview' %>">
  <% if @just_created %>
    <div class="ig-strip" style="background: rgba(52,211,153,0.06); border-bottom: none; border-radius: 8px; margin-bottom: 12px;">
      <%= chip 'Created', tone: :ok %>
      <span style="font-size: 12px; color: var(--ig-text-body);">
        Your action is live. Next: copy the endpoint and send a test request.
      </span>
    </div>
  <% end %>

  <%# ── Local-runtime guidance ─────────────────────────────── %>
  <% if @action[:target_type] == 'local_runtime' %>
    <% if @runtime_required %>
      <div class="ic-runtime-req">
        <div>
          <div class="ic-runtime-req__title">Runtime required</div>
          <p class="ic-runtime-req__sub">
            This action runs through a local runtime because it needs
            private/local access. Connect a runtime before sending a test request.
          </p>
        </div>
        <span class="ic-runtime-req__cta"><%= link_to 'Connect a runtime', runtimes_path, class: 'ic-btn ic-btn--accent' %></span>
      </div>
    <% else %>
      <div class="ic-runtime-ok">
        <span class="ic-readiness ic-readiness--ok"><span class="ic-readiness__dot"></span>Runtime available<%= ' · demo' if demo_mode? %></span>
        <span class="ic-runtime-ok__text">
          This action runs through a local runtime. A healthy runtime is connected, so you can send a test request.
        </span>
      </div>
    <% end %>
  <% end %>

  <% case @tab %>
  <% when 'overview' %>
    <div class="ic-action-layout">
      <%# ── Main column: endpoint → test → runs ───────────────── %>
      <div class="ic-action-main">
        <div class="ig-card ic-endpoint-hero">
          <div class="ig-card__title">Action endpoint</div>
          <p class="ig-mut" style="margin: 0 0 10px;">This is the endpoint your agent calls.</p>
          <%= code_snippet @action[:endpoint], language: 'http', label: 'POST' %>
          <p class="ig-mut" style="margin-top: 8px;">
            The agent does not get direct tool access — it calls this Igris endpoint.
            The action defines the target, policy, and secret references.
          </p>
          <div class="ic-ctx-label">curl</div>
          <%= code_snippet action_curl_snippet(@action[:endpoint]), language: 'bash' %>
          <div class="ic-ctx-label">JavaScript / fetch</div>
          <%= code_snippet action_js_snippet(@action[:endpoint]), language: 'javascript' %>
        </div>

        <div class="ig-card" id="test-request">
          <div class="ig-card__title">Test this action</div>
          <p class="ig-mut" style="margin-bottom: 10px;">
            Send a test request to confirm the action routes through Igris before
            you wire it into your agent. Edit the JSON as needed.
          </p>
          <p class="ig-mut" style="margin-bottom: 10px; font-size: 11.5px;">
            <strong>What should happen:</strong>
            <% if demo_mode? %>
              demo mode is inert — no real run is created.
            <% else %>
              on success you'll be taken to the run record, where its evidence appears.
            <% end %>
          </p>

          <%# ── Inline result / error — the outcome lands right here ──────── %>
          <% if (tr = flash[:test_result]).present? %>
            <% meta = test_result_meta(tr['state']) %>
            <div class="ic-testresult ic-testresult--<%= meta[:tone] %>" role="status" aria-live="polite">
              <div class="ic-testresult__head">
                <%= chip meta[:label], tone: meta[:tone] %>
                <span class="ic-testresult__msg"><%= tr['message'] %></span>
              </div>
              <% if tr['state'] == 'runtime_unavailable' %>
                <div class="ic-testresult__cta"><%= link_to 'Connect a runtime', runtimes_path, class: 'ic-btn ic-btn--accent' %></div>
              <% end %>
            </div>
          <% end %>

          <%= form_with url: run_action_path(@action[:id]), method: :post, local: true do |f| %>
            <div class="ig-field">
              <label class="ig-field__label" for="input">Request body (JSON)</label>
              <%= text_area_tag :input, (flash[:test_input].presence || sample_payload_for(@action[:target_type])), id: 'input',
                  class: 'ig-textarea', rows: 7, spellcheck: 'false' %>
            </div>
            <div class="ig-field">
              <label class="ig-field__label" for="idempotency_key">Idempotency key <span class="ig-mut">(optional)</span></label>
              <%= text_field_tag :idempotency_key, '', id: 'idempotency_key', class: 'ig-input', placeholder: 'unique-per-call key' %>
            </div>
            <% if @runtime_required && !demo_mode? %>
              <%= f.submit 'Send test request', class: 'ig-btn' %>
              <span class="ig-mut" style="margin-left: 10px;">No runtime connected — <%= link_to 'connect one', runtimes_path %> to test.</span>
            <% else %>
              <%= f.submit 'Send test request', class: 'ig-btn ig-btn--primary' %>
              <% if demo_mode? %>
                <span class="ig-mut" style="margin-left: 10px;">Demo mode — submission is inert.</span>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>

      <%# ── Right context panel ───────────────────────────────── %>
      <aside class="ic-action-aside">
        <div class="ig-card">
          <div class="ig-card__title">Action</div>
          <div class="ig-def"><span class="ig-def__label">Name</span><span class="ig-def__value"><%= @action[:display_name].presence || @action[:name] %></span></div>
          <div class="ig-def"><span class="ig-def__label">Action name</span><span class="ig-def__value"><code><%= @action[:name] %></code></span></div>
          <div class="ig-def"><span class="ig-def__label">Setup</span><span class="ig-def__value"><%= status_pill @action[:setup] %></span></div>
        </div>

        <div class="ig-card">
          <div class="ig-card__title">Target</div>
          <div class="ig-def"><span class="ig-def__label">Type</span><span class="ig-def__value"><%= @action[:target_label] %></span></div>
          <p class="ig-mut" style="margin-top: 6px;">
            <%= case @action[:target_type]
                when 'hosted_api'    then 'Igris routes this action to a hosted API target.'
                when 'webhook'       then 'Igris forwards this action request to your webhook.'
                when 'local_runtime' then 'This action runs through a local runtime because it needs private/local access.'
                when 'mock_demo'     then 'Demo action for trying the flow without external credentials.'
                else @action[:target_label]
                end %>
          </p>
        </div>

        <div class="ig-card">
          <div class="ig-card__title">Runtime requirement</div>
          <% if @action[:target_type] == 'local_runtime' %>
            <% if @runtime_required %>
              <span class="ic-readiness ic-readiness--warn"><span class="ic-readiness__dot"></span>Runtime required</span>
              <p class="ig-mut" style="margin-top: 6px;">Connect a runtime before sending a test request. <%= link_to 'Connect a runtime', runtimes_path %>.</p>
            <% else %>
              <span class="ic-readiness ic-readiness--ok"><span class="ic-readiness__dot"></span>Runtime available<%= ' · demo' if demo_mode? %></span>
            <% end %>
          <% else %>
            <span class="ic-readiness ic-readiness--ok"><span class="ic-readiness__dot"></span>No runtime needed</span>
          <% end %>
        </div>

        <div class="ig-card">
          <div class="ig-card__title">Policy</div>
          <div class="ig-def"><span class="ig-def__label">Preset</span><span class="ig-def__value"><%= @action[:policy] %></span></div>
          <div class="ig-def"><span class="ig-def__label">Replay</span><span class="ig-def__value"><%= @action[:replay] == 'On' ? 'Replay allowed' : 'Replay blocked' %></span></div>
          <div class="ig-def"><span class="ig-def__label">Approval</span><span class="ig-def__value"><%= @action[:approval_required] ? 'Human-gated' : 'Automatic' %></span></div>
        </div>

        <div class="ig-card">
          <div class="ig-card__title">Secrets</div>
          <div class="ig-def"><span class="ig-def__label">Status</span><span class="ig-def__value"><%= status_pill(@action[:secrets_state].presence || 'Not configured') %></span></div>
          <p class="ig-mut" style="margin-top: 6px;">Secrets are hidden — only configured / not configured is shown.</p>
        </div>
      </aside>
    </div>

  <% when 'endpoint' %>
    <% endpoint = @action[:endpoint] %>
    <div class="ig-card">
      <div class="ig-card__title">POST endpoint</div>
      <%= code_snippet endpoint, language: 'http' %>
      <p class="ig-mut" style="margin-top: 8px;">Use this endpoint where your agent would normally call the tool directly.</p>
    </div>
    <div style="height: 14px;"></div>
    <div class="ig-card">
      <div class="ig-card__title">curl</div>
      <%= code_snippet action_curl_snippet(endpoint), language: 'bash' %>
    </div>
    <div style="height: 14px;"></div>
    <div class="ig-card">
      <div class="ig-card__title">JavaScript / fetch</div>
      <%= code_snippet action_js_snippet(endpoint), language: 'javascript' %>
    </div>

  <% when 'target' %>
    <div class="ig-card">
      <div class="ig-card__title"><%= @action[:target_label] %></div>
      <div class="ig-mut" style="font-size: 12.5px;">
        <% case @action[:target_type] %>
        <% when 'hosted_api' %>
          Calls travel through Igris before the upstream API. Auth lives in Secrets — the raw token is never shown in the console.
        <% when 'webhook' %>
          Signed POST to your endpoint. Inspect the request in the run detail.
        <% when 'local_runtime' %>
          Needs a connected runtime on a host that can reach the private resource.
          <%= link_to 'See Runtimes', runtimes_path %> to install and connect one.
        <% when 'mock_demo' %>
          No real side effect. Use this to see the full flow end-to-end.
        <% else %>
          <%= @action[:target_label] %>
        <% end %>
      </div>
    </div>

  <% when 'policy' %>
    <div class="ig-card">
      <div class="ig-card__title">Policy</div>
      <div class="ig-mut" style="font-size: 12.5px;">
        In plain language: <strong style="color: var(--ig-text-primary);"><%= @action[:policy] %></strong>
      </div>
      <div class="ig-divider"></div>
      <div class="ig-def"><span class="ig-def__label">Replay class</span><span class="ig-def__value"><%= @action[:replay] %></span></div>
      <div class="ig-def"><span class="ig-def__label">Approval required</span><span class="ig-def__value"><%= @action[:approval_required] ? 'Yes' : 'No' %></span></div>
      <div class="ig-def"><span class="ig-def__label">Irreversible</span><span class="ig-def__value"><%= @action[:irreversible] ? 'Yes' : 'No' %></span></div>
    </div>

  <% when 'secrets' %>
    <div class="ig-card">
      <div class="ig-card__title">Secrets</div>
      <div class="ig-mut" style="font-size: 12.5px; margin-bottom: 10px;">Values are never shown in the console — only configured / not configured.</div>
      <div class="ig-def"><span class="ig-def__label">target_auth</span><span class="ig-def__value"><%= status_pill @action[:secrets_state] %></span></div>
    </div>
  <% end %>
</div>
