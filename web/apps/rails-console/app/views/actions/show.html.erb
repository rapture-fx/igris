<%# Action detail — the place where you copy the endpoint and send the first
    test request. Next-step card sits above the tabs. %>
<% latest = @runs_for_action.first %>
<div class="ic-topbar ic-topbar--wrap">
  <div class="ic-topbar__group">
    <%= link_to 'Actions', actions_path, class: 'ic-topbar__crumb' %>
    <span class="ic-topbar__sep">/</span>
    <span class="ic-topbar__title"><%= @action[:name] %></span>
    <span class="ic-chip"><%= @action[:target_label] %></span>
    <span class="ic-chip">policy: <%= @action[:policy] %></span>
    <span class="ic-topbar__hint">
      Last run <%= @action[:last_run_at] ? time_ago(@action[:last_run_at]) : 'never' %>
    </span>
  </div>
</div>

<%= render 'shared/flash', degraded_error: @degraded_error %>

<div class="ig-body">
  <% if @just_created %>
    <div class="ig-strip" style="background: rgba(52,211,153,0.06); border-bottom: none; border-radius: 8px; margin-bottom: 12px;">
      <%= chip 'Created', tone: :ok %>
      <span style="font-size: 12px; color: var(--ig-text-body);">
        Your action is live. Next: copy the endpoint and send a test request.
      </span>
    </div>
  <% end %>

  <%# ── Next step card ──────────────────────────────────────── %>
  <div class="ic-nextstep">
    <div class="ic-nextstep__body">
      <div class="ic-nextstep__kicker">Next step</div>
      <% if latest %>
        <div class="ic-nextstep__title">Inspect what Igris recorded</div>
        <p class="ic-nextstep__sub">Your last request ran. Open the run to see status, routing, policy, and proof — or send another.</p>
      <% else %>
        <div class="ic-nextstep__title">Send a test request</div>
        <p class="ic-nextstep__sub">Call this endpoint where your agent would normally call the tool directly. The form below sends a sample request.</p>
      <% end %>
    </div>
    <div class="ic-nextstep__cta">
      <% if latest %>
        <%= link_to 'Inspect latest run', run_path(latest[:id]), class: 'ic-btn ic-btn--accent' %>
        <a href="#test-request" class="ic-btn">Run again</a>
      <% else %>
        <a href="#test-request" class="ic-btn ic-btn--accent">Send a test request</a>
      <% end %>
    </div>
  </div>

  <% tabs = %w[overview endpoint target policy secrets runs] %>
  <nav class="ig-tabs">
    <% tabs.each do |t| %>
      <%= link_to t.titleize, action_path(@action[:id], tab: t),
          class: "ig-tabs__item #{'is-active' if @tab == t}" %>
    <% end %>
  </nav>

  <% case @tab %>
  <% when 'overview' %>
    <div class="ig-grid ig-grid--2">
      <div class="ig-card">
        <div class="ig-card__title">Endpoint</div>
        <%= code_snippet @action[:endpoint], language: 'http', label: 'POST' %>
        <p class="ig-mut" style="margin-top: 8px;">Your agent calls this instead of calling the tool directly.</p>
      </div>

      <div class="ig-card">
        <div class="ig-card__title">Where it runs</div>
        <div class="ig-def">
          <span class="ig-def__label">Target</span>
          <span class="ig-def__value"><%= @action[:target_label] %></span>
        </div>
        <div class="ig-def">
          <span class="ig-def__label">Policy</span>
          <span class="ig-def__value"><%= @action[:policy] %></span>
        </div>
        <div class="ig-def">
          <span class="ig-def__label">Replay</span>
          <span class="ig-def__value"><%= @action[:replay] %></span>
        </div>
        <div class="ig-def">
          <span class="ig-def__label">Secrets</span>
          <span class="ig-def__value"><%= status_pill @action[:secrets_state] %></span>
        </div>
      </div>

      <div class="ig-card" id="test-request">
        <div class="ig-card__title">Test this action</div>
        <p class="ig-mut" style="margin-bottom: 10px;">Send a sample request through the endpoint. Edit the JSON as needed.</p>
        <%= form_with url: run_action_path(@action[:id]), method: :post, local: true do |f| %>
          <div class="ig-field">
            <label class="ig-field__label" for="input">Request body (JSON)</label>
            <%= text_area_tag :input, sample_payload_for(@action[:target_type]), id: 'input',
                class: 'ig-textarea', rows: 7, spellcheck: 'false' %>
          </div>
          <div class="ig-field">
            <label class="ig-field__label" for="idempotency_key">Idempotency key <span class="ig-mut">(optional)</span></label>
            <%= text_field_tag :idempotency_key, '', id: 'idempotency_key', class: 'ig-input', placeholder: 'unique-per-call key' %>
          </div>
          <%= f.submit 'Send test request', class: 'ig-btn ig-btn--primary' %>
          <% if demo_mode? %>
            <span class="ig-mut" style="margin-left: 10px;">Demo mode — submission is inert.</span>
          <% elsif @action[:target_type] == 'local_runtime' %>
            <span class="ig-mut" style="margin-left: 10px;">Needs a connected runtime.</span>
          <% end %>
        <% end %>
      </div>

      <div class="ig-card">
        <div class="ig-card__title">Latest run</div>
        <% if latest %>
          <div class="ig-def"><span class="ig-def__label">Run</span><span class="ig-def__value"><%= link_to latest[:id], run_path(latest[:id]) %></span></div>
          <div class="ig-def"><span class="ig-def__label">Status</span><span class="ig-def__value"><%= status_pill latest[:status] %></span></div>
          <div class="ig-def"><span class="ig-def__label">Routed via</span><span class="ig-def__value"><%= latest[:routed_via] %></span></div>
          <div class="ig-def"><span class="ig-def__label">Proof</span><span class="ig-def__value"><%= status_pill latest[:proof] %></span></div>
          <div class="ig-def"><span class="ig-def__label">Started</span><span class="ig-def__value"><%= time_ago(latest[:started_at]) %></span></div>
        <% else %>
          <p class="ig-mut">No runs yet. Send a test request to record the first one.</p>
        <% end %>
      </div>
    </div>

  <% when 'endpoint' %>
    <% endpoint = @action[:endpoint] %>
    <div class="ig-card">
      <div class="ig-card__title">POST endpoint</div>
      <%= code_snippet endpoint, language: 'http' %>
      <p class="ig-mut" style="margin-top: 8px;">Use this endpoint where your agent would normally call the tool directly.</p>
    </div>
    <div style="height: 14px;"></div>
    <div class="ig-card">
      <div class="ig-card__title">curl</div>
      <%= code_snippet action_curl_snippet(endpoint), language: 'bash' %>
    </div>
    <div style="height: 14px;"></div>
    <div class="ig-card">
      <div class="ig-card__title">JavaScript / fetch</div>
      <%= code_snippet action_js_snippet(endpoint), language: 'javascript' %>
    </div>

  <% when 'target' %>
    <div class="ig-card">
      <div class="ig-card__title"><%= @action[:target_label] %></div>
      <div class="ig-mut" style="font-size: 12.5px;">
        <% case @action[:target_type] %>
        <% when 'hosted_api' %>
          Calls travel through Igris before the upstream API. Auth lives in Secrets — the raw token is never shown in the console.
        <% when 'webhook' %>
          Signed POST to your endpoint. Inspect the request in the run detail.
        <% when 'local_runtime' %>
          Needs a connected runtime on a host that can reach the private resource. See the Runtimes lens.
        <% when 'mock_demo' %>
          No real side effect. Use this to see the full flow end-to-end.
        <% else %>
          <%= @action[:target_label] %>
        <% end %>
      </div>
    </div>

  <% when 'policy' %>
    <div class="ig-card">
      <div class="ig-card__title">Policy</div>
      <div class="ig-mut" style="font-size: 12.5px;">
        In plain language: <strong style="color: var(--ig-text-primary);"><%= @action[:policy] %></strong>
      </div>
      <div class="ig-divider"></div>
      <div class="ig-def"><span class="ig-def__label">Replay class</span><span class="ig-def__value"><%= @action[:replay] %></span></div>
      <div class="ig-def"><span class="ig-def__label">Approval required</span><span class="ig-def__value"><%= @action[:approval_required] ? 'Yes' : 'No' %></span></div>
      <div class="ig-def"><span class="ig-def__label">Irreversible</span><span class="ig-def__value"><%= @action[:irreversible] ? 'Yes' : 'No' %></span></div>
    </div>

  <% when 'secrets' %>
    <div class="ig-card">
      <div class="ig-card__title">Secrets</div>
      <div class="ig-mut" style="font-size: 12.5px; margin-bottom: 10px;">Values are never shown in the console — only configured / not configured.</div>
      <div class="ig-def"><span class="ig-def__label">target_auth</span><span class="ig-def__value"><%= status_pill @action[:secrets_state] %></span></div>
    </div>

  <% when 'runs' %>
    <div class="ig-table-wrap">
      <table class="ig-table">
        <thead>
          <tr><th>Run</th><th>Status</th><th>Routed via</th><th>Proof</th><th>Duration</th><th>Started</th></tr>
        </thead>
        <tbody>
          <% if @runs_for_action.any? %>
            <% @runs_for_action.each do |r| %>
              <tr>
                <td><%= link_to r[:id], run_path(r[:id]) %></td>
                <td><%= status_pill r[:status] %></td>
                <td class="ig-mut"><%= r[:routed_via] %></td>
                <td><%= status_pill r[:proof] %></td>
                <td class="ig-mut"><%= r[:duration_ms] %> ms</td>
                <td class="ig-mut"><%= time_ago(r[:started_at]) %></td>
              </tr>
            <% end %>
          <% else %>
            <tr><td colspan="6" class="ig-mut" style="text-align: center; padding: 32px;">No runs yet. Send a test request to record one.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
