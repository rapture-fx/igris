<%# Home — overview front door. Compact hero typography. %>
<div class="ic-topbar">
  <div class="ic-topbar__group">
    <span class="ic-topbar__title">Home</span>
    <span class="ic-chip">igris-default</span>
  </div>
  <div class="ic-topbar__group">
    <%= link_to 'Create action', new_action_path, class: 'ic-btn ic-btn--accent' %>
  </div>
</div>

<%= render 'shared/flash', degraded_error: @degraded_error %>

<div class="ic-body ic-scroll">
  <div style="max-width: 880px; margin: 0 auto;">
    <h1 class="ic-h1">Run agent actions that recover and prove what happened.</h1>
    <p class="ic-sub">
      Agent or app → Igris action endpoint → tool, API, or workflow.
      Policy, recovery, and signed receipts in between.
    </p>

    <%# ── Runs pulse — vertical bars + 7d moving-average overlay ───── %>
    <div class="ic-chartcard">
      <div class="ic-chartcard__head">
        <div>
          <div class="ic-chartcard__label">Runs · last <%= @daily_runs.length %> days</div>
          <div class="ic-chartcard__value">
            <%= @daily_runs.sum %>
            <span class="ic-chartcard__delta">
              <% delta = @daily_runs.last(7).sum - @daily_runs.first(7).sum %>
              <%= delta >= 0 ? "+#{delta}" : delta %> vs prior 7d
            </span>
          </div>
        </div>
        <div class="ic-pulse-legend" aria-hidden="true">
          <span class="ic-pulse-legend__row"><span class="ic-pulse-legend__bar"></span> runs / day</span>
          <span class="ic-pulse-legend__row"><span class="ic-pulse-legend__avg"></span> 7-day avg</span>
        </div>
      </div>
      <div style="overflow-x: auto; padding-top: 6px;">
        <%= runs_pulse(@daily_runs) %>
      </div>
    </div>

    <%# Setup guide lives on the standalone /welcome page now. %>

    <%# ── Recent runs ────────────────────────────────────────── %>
    <div class="ic-section-head">
      <span class="ic-section-head__label">Recent runs</span>
      <%= link_to 'View all', runs_path, class: 'ic-section-head__link' %>
    </div>
    <div class="ic-runs-list">
      <% (@recent_runs || []).first(4).each do |r| %>
        <% st = r[:status].to_s %>
        <% running = st.casecmp('Running').zero? %>
        <% failed  = st.casecmp('Failed').zero? %>
        <% dot_mod = running ? 'running' : (failed ? 'failed' : 'ok') %>
        <%= link_to run_path(r[:id]), class: 'ic-run-row' do %>
          <span class="ic-run-row__dot ic-run-row__dot--<%= dot_mod %> <%= 'ic-live-dot' if running %>"></span>
          <span class="ic-run-row__status ic-run-row__status--<%= dot_mod %>">
            <%= running ? 'Running' : (failed ? 'Failed' : 'OK') %>
          </span>
          <span class="ic-run-row__title">
            <span class="mono"><%= r[:id] %></span>
            <%= r[:action] %>
          </span>
          <span class="ic-run-row__sub"><span class="mono"><%= r[:routed_via] %></span></span>
          <span class="ic-run-row__sub"><%= r[:proof] %></span>
          <span class="ic-run-row__time">
            <%= r[:duration_ms] ? "#{r[:duration_ms]}ms" : '· · ·' %><br>
            <span style="color: var(--ic-text-7);"><%= time_ago(r[:started_at]) %></span>
          </span>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
