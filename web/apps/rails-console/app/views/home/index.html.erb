<%# Home — onboarding entry point. Compact, action-oriented, no documentation prose. %>
<%
  api_label =
    if @degraded_error then 'Degraded'
    elsif demo_mode?   then 'Demo data'
    else                    'Connected'
    end
%>

<div class="ic-topbar">
  <div class="ic-topbar__group">
    <span class="ic-topbar__title">Home</span>
    <%= project_chip %>
    <% if demo_mode? %>
      <span class="ic-status__pill is-warn">Demo data</span>
    <% end %>
  </div>
  <div class="ic-topbar__group">
    <a href="https://igrisinertial.com/docs" target="_blank" rel="noopener" class="ic-btn">Read docs</a>
    <%= link_to 'Go to Overview', overview_path, class: 'ic-btn' %>
  </div>
</div>

<%= render 'shared/flash', degraded_error: @degraded_error %>

<div class="ic-body" style="display: flex; align-items: center; justify-content: center; padding: 0;">
  <main class="ic-home-onboard" style="width: auto; max-width: 600px; margin: 0; padding: 0;">

    <header class="ic-home-onboard__hero">
      <h1 class="ic-home-onboard__title">Install Igris</h1>
      <p class="ic-home-onboard__sub">
        Run <code style="font-family: var(--ic-mono); font-size: 0.9em; color: var(--ic-text-2); background: var(--ic-overlay-3); padding: 1px 5px; border-radius: 4px;">curl -fsSL https://igrisinertial.com/install | bash</code>
        to install the runtime and connect your first agent.
      </p>
    </header>

    <p class="ic-home-onboard__sub">
      Next: <a href="<%= agents_path %>" class="ic-home-onboard__step-cta">create an agent</a>,
      <a href="<%= new_action_path %>" class="ic-home-onboard__step-cta">register an action</a>,
      <a href="<%= runs_path %>" class="ic-home-onboard__step-cta">execute a run</a>, and
      <a href="<%= runs_path %>" class="ic-home-onboard__step-cta">review proof</a>.
    </p>

  </main>
</div>
