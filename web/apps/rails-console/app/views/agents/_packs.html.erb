<%#
  Action Pack Catalog — the bundles of safe capabilities available to agents,
  and which this project has installed. A plain explanatory list (no cards).
  Installed packs show the actions they contributed (read from the tenant's own
  action list), their install date, and a count. Never renders action bodies,
  input schemas, secrets, or any unsafe field.
%>
<style>
  .ic-pack { padding: 16px 0; border-bottom: 1px solid var(--ic-border-soft); }
  .ic-pack__head { display: flex; align-items: baseline; gap: 10px; }
  .ic-pack__name { font-size: 14px; font-weight: 600; color: var(--ic-text-bright); }
  .ic-pack__meta { margin-left: auto; font-size: 11.5px; color: var(--ic-text-6); }
  .ic-pack__desc { margin-top: 4px; font-size: 12px; color: var(--ic-text-5); }
  .ic-pack__actions { margin-top: 10px; border-left: 2px solid var(--ic-border); padding-left: 12px; }
  .ic-pack__action { display: flex; align-items: baseline; gap: 8px; padding: 3px 0; font-size: 12px; }
  .ic-pack__action-name { font-family: var(--ic-mono); color: var(--ic-text-3); }
  .ic-pack__action-policy { color: var(--ic-text-6); font-size: 11px; }
  .ic-pack__none { margin-top: 8px; font-size: 11.5px; color: var(--ic-text-6); }
</style>

<div class="ic-body ic-scroll ic-doc" style="padding: 18px 16px; max-width: 820px; width: 100%; margin: 0 auto;">
  <div class="ic-evidence" style="margin-bottom: 6px;">
    <div class="ic-evidence__head">Action packs</div>
    <p class="ic-evidence__intro">
      Action packs are safe, pre-built bundles of capabilities an agent can call.
      Installing a pack registers its actions in this project. Below is what's
      available and what you've already installed.
    </p>
  </div>

  <% if Array(packs).blank? %>
    <div class="ic-evidence">
      <div class="ic-evidence__head">No packs available</div>
      <p class="ic-doc__note">
        No built-in action packs were returned. You can still create actions
        directly from the Actions surface.
      </p>
      <p style="margin-top: 12px;"><%= link_to 'Open Actions', actions_path, class: 'ic-btn' %></p>
    </div>
  <% else %>
    <% packs.each do |pack| %>
      <div class="ic-pack">
        <div class="ic-pack__head">
          <%= link_to pack[:display_name].presence || pack[:name], agent_pack_path(pack[:name]), class: 'ic-pack__name ic-doc__link' %>
          <% if pack[:installed] %>
            <span class="ic-doc__stat ic-doc__stat--ok">Installed</span>
          <% else %>
            <span class="ic-doc__stat ic-doc__stat--muted">Not installed</span>
          <% end %>
          <span class="ic-pack__meta">
            <%= pluralize(pack[:action_count], 'action') %>
            <% if pack[:installed] && pack[:installed_at] %> · installed <%= time_ago(pack[:installed_at]) %><% end %>
          </span>
        </div>

        <% if pack[:description].present? %>
          <div class="ic-pack__desc"><%= pack[:description] %></div>
        <% end %>

        <% if pack[:installed] && Array(pack[:installed_actions]).any? %>
          <div class="ic-pack__actions">
            <% pack[:installed_actions].each do |action| %>
              <div class="ic-pack__action">
                <%= link_to action[:name], action_path(action[:name]), class: 'ic-pack__action-name ic-doc__link' %>
                <% if action[:policy].present? %>
                  <span class="ic-pack__action-policy"><%= filter_label(action[:policy]) %></span>
                <% end %>
              </div>
            <% end %>
          </div>
        <% elsif !pack[:installed] %>
          <div class="ic-pack__none">
            Install this pack to add its <%= pluralize(pack[:action_count], 'action') %> to your project.
          </div>
        <% end %>
      </div>
    <% end %>

    <p class="ic-doc__note" style="margin-top: 14px;">
      Packs are installed through the Igris API or CLI; this catalog reflects the
      result. Installed actions are managed from the
      <%= link_to 'Actions', actions_path, class: 'ic-doc__link' %> surface.
    </p>
  <% end %>
</div>
