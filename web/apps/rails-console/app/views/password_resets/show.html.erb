<main class="ic-minimal-auth" aria-labelledby="reset-password-title">
  <div class="ic-minimal-auth__card">
    <h1 id="reset-password-title" class="ic-minimal-auth__title">Reset your password</h1>
    <p class="ic-minimal-auth__body">
      Open the reset link from your email to choose a new password. If you did not
      receive one, request a new link from the sign-in page.
    </p>
    <a href="<%= @landing_auth_url %>" class="ic-btn ic-btn--accent ic-minimal-auth__cta">Go to sign in</a>
    <p class="ic-minimal-auth__note">
      Password reset is handled on the account portal. After you sign in, you will
      enter the operator console.
    </p>
  </div>
</main>