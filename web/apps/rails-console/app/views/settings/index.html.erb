<%# Settings — minimal, configuration-focused. Sections: API endpoints,
    Access keys, Runtime keys, Tool & target access, Environment, Advanced.
    Team/billing/SSO live elsewhere. No secret values are ever echoed. %>
<% section = (@section.presence || SettingsController.normalize_section(params[:section])) %>
<% sections = [
  ['project',            'Project',               'Name and identity for this project'],
  ['api_endpoints',      'API endpoints',         'Base URLs for the Igris API and the console'],
  ['agent_keys',         'Agent / app API keys',  'Keys your agent or app uses to call Igris'],
  ['runtime_keys',       'Runtime keys',          'Keys runtimes use to connect'],
  ['target_access',      'Tool & target access',  'How agents reach tools through Igris'],
  ['console_front_door', 'Console front door',    'HTTP Basic auth that protects this console'],
  ['environment',        'Environment',           'Runtime variables and connection state'],
  ['advanced',           'Advanced',              'Audit log export and other rarely-used ops'],
] %>

<div class="ic-topbar">
  <div class="ic-topbar__group">
    <span class="ic-topbar__title">Settings</span>
    <span class="ic-chip"><%= sections.find { |s| s[0] == section }&.dig(1) %></span>
  </div>
  <div class="ic-topbar__group">
    <span class="ic-topbar__hint">Host configuration is shown but not edited here</span>
  </div>
</div>

<div class="ic-settings">
  <nav class="ic-settings__nav" aria-label="Settings sections">
    <% sections.each do |slug, label, sub| %>
      <%= link_to settings_path(section: slug),
          class: "ic-settings__nav-item #{'is-active' if section == slug}" do %>
        <span class="ic-settings__nav-label"><%= label %></span>
        <span class="ic-settings__nav-sub"><%= sub %></span>
      <% end %>
    <% end %>
  </nav>

  <div class="ic-settings__pane">
    <% if section == 'project' %>
      <% proj_err   = flash[:project_error]
         proj_value = flash[:project_name_value].presence || (@project && @project[:name]).to_s %>
      <div class="ic-settings__group">
        <div class="ic-settings__heading">Project</div>
        <p class="ic-settings__intro">
          Project is the name for everything you own here — your actions, runs,
          runtime keys, and evidence. There is no team, billing, or
          multi-project switching on this page.
        </p>

        <%= form_with url: project_path, method: :patch, local: true do |f| %>
          <%= f.hidden_field :source, value: 'settings' %>
          <div class="ic-field">
            <%= f.label :name, 'Project name', class: 'ic-field__label' %>
            <%= f.text_field :name, value: proj_value, class: 'ic-input',
                  autocomplete: 'off', maxlength: 80, placeholder: 'Support Agent',
                  'aria-describedby': 'project_name_help' %>
            <% if proj_err.present? %>
              <p class="ic-fielderror" role="alert"><%= proj_err %></p>
            <% end %>
            <p class="ic-field__help" id="project_name_help">
              2–80 characters. Letters, numbers, spaces, and basic punctuation.
              Shown across Home, Actions, Runs, and Runtimes.
            </p>
          </div>
          <%= f.button 'Save project name', class: 'ic-btn ic-btn--accent' %>
        <% end %>

        <div class="ic-field" style="margin-top: 16px;">
          <label class="ic-field__label">Public API URL</label>
          <input class="ic-input" type="text" value="<%= ENV['OVERTURE_PUBLIC_API_URL'].to_s.presence || 'https://overture.igrisinertial.com' %>" readonly />
          <p class="ic-field__help">The base URL your agent calls. Public, not secret.</p>
        </div>
      </div>

    <% elsif section == 'api_endpoints' %>
      <div class="ic-settings__group">
        <div class="ic-settings__heading">API endpoints</div>
        <p class="ic-settings__intro">
          Where this console talks to the Igris API, and the public URL your
          agent calls. The configured base URL is set on the host and is not
          shown here — only the public snippet URL and the connection state.
        </p>

        <div class="ic-field">
          <label class="ic-field__label">Public API URL</label>
          <input class="ic-input" type="text" value="<%= ENV['OVERTURE_PUBLIC_API_URL'].to_s.presence || 'https://overture.igrisinertial.com' %>" readonly />
          <p class="ic-field__help">The base URL shown in action code snippets (the endpoint your agent calls). Public, not secret.</p>
        </div>

        <div class="ic-field">
          <label class="ic-field__label">Connection</label>
          <p class="ic-field__help">
            <strong><%= @degraded_error ? 'Degraded' : 'Connected' %></strong>
            — the Igris API base URL is configured on the host as
            <code>OVERTURE_API_BASE_URL</code>. The value itself is never
            displayed here.
          </p>
        </div>

        <div class="ic-field">
          <label class="ic-field__label">API key for this console</label>
          <input class="ic-input" type="password" value="" placeholder="igris_… (set on the host, never shown)" disabled />
          <p class="ic-field__help">Set on the host as <code>OVERTURE_API_KEY</code>. Values are never displayed here.</p>
        </div>

        <div class="ic-callout">
          <div class="ic-callout__title">Who calls what</div>
          <p class="ic-callout__body">
            Your agent or app calls the public API URL above with its own
            <%= link_to 'Agent / app API key', settings_path(section: 'agent_keys') %>.
            The console service connection is configured on the host and is never
            used by your agent.
          </p>
        </div>
      </div>

    <% elsif section == 'agent_keys' %>
      <div class="ic-settings__group">
        <div class="ic-settings__heading">Agent / app API keys</div>
        <p class="ic-settings__intro">
          An agent or app calls an Igris action endpoint with its own API key —
          it never receives direct tool access. Create a key here, copy it once,
          and send it as <code>Authorization: Bearer &lt;key&gt;</code> when
          calling an <%= link_to 'action endpoint', actions_path %>.
        </p>

        <%# Read-once display of a freshly minted key — only present this render. %>
        <% if @generated_agent_key.present? %>
          <div class="ic-keygen">
            <div class="ic-keygen__warn">Shown once. Copy it now and store it in a password manager.</div>
            <%= code_snippet @generated_agent_key, language: 'bash', label: 'API key' %>
            <p class="ic-field__help">This key belongs to <strong><%= project_display_name %></strong>.</p>
          </div>
        <% end %>

        <%# Existing keys — prefix-only metadata, never the raw key. %>
        <% if @agent_keys.present? %>
          <div class="ic-keys">
            <% @agent_keys.each do |k| %>
              <div class="ic-key-row">
                <div class="ic-key-row__main">
                  <div class="ic-key-row__name"><%= k[:name] %></div>
                  <div class="ic-key-row__desc">
                    created <%= k[:created_at] ? time_ago(k[:created_at]) : '—' %>,
                    last used <%= k[:last_used_at] ? time_ago(k[:last_used_at]) : 'never' %>
                  </div>
                </div>
                <div class="ic-key-row__masked mono"><%= k[:prefix].presence || 'igris_…' %>…</div>
                <div class="ic-key-row__state ic-key-row__state--ok">active</div>
                <%= button_to 'Revoke', settings_api_key_path(k[:id]), method: :delete,
                      form: { style: 'margin:0;' }, class: 'ic-btn',
                      data: { confirm: 'Revoke this key? Anything using it will stop working.' } %>
                <span></span>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="ic-list-hint">No agent keys yet. Create one to let your agent call action endpoints.</p>
        <% end %>

        <%= form_with url: settings_api_keys_path, method: :post, local: true, class: 'ic-keyform' do %>
          <div class="ic-field">
            <label class="ic-field__label" for="key_name">New API key name</label>
            <%= text_field_tag :name, '', id: 'key_name', class: 'ic-input',
                  maxlength: 60, autocomplete: 'off', placeholder: 'e.g. Support Agent key' %>
            <p class="ic-field__help">A label to recognise this key later. The key is shown only once at creation.</p>
          </div>
          <%= submit_tag 'Create API key', class: 'ic-btn ic-btn--accent' %>
        <% end %>

        <div class="ic-callout" style="margin-top: 16px;">
          <div class="ic-callout__title">Three kinds of key</div>
          <p class="ic-callout__body">
            <strong>Agent / app keys</strong> (here) let your agent call action endpoints.
            <strong>Runtime keys</strong> connect a runtime — manage them on
            <%= link_to 'Runtimes', runtimes_path %>.
            The <strong>console service key</strong> is set on the host as
            <code>OVERTURE_API_KEY</code> and is never shown.
          </p>
        </div>
      </div>

    <% elsif section == 'runtime_keys' %>
      <div class="ic-settings__group">
        <div class="ic-settings__heading">Runtime keys</div>
        <p class="ic-settings__intro">
          A runtime key is used on a machine where <code>igris-runtime</code> runs
          — it lets that runtime connect to Igris and execute Local runtime
          actions. This is <strong>not</strong> the same as an agent / app API
          key, which an agent uses to call action endpoints. Runtime keys are
          created and rotated on the <%= link_to 'Runtimes', runtimes_path %>
          page, shown only once, so a raw key is never re-displayed here.
        </p>

        <div class="ic-field">
          <label class="ic-field__label">Runtime key</label>
          <input class="ic-input" type="password" value="" placeholder="igris_… (created on Runtimes — shown once)" disabled />
          <p class="ic-field__help">
            Generate or rotate a runtime key on the
            <%= link_to 'Runtimes', runtimes_path %> page. The runtime uses it as
            <code>IGRIS_API_KEY</code> when it starts.
          </p>
        </div>

        <div class="ic-callout">
          <div class="ic-callout__title">When do I need a runtime key?</div>
          <p class="ic-callout__body">
            Only for actions with a <strong>Local runtime</strong> target —
            those that touch private files, internal APIs, or local databases.
            Hosted API and webhook actions need no runtime and no runtime key.
          </p>
          <%= link_to 'Open Runtimes', runtimes_path, class: 'ic-btn' %>
        </div>
      </div>

    <% elsif section == 'target_access' %>
      <div class="ic-settings__group">
        <div class="ic-settings__heading">Tool &amp; target access</div>
        <p class="ic-settings__intro">
          The agent never gets direct tool access. It receives a safe Igris
          action endpoint. Igris evaluates policy, routes to the target, and
          records signed evidence — the agent only ever sees the endpoint.
        </p>

        <div class="ic-diagram ic-diagram--runtime" role="img"
             aria-label="The agent calls one Igris action endpoint; Igris applies policy and routing before reaching the real tool or target">
          <div class="ic-diagram__node">
            <div class="ic-diagram__node-label">Agent</div>
            <div class="ic-diagram__node-sub">Calls one endpoint</div>
          </div>
          <div class="ic-diagram__arrow">
            <svg width="20" height="10" viewBox="0 0 20 10" fill="none"><path d="M0 5 L18 5 M13 1 L18 5 L13 9" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <div class="ic-diagram__node ic-diagram__node--accent">
            <div class="ic-diagram__node-label">Igris action endpoint</div>
            <div class="ic-diagram__node-sub">Policy, routing, proof</div>
          </div>
          <div class="ic-diagram__arrow">
            <svg width="20" height="10" viewBox="0 0 20 10" fill="none"><path d="M0 5 L18 5 M13 1 L18 5 L13 9" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <div class="ic-diagram__node">
            <div class="ic-diagram__node-label">Tool / target</div>
            <div class="ic-diagram__node-sub">API, webhook, runtime</div>
          </div>
        </div>

        <ul class="ic-settings__list">
          <li>The agent does not receive direct tool access.</li>
          <li>The agent receives an Igris action endpoint.</li>
          <li>The <strong>Action</strong> defines what the endpoint can touch.</li>
          <li>The <strong>Target</strong> defines where it runs.</li>
          <li>The <strong>Policy</strong> defines how it is controlled.</li>
          <li>Secrets are referenced, never shown.</li>
        </ul>

        <div class="ic-field">
          <label class="ic-field__label">Where targets are configured</label>
          <p class="ic-field__help">
            Each action defines its own target — start one on
            <%= link_to 'Create action', new_action_path %> or review existing ones on
            <%= link_to 'Actions', actions_path %>. There is no global tool
            allow-list here — the boundary is the action itself.
          </p>
        </div>

        <div class="ic-field">
          <label class="ic-field__label">Where executions are recorded</label>
          <p class="ic-field__help">
            After an action runs, inspect what happened — evidence, policy,
            recovery, and proof — on <%= link_to 'Runs', runs_path %>.
          </p>
        </div>
      </div>

    <% elsif section == 'console_front_door' %>
      <div class="ic-settings__group">
        <div class="ic-settings__heading">Console front door</div>
        <p class="ic-settings__intro">
          Console access is configured on the host. HTTP Basic credentials
          protect this console — both fields must be set on the host for the
          door to lock. <code>/up</code> always bypasses Basic so liveness checks
          keep working. Neither value is shown here.
        </p>

        <div class="ic-field">
          <label class="ic-field__label">ADMIN_USERNAME</label>
          <input class="ic-input" type="text" value="" placeholder="<%= ENV['ADMIN_USERNAME'].present? ? 'set on host (not shown)' : 'not set' %>" disabled />
        </div>
        <div class="ic-field">
          <label class="ic-field__label">ADMIN_PASSWORD</label>
          <input class="ic-input" type="password" value="" placeholder="set on host (never shown)" disabled />
          <p class="ic-field__help">
            Status: <strong>
              <%= ENV['ADMIN_USERNAME'].present? && ENV['ADMIN_PASSWORD'].present? ? 'locked' : 'open (development)' %>
            </strong>
            — neither value is displayed here.
          </p>
        </div>
      </div>

    <% elsif section == 'environment' %>
      <div class="ic-settings__group">
        <div class="ic-settings__heading">Environment</div>
        <p class="ic-settings__intro">
          The runtime variables that decide what mode this console is in.
          Values are read from the process env at boot; secret values are
          never echoed back.
        </p>

        <%# Only presence/state is shown for host- and credential-bearing vars —
            the configured values (base URL, host, username, keys) are never
            echoed back. RAILS_ENV and Mode are safe to display in full. %>
        <% api_status = @degraded_error ? 'Degraded' : 'Connected'
           api_tone   = @degraded_error ? :warn : :ok
           proj_named = @project && @project[:name].present?
           env_rows = [
             ['Igris API',              api_status,                                  api_tone],
             ['Project name',           proj_named ? 'Named' : 'Needs name',         proj_named ? :ok : :warn],
             ['RAILS_ENV',              Rails.env,                                   :ok],
             ['OVERTURE_API_BASE_URL',  ENV['OVERTURE_API_BASE_URL'].present? ? 'set (hidden)' : '— unset —', ENV['OVERTURE_API_BASE_URL'].present? ? :ok : :warn],
             ['OVERTURE_API_KEY',       ENV['OVERTURE_API_KEY'].present? ? 'set (hidden)' : '— unset —', ENV['OVERTURE_API_KEY'].present? ? :ok : :warn],
             ['APP_HOST',               ENV['APP_HOST'].present? ? 'set (hidden)' : '— unset —',  :muted],
             ['ADMIN_USERNAME',         ENV['ADMIN_USERNAME'].present? ? 'set (hidden)' : '— unset —', :muted],
             ['ADMIN_PASSWORD',         ENV['ADMIN_PASSWORD'].present? ? 'set (hidden)' : '— unset —', :muted],
           ] %>
        <div class="ic-keys">
          <% env_rows.each do |k, v, tone| %>
            <div class="ic-key-row">
              <div class="ic-key-row__main">
                <div class="ic-key-row__name"><%= k %></div>
              </div>
              <div class="ic-key-row__masked"><%= v %></div>
              <div class="ic-key-row__state ic-key-row__state--<%= tone == :ok ? 'ok' : 'off' %>">
                <%= tone == :ok ? 'set' : (tone == :warn ? 'unset' : '—') %>
              </div>
              <span></span>
              <span></span>
            </div>
          <% end %>
        </div>
      </div>

    <% elsif section == 'advanced' %>
      <div class="ic-settings__group">
        <div class="ic-settings__heading">Console appearance</div>
        <p class="ic-settings__intro">
          A local preference for this browser. It takes effect immediately and
          works whether or not the console is connected to a live Igris API — no
          account or server setting is changed.
        </p>
        <div class="ic-field">
          <label class="ic-field__label">Theme</label>
          <div class="ic-keyform" id="ic-appearance" role="group" aria-label="Theme">
            <button type="button" class="ic-btn" data-theme="light">Light</button>
            <button type="button" class="ic-btn" data-theme="dark">Dark</button>
          </div>
          <p class="ic-field__help">Saved in this browser only.</p>
        </div>
      </div>
      <script>
        (function () {
          var wrap = document.getElementById('ic-appearance');
          if (!wrap) return;
          var btns = wrap.querySelectorAll('.ic-btn');
          function current() {
            return document.documentElement.classList.contains('dark') ? 'dark' : 'light';
          }
          function sync() {
            var cur = current();
            btns.forEach(function (b) {
              var on = b.dataset.theme === cur;
              b.classList.toggle('ic-btn--accent', on);
              b.setAttribute('aria-pressed', on ? 'true' : 'false');
            });
          }
          wrap.addEventListener('click', function (e) {
            var b = e.target.closest('.ic-btn');
            if (!b) return;
            var dark = b.dataset.theme === 'dark';
            document.documentElement.classList.toggle('dark', dark);
            try { localStorage.setItem('ic-theme', dark ? 'dark' : 'light'); } catch (_) {}
            sync();
          });
          sync();
        })();
      </script>

      <div class="ic-settings__group">
        <div class="ic-settings__heading">Advanced</div>
        <p class="ic-settings__intro">
          Rarely-used operations. Reach for these deliberately. Audit-log export
          and runtime pause are managed through the Igris API, not from this
          console.
        </p>

        <div class="ic-danger ic-danger--red">
          <div>
            <div class="ic-danger__name">Reset console onboarding</div>
            <div class="ic-danger__sub">Forgets the welcomed-cookie and shows the onboarding page again on next visit.</div>
          </div>
          <%= button_to 'Reset', reset_onboarding_path,
              method: :post, form: { style: 'display:inline; margin:0;' },
              class: 'ic-btn',
              data: { action: 'reset-onboarding' } %>
        </div>
      </div>
    <% end %>
  </div>
</div>
