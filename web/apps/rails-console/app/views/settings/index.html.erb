<%# Settings — minimal, configuration-focused. Sections: API endpoints,
    Access keys, Runtime keys, Tool & target access, Environment, Advanced.
    Team/billing/SSO live elsewhere. No secret values are ever echoed. %>
<% section = (params[:section].presence || 'api').to_s %>
<% sections = [
  ['api',     'API endpoints',       'Base URLs for the Igris API and the console'],
  ['access',  'Agent access',        'How agents and this console authenticate'],
  ['runtime', 'Runtime keys',        'Keys runtimes use to connect'],
  ['tools',   'Tool & target access','How agents reach tools through Igris'],
  ['env',     'Environment',         'Runtime variables and connection state'],
  ['advanced','Advanced',            'Audit log export and other rarely-used ops'],
] %>

<div class="ic-topbar">
  <div class="ic-topbar__group">
    <span class="ic-topbar__title">Settings</span>
    <span class="ic-chip"><%= sections.find { |s| s[0] == section }&.dig(1) %></span>
  </div>
  <div class="ic-topbar__group">
    <% if demo_mode? %>
      <span class="ic-chip">demo mode · fixtures</span>
    <% end %>
    <span class="ic-topbar__hint">Configured on the host · read-only here</span>
  </div>
</div>

<div class="ic-settings">
  <nav class="ic-settings__nav" aria-label="Settings sections">
    <% sections.each do |slug, label, sub| %>
      <%= link_to settings_path(section: slug),
          class: "ic-settings__nav-item #{'is-active' if section == slug}" do %>
        <span class="ic-settings__nav-label"><%= label %></span>
        <span class="ic-settings__nav-sub"><%= sub %></span>
      <% end %>
    <% end %>
  </nav>

  <div class="ic-settings__pane">
    <% if section == 'api' %>
      <div class="ic-settings__group">
        <div class="ic-settings__heading">API endpoints</div>
        <p class="ic-settings__intro">
          Where this console talks to the Igris API, and the public URL your
          agent calls. The configured base URL is set on the host and is not
          shown here — only the public snippet URL and the connection state.
        </p>

        <div class="ic-field">
          <label class="ic-field__label">Public API URL</label>
          <input class="ic-input" type="text" value="<%= ENV['OVERTURE_PUBLIC_API_URL'].to_s.presence || 'https://api.igrisinertial.com' %>" readonly />
          <p class="ic-field__help">The base URL shown in action code snippets (the endpoint your agent calls). Public, not secret.</p>
        </div>

        <div class="ic-field">
          <label class="ic-field__label">Connection</label>
          <p class="ic-field__help">
            <strong>
              <%= @degraded_error ? 'Degraded' : (demo_mode? ? 'Demo (fixtures)' : 'Connected') %>
            </strong>
            — the Igris API base URL is configured on the host as
            <code>OVERTURE_API_BASE_URL</code>. Unset means fixture / demo mode.
            The value itself is never displayed here.
          </p>
        </div>

        <div class="ic-field">
          <label class="ic-field__label">API key for this console</label>
          <input class="ic-input" type="password" value="" placeholder="igris_… (set on the host, never shown)" disabled />
          <p class="ic-field__help">Set on the host as <code>OVERTURE_API_KEY</code>. Values are never displayed here.</p>
        </div>
      </div>

    <% elsif section == 'access' %>
      <div class="ic-settings__group">
        <div class="ic-settings__heading">Agent access</div>
        <p class="ic-settings__intro">
          An agent or app calls an Igris action endpoint with its own API key —
          it never receives direct tool access. This console authenticates to
          the Igris API with a separate key set on the host. Keys are never
          displayed here.
        </p>

        <div class="ic-field">
          <label class="ic-field__label">Agent API key</label>
          <input class="ic-input" type="password" value="" placeholder="igris_… (created with the runtime key — shown once)" disabled />
          <p class="ic-field__help">
            Agents send <code>Authorization: Bearer $IGRIS_API_KEY</code> to an
            action endpoint. Create one on the <%= link_to 'Runtimes', runtimes_path %> page —
            it is shown only once.
          </p>
        </div>

        <div class="ic-field">
          <label class="ic-field__label">Console API key</label>
          <input class="ic-input" type="password" value="" placeholder="igris_… (set on the host, never shown)" disabled />
          <p class="ic-field__help">
            Set on the host as <code>OVERTURE_API_KEY</code>. Used only by this
            console to read actions, runs, and runtimes. Never displayed.
          </p>
        </div>
      </div>

      <div class="ic-settings__group">
        <div class="ic-settings__heading">Console front door</div>
        <p class="ic-settings__intro">
          HTTP Basic credentials that protect this console. Both fields
          must be set on the host for the door to lock. <code>/up</code>
          always bypasses Basic so liveness checks keep working.
        </p>

        <div class="ic-field">
          <label class="ic-field__label">ADMIN_USERNAME</label>
          <input class="ic-input" type="text" value="" placeholder="<%= ENV['ADMIN_USERNAME'].present? ? 'set on host · not shown' : 'not set' %>" disabled />
        </div>
        <div class="ic-field">
          <label class="ic-field__label">ADMIN_PASSWORD</label>
          <input class="ic-input" type="password" value="" placeholder="set on host · never shown" disabled />
          <p class="ic-field__help">
            Status: <strong>
              <%= ENV['ADMIN_USERNAME'].present? && ENV['ADMIN_PASSWORD'].present? ? 'locked' : 'open (development)' %>
            </strong>
            — neither value is displayed here.
          </p>
        </div>
      </div>

    <% elsif section == 'runtime' %>
      <div class="ic-settings__group">
        <div class="ic-settings__heading">Runtime keys</div>
        <p class="ic-settings__intro">
          A runtime key lets a local runtime connect to Igris and execute
          Local runtime actions. It is shown only once when created — store
          it in a password manager. Keys are managed on the Runtimes page,
          never here, so a raw key is never re-displayed.
        </p>

        <div class="ic-field">
          <label class="ic-field__label">Runtime key</label>
          <input class="ic-input" type="password" value="" placeholder="igris_… (created on Runtimes — shown once)" disabled />
          <p class="ic-field__help">
            Generate or rotate a runtime key on the
            <%= link_to 'Runtimes', runtimes_path %> page. The runtime uses it as
            <code>IGRIS_API_KEY</code> when it starts.
          </p>
        </div>

        <div class="ic-callout">
          <div class="ic-callout__title">When do I need a runtime key?</div>
          <p class="ic-callout__body">
            Only for actions with a <strong>Local runtime</strong> target —
            those that touch private files, internal APIs, or local databases.
            Hosted API and webhook actions need no runtime and no runtime key.
          </p>
          <%= link_to 'Open Runtimes', runtimes_path, class: 'ic-btn' %>
        </div>
      </div>

    <% elsif section == 'tools' %>
      <div class="ic-settings__group">
        <div class="ic-settings__heading">Tool &amp; target access</div>
        <p class="ic-settings__intro">
          The agent never gets direct tool access. It receives a safe Igris
          action endpoint. Igris evaluates policy, routes to the target, and
          records signed evidence — the agent only ever sees the endpoint.
        </p>

        <div class="ic-diagram ic-diagram--runtime" role="img"
             aria-label="The agent calls one Igris action endpoint; Igris applies policy and routing before reaching the real tool or target">
          <div class="ic-diagram__node">
            <div class="ic-diagram__node-label">Agent</div>
            <div class="ic-diagram__node-sub">Calls one endpoint</div>
          </div>
          <div class="ic-diagram__arrow">
            <svg width="20" height="10" viewBox="0 0 20 10" fill="none"><path d="M0 5 L18 5 M13 1 L18 5 L13 9" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <div class="ic-diagram__node ic-diagram__node--accent">
            <div class="ic-diagram__node-label">Igris action endpoint</div>
            <div class="ic-diagram__node-sub">Policy · routing · proof</div>
          </div>
          <div class="ic-diagram__arrow">
            <svg width="20" height="10" viewBox="0 0 20 10" fill="none"><path d="M0 5 L18 5 M13 1 L18 5 L13 9" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <div class="ic-diagram__node">
            <div class="ic-diagram__node-label">Tool / target</div>
            <div class="ic-diagram__node-sub">API · webhook · runtime</div>
          </div>
        </div>

        <ul class="ic-settings__list">
          <li>The agent does not receive direct tool access.</li>
          <li>The agent receives an Igris action endpoint.</li>
          <li>The <strong>Action</strong> defines what the endpoint can touch.</li>
          <li>The <strong>Target</strong> defines where it runs.</li>
          <li>The <strong>Policy</strong> defines how it is controlled.</li>
          <li>Secrets are referenced, never shown.</li>
        </ul>

        <div class="ic-field">
          <label class="ic-field__label">Where targets are configured</label>
          <p class="ic-field__help">
            Each action defines its own target — start one on
            <%= link_to 'Create action', new_action_path %> or review existing ones on
            <%= link_to 'Actions', actions_path %>. There is no global tool
            allow-list here — the boundary is the action itself.
          </p>
        </div>

        <div class="ic-field">
          <label class="ic-field__label">Where executions are recorded</label>
          <p class="ic-field__help">
            After an action runs, inspect what happened — evidence, policy,
            recovery, and proof — on <%= link_to 'Runs', runs_path %>.
          </p>
        </div>
      </div>

    <% elsif section == 'env' %>
      <div class="ic-settings__group">
        <div class="ic-settings__heading">Environment</div>
        <p class="ic-settings__intro">
          The runtime variables that decide what mode this console is in.
          Values are read from the process env at boot; secret values are
          never echoed back.
        </p>

        <%# Only presence/state is shown for host- and credential-bearing vars —
            the configured values (base URL, host, username, keys) are never
            echoed back. RAILS_ENV and Mode are safe to display in full. %>
        <% env_rows = [
             ['RAILS_ENV',              Rails.env,                                   :ok],
             ['Mode',                   demo_mode? ? 'demo (fixtures)' : 'connected',demo_mode? ? :warn : :ok],
             ['OVERTURE_API_BASE_URL',  ENV['OVERTURE_API_BASE_URL'].present? ? 'set (hidden)' : '— unset —', ENV['OVERTURE_API_BASE_URL'].present? ? :ok : :warn],
             ['OVERTURE_API_KEY',       ENV['OVERTURE_API_KEY'].present? ? 'set (hidden)' : '— unset —', ENV['OVERTURE_API_KEY'].present? ? :ok : :warn],
             ['APP_HOST',               ENV['APP_HOST'].present? ? 'set (hidden)' : '— unset —',  :muted],
             ['ADMIN_USERNAME',         ENV['ADMIN_USERNAME'].present? ? 'set (hidden)' : '— unset —', :muted],
             ['ADMIN_PASSWORD',         ENV['ADMIN_PASSWORD'].present? ? 'set (hidden)' : '— unset —', :muted],
           ] %>
        <div class="ic-keys">
          <% env_rows.each do |k, v, tone| %>
            <div class="ic-key-row">
              <div class="ic-key-row__main">
                <div class="ic-key-row__name"><%= k %></div>
              </div>
              <div class="ic-key-row__masked"><%= v %></div>
              <div class="ic-key-row__state ic-key-row__state--<%= tone == :ok ? 'ok' : 'off' %>">
                <%= tone == :ok ? 'set' : (tone == :warn ? 'unset' : '—') %>
              </div>
              <span></span>
              <span></span>
            </div>
          <% end %>
        </div>
      </div>

    <% elsif section == 'advanced' %>
      <div class="ic-settings__group">
        <div class="ic-settings__heading">Advanced</div>
        <p class="ic-settings__intro">
          Rarely-used operations. Reach for these deliberately. Audit-log export
          and runtime pause are managed through the Igris API, not from this
          console.
        </p>

        <div class="ic-danger ic-danger--red">
          <div>
            <div class="ic-danger__name">Reset console onboarding</div>
            <div class="ic-danger__sub">Forgets the welcomed-cookie and shows the onboarding page again on next visit.</div>
          </div>
          <%= button_to 'Reset', enter_console_path,
              method: :post, form: { style: 'display:inline; margin:0;' },
              class: 'ic-btn',
              data: { action: 'reset-onboarding' } %>
        </div>
      </div>
    <% end %>
  </div>
</div>
