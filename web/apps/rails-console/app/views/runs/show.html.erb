<%#
  Run detail.

  Real mode (Overture connected): strictly data-derived evidence only —
  the "What happened" summary, a safe evidence list, and the execution
  story built from actual task fields. Nothing is fabricated; missing
  fields render as "—" or an explicit unavailable state.

  Fixture mode: the illustrative landing-hero execution preview is kept as
  a clearly-labelled DEMO so the offline UI still shows the full shape.
%>
<div class="igris-console" style="display: flex; flex-direction: column; flex: 1; min-height: 0;">

  <%# ── Topbar: crumb / title / linkbacks ─────────────────────────────── %>
  <% through_runtime = data_source.run_through_runtime?(@run)
     runtime_id      = @run[:runtime_id].to_s.strip %>
  <div class="ic-topbar">
    <div class="ic-topbar__group">
      <%= link_to 'Runs', runs_path, class: 'ic-topbar__crumb' %>
      <span class="ic-topbar__sep">/</span>
      <span class="ic-topbar__title"><%= @run[:action] %></span>
      <span class="ic-topbar__id mono"><%= @run[:id] %></span>
      <%= copy_button @run[:id] %>
      <%= project_chip %>
    </div>
    <div class="ic-topbar__group">
      <% if @action_known %>
        <%= link_to 'Back to action', action_path(@run[:action]), class: 'ic-btn' %>
      <% end %>
      <% if through_runtime %>
        <%= link_to 'Open runtime', runtimes_path, class: 'ic-btn' %>
      <% end %>
    </div>
  </div>

  <%= render 'shared/flash', degraded_error: @degraded_error %>

  <div class="ic-body ic-scroll ic-run-detail">
    <% running = @run[:status].to_s.casecmp('Running').zero? %>

    <%# ── What happened — the first-run summary, before any deep evidence ── %>
    <% proof_label = @run[:proof].to_s.presence || 'Proof unavailable'
       proof_unavailable = proof_label.match?(/unavailable|pending/i)
       started_label = @run[:started_at].respond_to?(:strftime) ? @run[:started_at].utc.strftime('%H:%M:%S UTC') : '—'
       duration_label = @run[:duration_ms].present? ? "#{@run[:duration_ms]}ms" : '—' %>
    <% guidance = run_guidance_state(@run) %>
    <div class="ic-run-detail-layout">
      <aside class="ic-run-detail-rail" aria-label="Execution detail">
        <div class="ic-summary">
          <div class="ic-summary__head">Execution detail</div>
          <div class="ic-summary__grid">
            <div class="ic-summary__cell ic-summary__cell--wide">
              <div class="ic-summary__k">Action</div>
              <div class="ic-summary__v mono"><%= @run[:action] %></div>
            </div>
            <div class="ic-summary__cell">
              <div class="ic-summary__k">Status</div>
              <div class="ic-summary__v"><%= status_pill @run[:status] %></div>
            </div>
            <div class="ic-summary__cell">
              <div class="ic-summary__k">Routed via</div>
              <div class="ic-summary__v"><%= @run[:routed_via] %></div>
            </div>
            <div class="ic-summary__cell">
              <div class="ic-summary__k">Policy</div>
              <div class="ic-summary__v"><%= @run[:policy] %></div>
            </div>
            <div class="ic-summary__cell">
              <div class="ic-summary__k">Proof</div>
              <div class="ic-summary__v"><%= status_pill proof_label %></div>
            </div>
            <div class="ic-summary__cell">
              <div class="ic-summary__k">Started</div>
              <div class="ic-summary__v"><%= started_label %></div>
            </div>
            <div class="ic-summary__cell">
              <div class="ic-summary__k">Duration</div>
              <div class="ic-summary__v"><%= duration_label %></div>
            </div>
          </div>
          <% if proof_unavailable %>
            <p class="ic-summary__note">Proof is available when signed runtime evidence exists.</p>
          <% end %>
        </div>

        <% if guidance %>
          <div class="ic-nextstep">
            <div>
              <div class="ic-nextstep__kicker">What to do next</div>
              <div class="ic-nextstep__title">
                <% case guidance
                   when :runtime_unavailable %>This run required a runtime that was unavailable.
                <% when :failed %>Run failed.
                <% when :running %>Run is still in flight.
                <% when :proof_unavailable %>Proof is not yet available for this run.
                <% when :completed %>Run completed successfully.
                <% end %>
              </div>
              <p class="ic-nextstep__sub">
                <% case guidance
                   when :runtime_unavailable %>Connect a runtime, then re-run the action so it can execute locally.
                <% when :failed %>Open the action to review its target and policy, or copy the run ID to share it.
                <% when :running %>Step evidence appears here as the run commits each step.
                <% when :proof_unavailable %>Proof is available once signed runtime evidence exists.
                <% when :completed %>Review the signed evidence below, or open the action to run it again.
                <% end %>
              </p>
            </div>
            <div class="ic-nextstep__cta">
              <% case guidance
                 when :runtime_unavailable %>
                <%= link_to 'Connect runtime', runtimes_path, class: 'ic-btn ic-btn--accent' %>
                <% if @action_known %><%= link_to 'Open action', action_path(@run[:action]), class: 'ic-btn' %><% end %>
              <% when :failed %>
                <% if @action_known %><%= link_to 'Open action', action_path(@run[:action]), class: 'ic-btn' %><% end %>
                <%= copy_button @run[:id], label: 'Copy run ID' %>
              <% when :proof_unavailable %>
                <a href="#evidence" class="ic-btn">View evidence</a>
              <% when :completed %>
                <a href="#evidence" class="ic-btn ic-btn--accent">View evidence</a>
                <% if @action_known %><%= link_to 'Open action', action_path(@run[:action]), class: 'ic-btn' %><% end %>
              <% end %>
            </div>
          </div>
        <% end %>
      </aside>

      <section class="ic-run-detail-scroll" aria-label="Run evidence and audit details">

    <% if demo_mode? %>
      <%# ════════════ FIXTURE MODE: clearly-labelled illustrative demo ════════ %>
      <div class="ig-strip" style="background: rgba(251,191,36,0.06); border: 1px solid rgba(251,191,36,0.25); border-radius: 8px; margin-bottom: 14px;">
        <%= chip 'Demo data', tone: :warn %>
        <span style="font-size: 12px; color: var(--ig-text-body);">
          Illustrative example run. Connect Igris to see real, data-derived evidence here.
        </span>
      </div>

      <% submitted_chip_time = @run[:started_at].respond_to?(:strftime) ? @run[:started_at].utc.strftime('%H:%M:%S UTC') : '—' %>
      <div class="ic-evidence">
        <div class="ic-evidence__head">Demo context</div>
        <div class="ic-def">
          <span class="ic-def__label">Submitter</span>
          <div class="ic-def__value">
            <span class="ic-chip">mateo@acme.io</span>
            <span class="ic-def__hint">engineer, integrations</span>
          </div>
        </div>
        <div class="ic-def">
          <span class="ic-def__label">Region</span>
          <div class="ic-def__value">
            <span class="ic-chip">fra1·prod</span>
            <span class="ic-def__hint">eu-central, primary</span>
          </div>
        </div>
        <div class="ic-def">
          <span class="ic-def__label">Worker</span>
          <div class="ic-def__value">
            <span class="ic-chip">worker_b</span>
            <span class="ic-def__hint">recovered from</span>
            <span class="ic-chip">worker_a</span>
          </div>
        </div>
        <div class="ic-def">
          <span class="ic-def__label">Submitted</span>
          <div class="ic-def__value">
            <span class="ic-chip"><%= submitted_chip_time %></span>
            <span class="ic-def__hint"><%= time_ago(@run[:started_at]) %>, action workflow</span>
          </div>
        </div>
      </div>

      <%# Committed actions panel — a timestamped log, led by the receipt-chain narrative %>
      <% steps = @run[:steps] || [] %>
      <% log_times = committed_log_times(@run, steps) %>
      <% committed_count = steps.count { |s| s[:kind] == :action && s[:status] == :committed } %>
      <% latest_committed = steps.select { |s| s[:kind] == :action && s[:status] == :committed }.last %>
      <% total_actions = steps.count { |s| s[:kind] == :action } %>
      <% failed_count = steps.count { |s| s[:status] == :failed } %>
      <div class="ic-panel" id="evidence">
        <p class="ic-narrative">
          <% if running %>
            The receipt chain is <span class="accent">valid</span> up to
            <span class="mono"><%= latest_committed ? "action #{latest_committed[:num]}" : 'the first step' %></span>.
            <% rn = steps.find { |s| s[:status] == :running } %>
            <% if rn %>Action <%= rn[:num] %> (<span class="mono"><%= rn[:name] %></span>) is currently running.<% end %>
          <% elsif @run[:status] == 'Failed' %>
            The receipt chain stops at the failed call. The console honestly reports
            the absence — no fabricated proof.
          <% else %>
            The receipt chain is <span class="accent">valid</span> end-to-end.
            <%= committed_count %> action<%= 's' if committed_count != 1 %> committed in
            <span class="mono"><%= @run[:duration_ms] %>ms</span>.
          <% end %>
        </p>
        <details class="ic-loggroup" open>
          <summary class="ic-panel__head ic-loggroup__head">
            <div class="ic-panel__head-l">
              <span class="ic-loggroup__chev" aria-hidden="true"></span>
              <span>Committed actions (<%= total_actions %>)</span>
              <span class="ic-panel__count-plus">+<%= committed_count %></span>
              <span class="ic-panel__count-minus">−<%= failed_count %></span>
            </div>
            <div class="ic-panel__head-r">
              <% if @run[:duration_ms].present? %>
                <span class="ic-log__dur mono"><%= @run[:duration_ms] %>ms</span>
              <% end %>
              <% if running %>
                <span class="ic-log__status ic-log__status--run"><span class="ic-bullet-dot ic-bullet-dot--running ic-breathing"></span>running</span>
              <% elsif failed_count.positive? %>
                <span class="ic-log__status ic-log__status--fail">failed</span>
              <% else %>
                <span class="ic-log__status ic-log__status--ok"><svg class="ic-bullet-check" viewBox="0 0 24 24" fill="none"><path d="M5 12.5 L10 17 L19 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>committed</span>
              <% end %>
            </div>
          </summary>

          <div class="ic-log__body">
            <% steps.each_with_index do |s, i| %>
              <% ts = log_times[i] %>
              <% if s[:kind] == :fault %>
                <div class="ic-line ic-line--fault ic-step-in">
                  <span class="ic-line__ts mono"><%= ts %></span>
                  <div class="ic-line__main">
                    <span class="ic-line__name"><%= s[:name] %></span>
                    <span class="ic-line__detail"><%= log_detail_html(s[:detail]) %></span>
                  </div>
                  <span class="ic-line__latency"><%= s[:latency] %>ms</span>
                  <span class="ic-line__receipt">recovered</span>
                </div>
              <% else %>
                <% is_running = s[:status] == :running %>
                <div class="ic-line ic-step-in">
                  <span class="ic-line__ts mono"><%= ts %></span>
                  <div class="ic-line__main">
                    <span class="ic-line__name <%= 'ic-line__name--running' if is_running %>"><%= s[:name] %></span>
                    <span class="ic-line__detail"><%= log_detail_html(s[:detail]) %></span>
                  </div>
                  <span class="ic-line__latency"><%= s[:latency] ? "#{s[:latency]}ms" : '' %></span>
                  <% if s[:receipt] %>
                    <span class="ic-line__receipt ic-line__receipt--ok"><%= s[:receipt] %></span>
                  <% else %>
                    <span class="ic-line__receipt ic-line__receipt--none">—</span>
                  <% end %>
                </div>
              <% end %>
            <% end %>
          </div>
        </details>
      </div>

    <% else %>
      <%# ════════════ REAL MODE: strictly data-derived evidence ═══════════════ %>
      <% receipt_hash = (@run[:raw_evidence] || []).find { |e| e[:key].to_s == 'receipt_hash' }&.dig(:value)
         receipt_signed = (@run[:raw_evidence] || []).find { |e| e[:key].to_s == 'receipt_signed' }&.dig(:value)
         dash = ->(v) { v.to_s.strip.presence || '—' } %>

      <div class="ic-evidence" id="evidence">
        <div class="ic-evidence__head">Run metadata</div>
        <p class="ic-evidence__intro">
          Stable identifiers and routing facts for this execution. Raw inputs, outputs, secrets, and failure text are not shown on this page.
        </p>
        <div class="ic-def"><span class="ic-def__label">Task ID</span><div class="ic-def__value mono"><%= dash.call(@run[:id]) %></div></div>
        <div class="ic-def"><span class="ic-def__label">Action</span><div class="ic-def__value mono"><%= dash.call(@run[:action]) %></div></div>
        <div class="ic-def"><span class="ic-def__label">Status</span><div class="ic-def__value"><%= status_pill @run[:status] %></div></div>
        <div class="ic-def"><span class="ic-def__label">Executed target</span><div class="ic-def__value mono"><%= dash.call(@run[:executed_target]) %></div></div>
        <div class="ic-def"><span class="ic-def__label">Routed via</span><div class="ic-def__value"><%= dash.call(@run[:routed_via]) %></div></div>
        <div class="ic-def"><span class="ic-def__label">Runtime</span><div class="ic-def__value mono"><%= dash.call(@run[:runtime_id]) %></div></div>
        <div class="ic-def"><span class="ic-def__label">Started</span><div class="ic-def__value"><%= started_label %> <span class="ic-def__hint"><%= time_ago(@run[:started_at]) %></span></div></div>
        <div class="ic-def"><span class="ic-def__label">Duration</span><div class="ic-def__value mono"><%= duration_label %></div></div>
        <div class="ic-def"><span class="ic-def__label">Policy</span><div class="ic-def__value"><%= dash.call(@run[:policy]) %></div></div>
        <div class="ic-def"><span class="ic-def__label">Recovery</span><div class="ic-def__value"><%= dash.call(@run[:recovery]) %></div></div>
        <div class="ic-def"><span class="ic-def__label">Proof</span><div class="ic-def__value"><%= status_pill proof_label %></div></div>
        <div class="ic-def">
          <span class="ic-def__label">Receipt hash</span>
          <div class="ic-def__value mono"><%= dash.call(receipt_hash) %></div>
        </div>
        <% if receipt_signed.present? %>
          <div class="ic-def"><span class="ic-def__label">Receipt signed</span><div class="ic-def__value"><%= receipt_signed %></div></div>
        <% end %>
      </div>

      <div class="ic-evidence">
        <div class="ic-evidence__head">Step evidence</div>
        <p class="ic-evidence__intro">
          Ordered execution events from the run record. Digests are shown instead of raw input or output content.
        </p>
        <% steps = @run[:execution_steps] || [] %>
        <% if steps.any? %>
          <div class="ic-log__body ic-log__body--flush">
            <% steps.each do |st| %>
              <div class="ic-logline ic-logline--stepev">
                <span class="ic-line__ts mono"><%= step_evidence_time(st[:at]) %></span>
                <span class="ic-stepev__idx mono"><%= format('%02d', st[:index]) %></span>
                <div class="ic-stepev__main">
                  <span class="ic-stepev__label"><%= st[:label].presence || '—' %></span>
                  <span class="ic-stepev__kind"><%= st[:kind] %></span>
                </div>
                <span class="ic-stepev__status ic-stepev__status--<%= st[:status_tone] %>"><%= st[:status] %></span>
                <span class="ic-stepev__proof"><%= st[:proof] %></span>
                <span class="ic-stepev__digest mono"><%= st[:digest].presence || '—' %></span>
              </div>
            <% end %>
          </div>
          <p class="ic-summary__note" style="margin: 10px 0 2px;">Step proof appears when signed receipt data is available.</p>
        <% else %>
          <p class="ic-summary__note" style="margin: 8px 0 2px;">No ordered step evidence is available for this run yet.</p>
        <% end %>
      </div>

      <div class="ic-evidence">
        <div class="ic-evidence__head">Execution story</div>
        <p class="ic-evidence__intro">
          Human-readable sequence reconstructed from the normalized run state.
        </p>
        <% story = @run[:story] || [] %>
        <% if story.any? %>
          <div class="ig-timeline" style="margin-top: 6px;">
            <% story.each do |ev| %>
              <div class="ig-timeline__step is-<%= ev[:tone] %>">
                <div class="ig-timeline__title"><%= ev[:title] %></div>
                <% if ev[:meta].present? %><div class="ig-timeline__meta"><%= ev[:meta] %></div><% end %>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="ic-summary__note" style="margin: 8px 0 0;">No execution story available yet.</p>
        <% end %>
      </div>
    <% end %>

    <%# ── Run Inspector — server-rendered, redacted quick-inspection of this
        run. Carries its own Audit interpretation + Execution profile, so no
        separate audit block is rendered below it. ───────────────────────── %>
    <div class="ic-run-expand">
      <%= render 'inspector', run: @run, run_id: @run[:id], action_known: @action_known %>
    </div>

    <div class="ic-foot-time">
      <%= @run[:started_at].respond_to?(:strftime) ? @run[:started_at].utc.strftime('%H:%M:%S') : '' %>
      <%= ' · live' if running %>
    </div>
      </section>
    </div>
  </div>

  <% if demo_mode? %>
    <div class="ic-footer">
      <div class="ic-footer__bar">
        <span class="ic-footer__chip"><span class="dot"></span><span>action_workflow v1</span></span>
        <span class="ic-footer__sep">·</span>
        <span>Receipts ed25519</span>
        <div class="ic-footer__spacer"></div>
      </div>
    </div>
  <% end %>
</div>
