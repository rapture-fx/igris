<%#
  Runs — the primary debugging and trust surface. Each row connects an Action
  to what happened when it was called, where it ran, and what to do next.
  Counts and filters are derived only from the loaded window of runs.
%>
<div class="igris-console" style="display: flex; flex-direction: column; flex: 1; min-height: 0;">
  <div class="ic-topbar">
    <div class="ic-topbar__group">
      <span class="ic-topbar__title">Runs</span>
      <%= project_chip %>
      <span class="ic-topbar__hint">Action executions — evidence, policy, recovery, and proof</span>
    </div>
    <div class="ic-topbar__group">
      <%= link_to 'Create action', new_action_path, class: 'ic-btn ic-btn--accent' %>
      <%= link_to 'Open Actions', actions_path, class: 'ic-btn' %>
    </div>
  </div>

  <%= render 'shared/flash', degraded_error: @degraded_error %>

  <%# ── Summary strip — counts over the loaded window ─────────────────── %>
  <div class="ic-runs-strip">
    <span class="ic-chip"><%= @counts[:total] %> shown</span>
    <% if @counts[:failed].positive? %>
      <span class="ic-chip" style="color: var(--ic-rose);"><%= @counts[:failed] %> failed</span>
    <% end %>
    <% if @counts[:running].positive? %>
      <span class="ic-chip" style="color: var(--ic-emerald);"><%= @counts[:running] %> running</span>
    <% end %>
    <span class="ic-chip" style="color: var(--ic-emerald);"><%= @counts[:proof_verified] %> proof verified</span>
    <% if @counts[:proof_unavailable].positive? %>
      <span class="ic-chip"><%= @counts[:proof_unavailable] %> proof unavailable</span>
    <% end %>
    <span class="ic-runs-strip__window">Most recent <%= @counts[:total] %> run<%= 's' if @counts[:total] != 1 %><%= ' · demo data' if demo_mode? %></span>
  </div>

  <%# ── Filters (server-rendered query params) ───────────────────────── %>
  <div class="ic-filters" role="tablist" aria-label="Filter runs">
    <% [['all', 'All', @counts[:total]],
        ['failed', 'Failed', @counts[:failed]],
        ['attention', 'Needs attention', @counts[:attention]],
        ['proof_unavailable', 'Proof unavailable', @counts[:proof_unavailable]]].each do |slug, label, n| %>
      <%= link_to runs_path(filter: slug),
            class: "ic-filter #{'is-active' if @filter == slug}",
            role: 'tab', 'aria-selected': (@filter == slug).to_s do %>
        <%= label %><span class="ic-filter__n"><%= n %></span>
      <% end %>
    <% end %>
  </div>

  <%# ── Run Activity Map — at-a-glance map of recent runs over time ─────
      Each dot is one loaded run; its band/tone show the outcome. The map
      reflects the same filtered window as the list below it. ──────────── %>
  <section class="ic-runmap" aria-label="Run Activity Map">
    <div class="ic-runmap__head">
      <div class="ic-runmap__heading">
        <span class="ic-runmap__title">Run Activity Map</span>
        <span class="ic-runmap__sub">Each dot is one action run. Open a run to inspect policy, recovery, proof, and step evidence.</span>
      </div>
      <% if demo_mode? %>
        <span class="ic-runmap__demo">Demo data — sample run activity</span>
      <% end %>
    </div>

    <% if @all_runs.empty? %>
      <div class="ic-runmap__empty">
        <div class="ic-runmap__empty-title">No run activity yet</div>
        <p class="ic-runmap__empty-sub">Run activity appears after an agent or app calls an Igris action endpoint.</p>
        <div class="ic-runmap__empty-cta">
          <%= link_to 'Create action', new_action_path, class: 'ic-btn ic-btn--accent' %>
          <%= link_to 'Open Actions', actions_path, class: 'ic-btn' %>
        </div>
      </div>
    <% elsif @runs.empty? %>
      <p class="ic-runmap__note">No runs in the loaded window match “<%= @filter.tr('_', ' ') %>”.</p>
    <% else %>
      <% points = run_activity_points(@runs); n = points.size %>
      <ul class="ic-runmap__legend">
        <% RUN_ACTIVITY_BANDS.each do |b| %>
          <li class="ic-runmap__leg">
            <span class="ic-runmap__leg-dot ic-runmap__dot--<%= b[:key] %>"></span><%= b[:label] %>
          </li>
        <% end %>
      </ul>
      <div class="ic-runmap__scroll">
        <div class="ic-runmap__grid"
             style="grid-template-columns: minmax(72px, max-content) repeat(<%= n %>, 13px);">
          <% RUN_ACTIVITY_BANDS.each_with_index do |b, ri| %>
            <span class="ic-runmap__band" style="grid-column: 1; grid-row: <%= ri + 1 %>;"><%= b[:label] %></span>
            <i class="ic-runmap__lane" style="grid-column: 2 / -1; grid-row: <%= ri + 1 %>;" aria-hidden="true"></i>
          <% end %>
          <% points.each do |pt| %>
            <%= link_to run_path(pt[:run][:id]),
                  class: "ic-runmap__dot ic-runmap__dot--#{pt[:band]}",
                  style: "grid-column: #{pt[:col]}; grid-row: #{pt[:row]};",
                  title: pt[:aria], 'aria-label': pt[:aria] do %><% end %>
          <% end %>
        </div>
      </div>
      <div class="ic-runmap__axis">
        <span><%= time_ago(points.first[:run][:started_at]) %></span>
        <span class="ic-runmap__axis-mid">Showing latest <%= n %> run<%= 's' if n != 1 %></span>
        <span><%= time_ago(points.last[:run][:started_at]) %></span>
      </div>
    <% end %>
  </section>

  <div class="ic-body ic-scroll">
    <% if @runs.empty? %>
      <% if @filter == 'all' %>
        <div class="ic-empty" style="padding: 48px 16px;">
          <div class="ic-empty__title">No runs yet</div>
          <p class="ic-empty__sub">
            Runs appear when an agent or app calls an Igris action endpoint.
          </p>
          <div style="display: flex; gap: 8px; justify-content: center; flex-wrap: wrap;">
            <%= link_to 'Create action', new_action_path, class: 'ic-btn ic-btn--accent' %>
            <%= link_to 'Open Actions', actions_path, class: 'ic-btn' %>
          </div>
        </div>
      <% else %>
        <div class="ic-empty" style="padding: 40px 16px;">
          <div class="ic-empty__title">Nothing matches this filter</div>
          <p class="ic-empty__sub">No runs in the loaded window match “<%= @filter.tr('_', ' ') %>”.</p>
          <%= link_to 'Show all runs', runs_path, class: 'ic-btn' %>
        </div>
      <% end %>
    <% else %>
      <div class="ic-runs-list">
        <% @runs.each do |r| %>
          <% tone = run_tone(r)
             attn = run_needs_attention?(r)
             action_known = @action_names.include?(r[:action].to_s)
             via_runtime = data_source.run_through_runtime?(r)
             offer_runtime = via_runtime && !@any_healthy_runtime %>
          <div class="ic-run-row <%= 'ic-run-row--attn' if attn %>">
            <%= link_to run_path(r[:id]), class: 'ic-run-row__open' do %>
              <span class="ic-run-row__dot ic-run-row__dot--<%= tone %> <%= 'ic-live-dot' if tone == 'running' %>"></span>
              <span class="ic-run-row__status ic-run-row__status--<%= tone %>">
                <%= tone == 'running' ? 'Running' : (tone == 'failed' ? 'Failed' : 'OK') %>
              </span>
              <span class="ic-run-row__title">
                <span class="mono"><%= r[:id] %></span>
                <%= r[:action] %>
              </span>
              <span class="ic-run-row__sub">
                <span class="mono"><%= r[:routed_via] %></span>
              </span>
              <span class="ic-run-row__sub">
                <%= r[:proof] %>
                <% if r[:recovery].present? && r[:recovery] != 'Not needed' %>
                  · <%= r[:recovery] %>
                <% end %>
              </span>
              <span class="ic-run-row__time">
                <%= r[:duration_ms] ? "#{r[:duration_ms]}ms" : '· · ·' %><br>
                <span style="color: var(--ic-text-7);"><%= time_ago(r[:started_at]) %></span>
              </span>
            <% end %>
            <div class="ic-run-row__actions">
              <%= link_to 'Open run', run_path(r[:id]), class: 'ic-run-row__act' %>
              <% if action_known %>
                <%= link_to 'Open action', action_path(r[:action]), class: 'ic-run-row__act' %>
              <% end %>
              <% if offer_runtime %>
                <%= link_to 'Connect runtime', runtimes_path, class: 'ic-run-row__act ic-run-row__act--accent' %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
