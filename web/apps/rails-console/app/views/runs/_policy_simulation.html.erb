<%#
  Policy Simulation — a read-only, deterministic preview of how a proposed
  policy rule would have classified recent execution records. Igris (Go) owns
  the computation: it mutates no policy, replays nothing, dispatches nothing,
  and reads only execution truth (never prompts or model output). This card only
  collects bounded inputs and renders the safe response. `simulation` is the
  normalized result hash (nil until the operator runs a preview); `range` is the
  Intelligence tab's selected window, preserved across the form submit.
%>
<style>
  .ic-polsim { margin-top: 20px; }
  .ic-polsim__intro { color: var(--ic-text-5); font-size: 12px; margin: 4px 0 14px; max-width: 70ch; }
  .ic-polsim__form { display: flex; flex-wrap: wrap; gap: 10px 14px; align-items: flex-end; }
  .ic-polsim__field { display: flex; flex-direction: column; gap: 4px; }
  .ic-polsim__label { font-size: 11px; color: var(--ic-text-6); }
  .ic-polsim__field select, .ic-polsim__field input[type="text"] {
    height: 30px; padding: 0 8px; font-size: 12px; color: var(--ic-text-3);
    background: var(--ic-bg); border: 1px solid var(--ic-border); border-radius: 6px;
  }
  .ic-polsim__checks { display: flex; flex-wrap: wrap; gap: 6px 16px; align-items: center; }
  .ic-polsim__check { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; color: var(--ic-text-4); }
  .ic-polsim__counts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin: 16px 0; }
  .ic-polsim__count { border: 1px solid var(--ic-border); border-radius: 8px; padding: 12px 14px; }
  .ic-polsim__count-k { font-size: 11px; color: var(--ic-text-6); }
  .ic-polsim__count-v { font-size: 22px; font-weight: 600; margin-top: 2px; }
  .ic-polsim__count-v.is-allow { color: rgb(52, 211, 153); }
  .ic-polsim__count-v.is-approval { color: rgb(245, 197, 66); }
  .ic-polsim__count-v.is-block { color: rgb(244, 113, 113); }
  .ic-polsim__count-sub { font-size: 11px; color: var(--ic-text-6); margin-top: 2px; }
  .ic-polsim__cols { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-top: 10px; }
  .ic-polsim__col-h { font-size: 11px; color: var(--ic-text-6); margin-bottom: 6px; }
  .ic-polsim__rows { display: flex; flex-direction: column; gap: 4px; }
  .ic-polsim__row { display: flex; justify-content: space-between; gap: 10px; font-size: 12px; color: var(--ic-text-3); }
  .ic-polsim__row-n { color: var(--ic-text-5); }
  .ic-polsim__samples { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px; }
  .ic-polsim__warn { margin-top: 12px; font-size: 12px; color: rgb(245, 197, 66); }
  .ic-polsim__notice { margin-top: 12px; font-size: 12px; color: var(--ic-text-5); }
  @media (max-width: 760px) {
    .ic-polsim__counts { grid-template-columns: 1fr; }
    .ic-polsim__cols { grid-template-columns: 1fr; }
  }
</style>

<div class="ic-evidence ic-polsim">
  <div class="ic-evidence__head">Policy simulation</div>
  <p class="ic-polsim__intro">
    Preview how a proposed policy rule would have classified recent runs before you change anything.
    This is read-only: nothing is replayed, dispatched, or modified, and no policy is changed.
  </p>

  <%# GET form — bounded, shareable, and side-effect-free. The Intelligence range
      is preserved so submitting the preview keeps the active tab/window. %>
  <%= form_with url: runs_path, method: :get, local: true, class: 'ic-polsim__form' do %>
    <%= hidden_field_tag :view, 'intelligence' %>
    <%= hidden_field_tag :range, range %>
    <%= hidden_field_tag :simulate, '1' %>

    <div class="ic-polsim__field">
      <label class="ic-polsim__label" for="sim_range">Window</label>
      <%= select_tag :sim_range,
            options_for_select(RunsController::POLICY_SIM_RANGES.map { |v, l| [l, v] }, params[:sim_range].presence || '30d'),
            id: 'sim_range' %>
    </div>

    <div class="ic-polsim__field">
      <label class="ic-polsim__label" for="sim_mode">If matched, runs…</label>
      <%= select_tag :sim_mode,
            options_for_select(RunsController::POLICY_SIM_MODES.map { |v, l| [l, v] }, params[:sim_mode].presence || 'require_approval'),
            id: 'sim_mode' %>
    </div>

    <div class="ic-polsim__field">
      <label class="ic-polsim__label" for="sim_match_kind">Action match</label>
      <%= select_tag :sim_match_kind,
            options_for_select(RunsController::POLICY_SIM_MATCH_KINDS.map { |v, l| [l, v] }, params[:sim_match_kind].presence || 'match_action_prefix'),
            id: 'sim_match_kind' %>
    </div>

    <div class="ic-polsim__field">
      <label class="ic-polsim__label" for="sim_match_value">Action value</label>
      <%= text_field_tag :sim_match_value, params[:sim_match_value], id: 'sim_match_value',
            placeholder: 'e.g. stripe.refund', maxlength: 256, autocomplete: 'off' %>
    </div>

    <div class="ic-polsim__field">
      <label class="ic-polsim__label" for="sim_status">Result status</label>
      <%= select_tag :sim_status,
            options_for_select([['Any', '']] + RunsController::POLICY_SIM_STATUSES.map { |s| [s.tr('_', ' '), s] }, params[:sim_status].to_s),
            id: 'sim_status' %>
    </div>

    <div class="ic-polsim__field">
      <span class="ic-polsim__label">Also require</span>
      <div class="ic-polsim__checks">
        <label class="ic-polsim__check"><%= check_box_tag :sim_proof_missing, '1', params[:sim_proof_missing].present? %> Proof missing</label>
        <label class="ic-polsim__check"><%= check_box_tag :sim_recovery, '1', params[:sim_recovery].present? %> Recovery occurred</label>
        <label class="ic-polsim__check"><%= check_box_tag :sim_eval_failed, '1', params[:sim_eval_failed].present? %> Evaluation failed</label>
      </div>
    </div>

    <div class="ic-polsim__field">
      <span class="ic-polsim__label">&nbsp;</span>
      <%= submit_tag 'Run preview', class: 'ic-btn ic-btn--accent', name: nil %>
    </div>
  <% end %>

  <% if simulation %>
    <% case simulation[:state] %>
    <% when :unavailable %>
      <p class="ic-polsim__notice">
        The simulation service is unavailable right now, so no preview could be computed. The banner above carries the safe error detail. Nothing was changed.
      </p>
    <% when :empty %>
      <p class="ic-polsim__notice">
        No execution records were found in the selected window, so there is nothing to preview yet. Once agents execute actions in this window, the impact preview appears here.
      </p>
    <% else %>
      <div class="ic-polsim__counts">
        <div class="ic-polsim__count">
          <div class="ic-polsim__count-k">Would allow</div>
          <div class="ic-polsim__count-v is-allow"><%= number_with_delimiter(simulation[:would_allow]) %></div>
          <div class="ic-polsim__count-sub">unchanged by this rule</div>
        </div>
        <div class="ic-polsim__count">
          <div class="ic-polsim__count-k">Would require approval</div>
          <div class="ic-polsim__count-v is-approval"><%= number_with_delimiter(simulation[:would_require_approval]) %></div>
          <div class="ic-polsim__count-sub">paused for a human reviewer</div>
        </div>
        <div class="ic-polsim__count">
          <div class="ic-polsim__count-k">Would block</div>
          <div class="ic-polsim__count-v is-block"><%= number_with_delimiter(simulation[:would_block]) %></div>
          <div class="ic-polsim__count-sub">stopped before execution</div>
        </div>
      </div>

      <p class="ic-polsim__count-sub">
        <%= number_with_delimiter(simulation[:affected_run_count]) %> of
        <%= number_with_delimiter(simulation[:total_runs_considered]) %> runs in the last
        <%= RunsController::POLICY_SIM_RANGES[simulation[:range]] || simulation[:range] %> would be affected.
      </p>

      <div class="ic-polsim__cols">
        <div>
          <div class="ic-polsim__col-h">Most affected agents</div>
          <% if simulation[:affected_agents].any? %>
            <div class="ic-polsim__rows">
              <% simulation[:affected_agents].first(8).each do |a| %>
                <div class="ic-polsim__row">
                  <span><%= a[:name] %></span>
                  <span class="ic-polsim__row-n"><%= number_with_delimiter(a[:run_count]) %></span>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="ic-polsim__row-n">No attributed agents affected.</div>
          <% end %>
        </div>
        <div>
          <div class="ic-polsim__col-h">Most affected actions</div>
          <% if simulation[:affected_actions].any? %>
            <div class="ic-polsim__rows">
              <% simulation[:affected_actions].first(8).each do |a| %>
                <div class="ic-polsim__row">
                  <span><%= a[:name] %></span>
                  <span class="ic-polsim__row-n"><%= number_with_delimiter(a[:run_count]) %></span>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="ic-polsim__row-n">No actions affected.</div>
          <% end %>
        </div>
      </div>

      <% if simulation[:sample_runs].any? %>
        <div class="ic-polsim__col-h" style="margin-top: 14px;">Sample affected runs</div>
        <div class="ic-polsim__samples">
          <% simulation[:sample_runs].first(12).each do |s| %>
            <%= link_to run_path(s[:task_id]), class: 'ic-chip ic-chip--sm' do %>
              <%= s[:task_id] %> · <%= s[:status] %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    <% end %>

    <%# Turn this preview into a saved, reviewable proposal. The criteria that
        were just simulated are carried over so the draft opens prefilled. This
        only navigates to the proposal form — it creates nothing by itself. %>
    <% unless simulation[:state] == :unavailable %>
      <% req = simulation[:requested] || {} %>
      <% crit = req[:criteria] || {} %>
      <% match_kind = %i[match_action_name match_action_prefix match_agent_id match_agent_type].find { |k| crit[k].present? } %>
      <div class="ic-polsim__samples" style="margin-top: 14px;">
        <%= link_to 'Save as proposal', new_proposal_path(
              range: req[:range], policy_mode: req[:policy_mode],
              match_kind: match_kind, match_value: (match_kind ? crit[match_kind] : nil),
              match_result_status: crit[:match_result_status],
              require_proof_missing: crit[:require_proof_missing],
              require_recovery_occurred: crit[:require_recovery_occurred],
              require_eval_failed: crit[:require_eval_failed]
            ), class: 'ic-btn ic-btn--accent' %>
        <%= link_to 'View proposals', proposals_path, class: 'ic-btn' %>
      </div>
    <% end %>

    <% simulation[:warnings].each do |w| %>
      <p class="ic-polsim__warn"><%= w %></p>
    <% end %>
  <% end %>
</div>
