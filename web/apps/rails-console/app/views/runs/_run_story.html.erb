<%#
  Run Story — the six-beat narrative of a run for an operator:
  Agent → Action → Decision → Evidence → Outcome → Proof.

  Reads only already-safe data: the normalized run fields and the first
  Evidence Memory summary (operator-only — never prompts, chain-of-thought,
  tokens, or raw bodies). Beats with no recorded fact read "Not recorded"
  rather than inventing a value. `run` is the normalized run; `memory` is the
  Evidence Memory array for the run (may be empty).
%>
<div class="ic-evidence ic-runstory" id="run-story">
  <div class="ic-evidence__head">Run story</div>
  <p class="ic-evidence__intro">
    Why this agent acted and what came of it, reconstructed from execution
    truth and the run's persisted Evidence Memory. Summaries only; no prompts
    or private reasoning are stored or shown.
  </p>

  <dl class="ic-runstory__beats">
    <% run_story(run, memory).each do |beat| %>
      <div class="ic-runstory__beat">
        <dt class="ic-runstory__label"><%= beat[:label] %></dt>
        <dd class="ic-runstory__value <%= 'is-muted' if beat[:tone] == :muted %>">
          <% if beat[:items].present? %>
            <ul class="ic-runstory__items">
              <% beat[:items].each do |item| %>
                <li class="ic-runstory__item"><%= item %></li>
              <% end %>
            </ul>
          <% elsif beat[:key] == :proof %>
            <%= status_text beat[:value] %>
          <% elsif beat[:key] == :action %>
            <span class="mono"><%= beat[:value] %></span>
          <% else %>
            <%= beat[:value] %>
          <% end %>
        </dd>
      </div>
    <% end %>
  </dl>
</div>
