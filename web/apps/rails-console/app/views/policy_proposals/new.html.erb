<%= render 'shared/runs_header_style' %>
<div class="igris-console" style="display: flex; flex-direction: column; flex: 1; min-height: 0;">
  <div class="ic-runs-header">
    <%= render 'shared/runs_view_tabs', active: 'proposals' %>
    <div class="ic-runs-header__actions">
      <%= project_chip %>
      <%= link_to 'All proposals', proposals_path, class: 'ic-btn' %>
    </div>
  </div>

  <%= render 'shared/flash', degraded_error: @degraded_error %>

  <div class="ic-body ic-scroll ic-doc" style="padding: 18px 16px; max-width: 760px; width: 100%; margin: 0 auto;">
    <div class="ic-evidence" style="margin-bottom: 14px;">
      <div class="ic-evidence__head">New policy proposal</div>
      <p class="ic-evidence__intro">Draft a policy change. You can simulate its impact and review it before anything affects production.</p>
    </div>
    <%= render 'form', proposal: @proposal, errors: @errors,
          url: proposals_path, method: :post, submit_label: 'Save as draft' %>
  </div>
</div>
