<%#
  Policy proposal detail — the governance workspace for one draft rule. Shows the
  proposed rule in plain language, its lifecycle controls (simulate / mark ready /
  approve / edit / archive), the latest simulated impact, and an audit timeline.
  Everything rendered is safe metadata; no raw JSON is the primary interface.
%>
<%= render 'shared/runs_header_style' %>
<style>
  .ic-prop-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .ic-prop-title { font-size: 16px; font-weight: 650; color: var(--ic-text-bright); }
  .ic-prop-meta { margin-top: 4px; display: flex; gap: 8px; align-items: center; flex-wrap: wrap; font-size: 12px; color: var(--ic-text-5); }
  .ic-status { display: inline-block; font-size: 11px; padding: 2px 8px; border-radius: 999px; border: 1px solid var(--ic-border); color: var(--ic-text-4); }
  .ic-prop-actions { display: inline-flex; gap: 8px; flex-wrap: wrap; }
  .ic-prop-actions form { display: inline; margin: 0; }
  .ic-prop-crit { display: flex; flex-direction: column; gap: 6px; }
  .ic-prop-crit__row { display: flex; gap: 8px; font-size: 12.5px; color: var(--ic-text-3); }
  .ic-prop-crit__k { color: var(--ic-text-6); min-width: 130px; }
  .ic-prop-events { display: flex; flex-direction: column; gap: 0; }
  .ic-prop-event { display: grid; grid-template-columns: 150px 1fr 130px; gap: 12px; padding: 8px 0; border-bottom: 1px solid var(--ic-border-soft); font-size: 12px; }
  .ic-prop-event__type { color: var(--ic-text-5); }
  .ic-prop-event__sum { color: var(--ic-text-3); }
  .ic-prop-event__at { color: var(--ic-text-6); text-align: right; }

  /* Shared simulation-summary styles (mirrors the Policy Simulation card). */
  .ic-polsim__intro { color: var(--ic-text-5); font-size: 12px; margin: 4px 0 14px; max-width: 70ch; }
  .ic-polsim__counts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin: 14px 0; }
  .ic-polsim__count { border: 1px solid var(--ic-border); border-radius: 8px; padding: 12px 14px; }
  .ic-polsim__count-k { font-size: 11px; color: var(--ic-text-6); }
  .ic-polsim__count-v { font-size: 22px; font-weight: 600; margin-top: 2px; color: var(--ic-text-bright); }
  .ic-polsim__count-sub { font-size: 11px; color: var(--ic-text-6); margin-top: 2px; }
  .ic-polsim__cols { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-top: 10px; }
  .ic-polsim__col-h { font-size: 11px; color: var(--ic-text-6); margin-bottom: 6px; }
  .ic-polsim__rows { display: flex; flex-direction: column; gap: 4px; }
  .ic-polsim__row { display: flex; justify-content: space-between; gap: 10px; font-size: 12px; color: var(--ic-text-3); }
  .ic-polsim__row-n { color: var(--ic-text-5); }
  .ic-polsim__samples { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px; }
  .ic-polsim__warn { margin-top: 12px; font-size: 12px; color: rgb(245, 197, 66); }
  .ic-polsim__notice { margin-top: 6px; font-size: 12px; color: var(--ic-text-5); }
  .ic-prop-row__desc { font-size: 11.5px; color: var(--ic-text-5); }
  @media (max-width: 760px) {
    .ic-polsim__counts { grid-template-columns: 1fr; }
    .ic-polsim__cols { grid-template-columns: 1fr; }
  }
</style>

<div class="igris-console" style="display: flex; flex-direction: column; flex: 1; min-height: 0;">
  <div class="ic-runs-header">
    <%= render 'shared/runs_view_tabs', active: 'proposals' %>
    <div class="ic-runs-header__actions">
      <%= project_chip %>
      <%= link_to 'All proposals', proposals_path, class: 'ic-btn' %>
    </div>
  </div>

  <%= render 'shared/flash', degraded_error: @degraded_error %>

  <div class="ic-body ic-scroll ic-doc" style="padding: 18px 16px; max-width: 820px; width: 100%; margin: 0 auto;">
    <% c = @proposal[:match_criteria] || {} %>

    <div class="ic-evidence" style="margin-bottom: 14px;">
      <div class="ic-prop-head">
        <div>
          <div class="ic-prop-title"><%= @proposal[:name].presence || 'Untitled proposal' %></div>
          <div class="ic-prop-meta">
            <span class="ic-status is-<%= @proposal[:status] %>"><%= @proposal[:status_label] %></span>
            <span><%= @proposal[:policy_mode_label] %></span>
            <span>Updated <%= time_ago(@proposal[:updated_at]) %></span>
          </div>
        </div>

        <div class="ic-prop-actions">
          <%= button_to 'Re-simulate', simulate_proposal_path(@proposal[:id]), method: :post, class: 'ic-btn' unless @proposal[:status] == 'archived' %>
          <% if @proposal[:editable] %>
            <%= link_to 'Edit', edit_proposal_path(@proposal[:id]), class: 'ic-btn' %>
          <% end %>
          <% if @proposal[:can_mark_ready] %>
            <%= button_to 'Mark ready for review', ready_proposal_path(@proposal[:id]), method: :post, params: { to: 'review_ready' }, class: 'ic-btn' %>
          <% end %>
          <% if @proposal[:can_unmark_ready] %>
            <%= button_to 'Move back to draft', ready_proposal_path(@proposal[:id]), method: :post, params: { to: 'draft' }, class: 'ic-btn' %>
          <% end %>
          <% if @proposal[:can_approve] %>
            <%= button_to 'Approve', approve_proposal_path(@proposal[:id]), method: :post, class: 'ic-btn ic-btn--accent' %>
          <% end %>
          <% unless @proposal[:status] == 'archived' %>
            <%= button_to 'Archive', proposal_path(@proposal[:id]), method: :delete, class: 'ic-btn',
                  form: { data: { turbo_confirm: 'Archive this proposal?' } },
                  data: { confirm: 'Archive this proposal?' } %>
          <% end %>
        </div>
      </div>

      <% if @proposal[:description].present? %>
        <p class="ic-evidence__intro" style="margin-top: 10px;"><%= @proposal[:description] %></p>
      <% end %>

      <% if @proposal[:status] == 'approved' %>
        <p class="ic-polsim__notice" style="margin-top: 10px;">
          Approved as a governance decision. This does <strong>not</strong> change active policy. Promotion to live
          policy is a separate, deliberate step that is not performed here.
        </p>
      <% end %>
    </div>

    <%# The proposed rule, in plain language — never raw JSON. %>
    <div class="ic-evidence" style="margin-bottom: 14px;">
      <div class="ic-evidence__head">Proposed rule</div>
      <div class="ic-prop-crit" style="margin-top: 8px;">
        <div class="ic-prop-crit__row"><span class="ic-prop-crit__k">If matched, runs</span><span><%= @proposal[:policy_mode_label].downcase %></span></div>
        <div class="ic-prop-crit__row"><span class="ic-prop-crit__k">Window</span><span><%= PolicyProposalsController::RANGES[c[:range]] || c[:range] %></span></div>
        <% if c[:match_action_name].present? %>
          <div class="ic-prop-crit__row"><span class="ic-prop-crit__k">Action name is</span><span><%= c[:match_action_name] %></span></div>
        <% end %>
        <% if c[:match_action_prefix].present? %>
          <div class="ic-prop-crit__row"><span class="ic-prop-crit__k">Action starts with</span><span><%= c[:match_action_prefix] %></span></div>
        <% end %>
        <% if c[:match_agent_id].present? %>
          <div class="ic-prop-crit__row"><span class="ic-prop-crit__k">Agent ID is</span><span><%= c[:match_agent_id] %></span></div>
        <% end %>
        <% if c[:match_agent_type].present? %>
          <div class="ic-prop-crit__row"><span class="ic-prop-crit__k">Agent type is</span><span><%= c[:match_agent_type] %></span></div>
        <% end %>
        <% if c[:match_result_status].present? %>
          <div class="ic-prop-crit__row"><span class="ic-prop-crit__k">Result status is</span><span><%= c[:match_result_status].tr('_', ' ') %></span></div>
        <% end %>
        <% extra = [
             ('proof is missing' if c[:require_proof_missing]),
             ('recovery occurred' if c[:require_recovery_occurred]),
             ('an evaluation failed' if c[:require_eval_failed]),
           ].compact %>
        <% if extra.any? %>
          <div class="ic-prop-crit__row"><span class="ic-prop-crit__k">Also require</span><span><%= extra.join(', ') %></span></div>
        <% end %>
      </div>
    </div>

    <%= render 'simulation_summary', simulation: @proposal[:last_simulation] %>

    <%# Governance audit timeline — safe summaries only. %>
    <div class="ic-evidence" style="margin-top: 14px;">
      <div class="ic-evidence__head">Activity</div>
      <% events = Array(@proposal[:events]) %>
      <% if events.any? %>
        <div class="ic-prop-events" style="margin-top: 6px;">
          <% events.each do |ev| %>
            <div class="ic-prop-event">
              <span class="ic-prop-event__type"><%= ev[:type].to_s.tr('_', ' ') %></span>
              <span class="ic-prop-event__sum"><%= ev[:summary] %></span>
              <span class="ic-prop-event__at"><%= time_ago(ev[:created_at]) %></span>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="ic-polsim__notice">No activity recorded yet.</p>
      <% end %>
    </div>
  </div>
</div>
