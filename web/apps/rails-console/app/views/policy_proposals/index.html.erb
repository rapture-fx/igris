<%#
  Policy proposals — a plain explanatory list under the Runs lens (no invented
  cards). Each row links to the proposal's detail page. Source of truth is Go
  Overture; Rails only presents safe metadata, never raw JSON or secrets.
%>
<%= render 'shared/runs_header_style' %>
<style>
  .ic-prop-list { border-top: 1px solid var(--ic-border-soft); }
  .ic-prop-row {
    display: grid; grid-template-columns: minmax(0, 1.7fr) 130px 120px minmax(0, 1.1fr) 96px;
    align-items: baseline; gap: 14px; padding: 12px 4px;
    border-bottom: 1px solid var(--ic-border-soft); text-decoration: none; color: inherit;
  }
  .ic-prop-row:hover { background: var(--ic-overlay-bg); }
  .ic-prop-row__name { font-size: 13px; font-weight: 600; color: var(--ic-text-bright); }
  .ic-prop-row__desc { margin-top: 2px; font-size: 11.5px; color: var(--ic-text-5); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ic-prop-row__cell { font-size: 12px; color: var(--ic-text-5); min-width: 0; }
  .ic-prop-impact { font-size: 11.5px; color: var(--ic-text-5); }
  .ic-prop-impact b { color: var(--ic-text-bright); font-weight: 600; }
  .ic-status {
    display: inline-block; font-size: 11px; padding: 2px 8px; border-radius: 999px;
    border: 1px solid var(--ic-border); color: var(--ic-text-4);
  }
  @media (max-width: 860px) {
    .ic-prop-row { grid-template-columns: minmax(0, 1.7fr) 120px 96px; }
    .ic-prop-row__cell--impact, .ic-prop-row__cell--updated { display: none; }
  }
</style>

<div class="igris-console" style="display: flex; flex-direction: column; flex: 1; min-height: 0;">
  <div class="ic-runs-header">
    <%= render 'shared/runs_view_tabs', active: 'proposals' %>
    <div class="ic-runs-header__actions">
      <%= project_chip %>
      <%= link_to 'New proposal', new_proposal_path, class: 'ic-btn ic-btn--accent' %>
    </div>
  </div>

  <%= render 'shared/flash', degraded_error: @degraded_error %>

  <div class="ic-body ic-scroll ic-doc" style="padding: 18px 16px; max-width: 860px; width: 100%; margin: 0 auto;">
    <div class="ic-evidence" style="margin-bottom: 14px;">
      <div class="ic-evidence__head">Policy proposals</div>
      <p class="ic-evidence__intro">
        Draft a policy change, simulate its impact over recorded runs, review it, and approve it,
        all before it ever affects production. Approval is a governance decision only: nothing here
        changes active policy, replays runs, or dispatches tasks. This is the Govern surface for
        findings that start in Intelligence or Trust recommendations.
      </p>
    </div>

    <% if @filter_action.present? || @filter_agent.present? %>
      <div class="ic-scopebar" style="margin-bottom: 12px;">
        <span class="ic-scopebar__label"><%= @filter_action.present? ? 'Proposals matching action' : 'Proposals matching agent' %></span>
        <span class="ic-scopebar__value mono"><%= @filter_action.presence || @filter_agent %></span>
        <%= link_to 'Clear', proposals_path, class: 'ic-scopebar__clear' %>
      </div>
      <style>
        .ic-scopebar { display: flex; align-items: center; gap: 10px; font-size: 12px; }
        .ic-scopebar__label { color: var(--ic-text-6); }
        .ic-scopebar__value { color: var(--ic-text-bright); }
        .ic-scopebar__clear { margin-left: auto; color: var(--ic-text-5); text-decoration: none; }
        .ic-scopebar__clear:hover { color: var(--ic-text-bright); text-decoration: underline; }
      </style>
    <% end %>

    <% if @proposals.blank? %>
      <div class="ic-evidence">
        <% if @filter_action.present? || @filter_agent.present? %>
          <div class="ic-evidence__head">No proposals match this filter</div>
          <p class="ic-doc__note">
            No proposal's match criteria target <%= @filter_action.present? ? 'this action' : 'this agent' %> yet.
            <%= link_to 'View all proposals', proposals_path, class: 'ic-doc__link' %> or create one below.
          </p>
        <% else %>
          <div class="ic-evidence__head">No proposals yet</div>
          <p class="ic-doc__note">
            A proposal captures a policy rule you want to evaluate. For example, “require approval for
            actions starting with stripe.refund”. Save it as a draft, re-simulate it over recent runs to
            see how many would be affected, then mark it ready for review and approve it. You can also start
            one straight from the <%= link_to 'Policy simulation', runs_path(view: 'intelligence'), class: 'ic-doc__link' %> card.
          </p>
        <% end %>
        <p style="margin-top: 12px;">
          <%= link_to 'Create your first proposal', new_proposal_path, class: 'ic-btn ic-btn--accent' %>
        </p>
      </div>
    <% else %>
      <div class="ic-prop-list">
        <% @proposals.each do |proposal| %>
          <%= link_to proposal_path(proposal[:id]), class: 'ic-prop-row' do %>
            <div>
              <div class="ic-prop-row__name"><%= proposal[:name].presence || 'Untitled proposal' %></div>
              <% if proposal[:description].present? %>
                <div class="ic-prop-row__desc"><%= proposal[:description] %></div>
              <% end %>
            </div>
            <div class="ic-prop-row__cell">
              <span class="ic-status is-<%= proposal[:status] %>"><%= proposal[:status_label] %></span>
            </div>
            <div class="ic-prop-row__cell"><%= proposal[:policy_mode_label] %></div>
            <div class="ic-prop-row__cell ic-prop-row__cell--impact">
              <% if (sim = proposal[:last_simulation]) %>
                <div class="ic-prop-impact">
                  <% if proposal[:policy_mode] == 'block' %>
                    <b><%= number_with_delimiter(sim[:affected_run_count]) %></b> affected, <b><%= number_with_delimiter(sim[:would_block]) %></b> blocked
                  <% else %>
                    <b><%= number_with_delimiter(sim[:affected_run_count]) %></b> affected, <b><%= number_with_delimiter(sim[:would_require_approval]) %></b> gated
                  <% end %>
                </div>
                <div class="ic-prop-row__desc">Simulated <%= time_ago(sim[:simulated_at]) %></div>
              <% else %>
                <span class="ic-prop-impact">Not simulated yet</span>
              <% end %>
            </div>
            <div class="ic-prop-row__cell ic-prop-row__cell--updated"><%= time_ago(proposal[:updated_at]) %></div>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
