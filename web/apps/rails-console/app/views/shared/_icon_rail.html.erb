<%#
  Collapsible sidebar — replaces the icon rail.
  Collapsed: 48px icon-only rail.
  Expanded: ~212px shows icon + label, toggle button, search bar.
%>
<nav class="ic-rail" id="ic-rail" aria-label="Console navigation">
  <%# Top row: logo + title + toggle %>
  <div class="ic-rail__top">
    <%= link_to home_path, class: 'ic-rail__logo', 'aria-label': 'Igris' do %>
      <%= image_tag '/inertia.png',     class: 'ic-rail__logo-img ic-rail__logo-img--light', alt: '' %>
      <%= image_tag '/fofotlight.png',  class: 'ic-rail__logo-img ic-rail__logo-img--dark',  alt: '' %>
    <% end %>
    <span class="ic-rail__title">Igris</span>
    <button type="button" class="ic-rail__toggle ic-rail__toggle--top" id="ic-rail-toggle" aria-label="Collapse sidebar">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
        <rect width="18" height="18" x="3" y="3" rx="2"/><path d="M9 3v18"/><path d="m14 9 3 3-3 3"/>
      </svg>
    </button>
  </div>

  <%# Search — icon when collapsed, full input when expanded %>
  <div class="ic-rail__search">
    <button type="button" class="ic-rail__search-btn" aria-label="Search">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
        <circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/>
      </svg>
    </button>
    <div class="ic-rail__search-input-wrap">
      <input type="search" class="ic-rail__search-input" placeholder="Search..." aria-label="Search" />
      <kbd class="ic-rail__search-hint"><%= RUBY_PLATFORM =~ /darwin/ ? '⌘' : 'Ctrl+' %>F</kbd>
    </div>
  </div>

  <%# Navigation items %>
  <div class="ic-rail__items">
    <% rail_items = [
      [:home,     home_path,     'Home',     'house'],
      [:overview, overview_path, 'Overview', 'layout-dashboard'],
      [:actions,  actions_path,  'Actions',  'list-checks'],
      [:agents,   agents_path,   'Agents',   'users'],
      [:runs,     runs_path,     'Runs',     'zap'],
      [:runtimes, runtimes_path, 'Runtimes', 'box'],
      [:settings, settings_path, 'Settings', 'settings'],
    ] %>
    <% rail_items.each do |id, path, label, icon| %>
      <%= link_to path,
          class: "ic-rail__btn #{'is-active' if active_lens?(id)}",
          'aria-label': label do %>
        <%= console_icon(icon, size: 18, stroke: 1.7) %>
        <span class="ic-rail__label"><%= label %></span>
      <% end %>
    <% end %>
  </div>

  <%# Bottom toggle — visible when collapsed %>
    <button type="button" class="ic-rail__toggle ic-rail__toggle--bottom" id="ic-rail-toggle-bottom" aria-label="Expand sidebar">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
        <rect width="18" height="18" x="3" y="3" rx="2"/><path d="M9 3v18"/><path d="m17 9-3 3 3 3"/>
      </svg>
    </button>

  <%# Profile — clickable dropdown %>
  <details class="ic-rail__avatar" data-tip="Account">
    <summary aria-label="Account menu">
      <%= image_tag '/emeralds.jpg', alt: '' %>
      <span class="ic-rail__avatar__dot"></span>
      <span class="ic-rail__avatar-name">Operator</span>
    </summary>
    <div class="ic-rail__menu" role="menu">
      <div class="ic-rail__menu__head">
        <span class="ic-rail__menu__name">Operator</span>
        <span class="ic-rail__menu__email">operator@igrisinertial.com</span>
      </div>

      <a href="https://igrisinertial.com/docs/api" target="_blank" rel="noopener" class="ic-rail__menu__item" role="menuitem">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m18 16 4-4-4-4"/><path d="m6 8-4 4 4 4"/><path d="m14.5 4-5 16"/></svg>
        <span>API reference</span>
        <svg class="ic-rail__menu__hint" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="width:11px;height:11px;color:var(--ic-text-7);"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
      </a>

      <a href="https://status.igrisinertial.com" target="_blank" rel="noopener" class="ic-rail__menu__item" role="menuitem">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.5.5 0 0 1-.96 0L9.24 2.18a.5.5 0 0 0-.96 0l-2.35 8.36A2 2 0 0 1 4 12H2"/></svg>
        <span>Status page</span>
        <span style="margin-left:auto;display:inline-flex;align-items:center;gap:5px;">
          <span style="width:5px;height:5px;border-radius:999px;background:var(--ic-emerald);"></span>
          <span style="font-size:10.5px;color:var(--ic-text-7);">all systems</span>
        </span>
      </a>

      <a href="mailto:support@igrisinertial.com" class="ic-rail__menu__item" role="menuitem">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
        <span>Support</span>
      </a>

      <a href="https://igrisinertial.com/docs" target="_blank" rel="noopener" class="ic-rail__menu__item" role="menuitem">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
        <span>Documentation</span>
      </a>

      <a href="https://igrisinertial.com/changelog" target="_blank" rel="noopener" class="ic-rail__menu__item" role="menuitem">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        <span>What's new</span>
      </a>

      <div class="ic-rail__menu__sep" role="separator"></div>

      <button type="button" class="ic-rail__menu__item" role="menuitemcheckbox" id="ic-theme-toggle" aria-checked="false">
        <svg class="ic-rail__menu__icon ic-rail__menu__icon--light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
        <svg class="ic-rail__menu__icon ic-rail__menu__icon--dark"  viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        <span id="ic-theme-toggle-label">Dark mode</span>
        <span class="ic-rail__menu__hint" id="ic-theme-toggle-state">off</span>
      </button>

      <div class="ic-rail__menu__sep" role="separator"></div>

      <button type="button" id="ic-signout" class="ic-rail__menu__item ic-rail__menu__item--danger" role="menuitem">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        <span>Sign out</span>
      </button>
    </div>
  </details>
</nav>

<%# Search overlay — compact centered input %>
<div class="ic-search-overlay" id="ic-search-overlay" role="dialog" aria-modal="true" aria-label="Search">
  <div class="ic-search-overlay__backdrop" id="ic-search-overlay-backdrop"></div>
  <div class="ic-search-overlay__panel">
    <svg class="ic-search-overlay__ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
      <circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/>
    </svg>
    <input type="search" class="ic-search-overlay__input" id="ic-search-overlay-input" placeholder="Search runs, actions, agents\u2026" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" aria-label="Search" />
    <kbd class="ic-search-overlay__hint">ESC</kbd>
  </div>
</div>

<style>
  .ic-search-overlay {
    position: fixed; inset: 0; z-index: 9999;
    display: flex; align-items: flex-start; justify-content: center;
    padding: 20vh 16px 0; pointer-events: none; opacity: 0;
    transition: opacity 120ms ease;
  }
  .ic-search-overlay.is-open { pointer-events: auto; opacity: 1; }
  .ic-search-overlay__backdrop {
    position: absolute; inset: 0; background: rgba(0,0,0,0.25);
  }
  html.dark .ic-search-overlay__backdrop { background: rgba(0,0,0,0.45); }
  .ic-search-overlay__panel {
    position: relative; display: flex; align-items: center; gap: 10px;
    width: 100%; max-width: 480px; height: 44px;
    background: var(--ic-bg); border: 1px solid var(--ic-border);
    border-radius: 10px; padding: 0 14px;
    box-shadow: 0 8px 24px -6px rgba(0,0,0,0.12);
    transform: translateY(-4px); transition: transform 120ms ease;
  }
  .is-open .ic-search-overlay__panel { transform: translateY(0); }
  .ic-search-overlay__ico { color: var(--ic-text-7); flex-shrink: 0; }
  .ic-search-overlay__input {
    flex: 1; min-width: 0; border: 0; outline: none; background: transparent;
    font-size: 14px; font-family: inherit; color: var(--ic-text); line-height: 1;
  }
  .ic-search-overlay__input::placeholder { color: var(--ic-text-7); }
  .ic-search-overlay__hint {
    font-family: var(--ic-mono); font-size: 10px; color: var(--ic-text-8);
    background: var(--ic-overlay-3); padding: 2px 5px; border-radius: 4px;
    border: 1px solid var(--ic-border-soft); flex-shrink: 0; line-height: 1;
  }
</style>

<script>
  (function() {
    var rail = document.getElementById('ic-rail');
    var toggle = document.getElementById('ic-rail-toggle');

    // Restore expanded state, but auto-collapse on run detail pages
    // (runs detail has its own mini sidebar, so the main rail should be collapsed)
    var isRunDetail = window.location.pathname.match(/^\/runs\/.+/);
    try {
      var saved = localStorage.getItem('ic-rail-expanded');
      if (saved === 'true' && !isRunDetail) rail.classList.add('ic-rail--expanded');
    } catch (e) {}

    function toggleRail(e) {
      e.stopPropagation();
      var isExpanded = rail.classList.toggle('ic-rail--expanded');
      try { localStorage.setItem('ic-rail-expanded', isExpanded ? 'true' : 'false'); } catch (e) {}
    }

    // Toggle on click — both top and bottom buttons
    if (toggle) toggle.addEventListener('click', toggleRail);
    var toggleBottom = document.getElementById('ic-rail-toggle-bottom');
    if (toggleBottom) toggleBottom.addEventListener('click', toggleRail);

    // Profile dropdown dismiss
    var details = document.querySelector('.ic-rail__avatar');
    if (details) {
      document.addEventListener('click', function(e) {
        if (!details.open) return;
        if (!details.contains(e.target)) details.open = false;
      });
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && details.open) details.open = false;
      });
    }

    // Theme toggle sync
    function syncToggle() {
      var dark = document.documentElement.classList.contains('dark');
      var state = document.getElementById('ic-theme-toggle-state');
      var btn = document.getElementById('ic-theme-toggle');
      if (state) state.textContent = dark ? 'on' : 'off';
      if (btn) btn.setAttribute('aria-checked', dark ? 'true' : 'false');
    }
    syncToggle();
    var themeBtn = document.getElementById('ic-theme-toggle');
    if (themeBtn) {
      themeBtn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        var dark = !document.documentElement.classList.contains('dark');
        document.documentElement.classList.toggle('dark', dark);
        try { localStorage.setItem('ic-theme', dark ? 'dark' : 'light'); } catch (e) {}
        syncToggle();
      });
    }

    // Sign out
    var signout = document.getElementById('ic-signout');
    if (signout) {
      signout.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        signout.disabled = true;
        fetch('/api/auth/sign-out', {
          method: 'POST',
          headers: { 'Accept': 'application/json' },
          credentials: 'same-origin'
        }).catch(function() {}).then(function() {
          window.location.assign('/home');
        });
      });
    }

    // Search overlay
    var searchOverlay = document.getElementById('ic-search-overlay');
    var searchBtn = document.querySelector('.ic-rail__search-btn');
    var searchInput = document.querySelector('.ic-rail__search-input');
    var overlayInput = document.getElementById('ic-search-overlay-input');
    var overlayBackdrop = document.getElementById('ic-search-overlay-backdrop');
    var searchActiveEl = null;

    function openSearch(e) {
      if (e) e.stopPropagation();
      searchActiveEl = document.activeElement;
      searchOverlay.classList.add('is-open');
      setTimeout(function() { overlayInput.focus(); }, 50);
    }

    function closeSearch() {
      searchOverlay.classList.remove('is-open');
      overlayInput.value = '';
      if (searchActiveEl && searchActiveEl.focus) {
        setTimeout(function() { searchActiveEl.focus(); }, 50);
      }
    }

    if (searchBtn) searchBtn.addEventListener('click', openSearch);
    if (searchInput) searchInput.addEventListener('focus', openSearch);

    if (overlayBackdrop) overlayBackdrop.addEventListener('click', closeSearch);

    if (overlayInput) {
      overlayInput.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') { e.preventDefault(); closeSearch(); }
      });
    }

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && searchOverlay.classList.contains('is-open')) {
        e.preventDefault();
        closeSearch();
      }
      // Cmd+K / Ctrl+K or Cmd+F / Ctrl+F to toggle search
      if ((e.metaKey || e.ctrlKey) && (e.key === 'k' || e.key === 'f')) {
        e.preventDefault();
        if (searchOverlay.classList.contains('is-open')) {
          closeSearch();
        } else {
          searchActiveEl = document.activeElement;
          searchOverlay.classList.add('is-open');
          setTimeout(function() { overlayInput.focus(); }, 50);
        }
      }
    });
  })();
</script>
