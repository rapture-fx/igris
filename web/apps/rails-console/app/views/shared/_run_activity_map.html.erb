<%# ── Run Activity Map — diverging skyline of recent runs over time. Each dot
    is one run, placed by time (x) and event outcome (y). Reads only the
    already-normalized, already-redacted run summary fields.
    Locals: runs (newest-first window), demo (bool), flush (bool, optional). %>
<% flush = local_assigns.fetch(:flush, false) %>
<section class="ic-runmap <%= 'ic-runmap--flush' if flush %>" aria-label="Run Activity Map">
  <div class="ic-runmap__head">
    <div class="ic-runmap__heading">
      <span class="ic-runmap__title">Run Activity Map</span>
      <span class="ic-runmap__sub">Recent run events grouped by outcome. Each dot is one run; click a dot to open its evidence.</span>
    </div>
    <% if demo %>
      <span class="ic-runmap__demo">Demo data — sample run activity</span>
    <% end %>
  </div>

  <% if runs.empty? %>
    <div class="ic-runmap__empty">
      <div class="ic-runmap__empty-title">No run activity yet</div>
      <p class="ic-runmap__empty-sub">Run activity appears after an agent or app calls an Igris action endpoint.</p>
      <div class="ic-runmap__empty-cta">
        <%= link_to 'Create action', new_action_path, class: 'ic-btn ic-btn--accent' %>
        <%= link_to 'Open Actions', actions_path, class: 'ic-btn' %>
      </div>
    </div>
  <% else %>
    <% points = run_activity_points(runs)
       n = points.size
       band_counts = points.each_with_object(Hash.new(0)) { |pt, h| h[pt[:band]] += 1 } %>
    <div class="ic-runmap__legend" aria-label="Run outcome legend">
      <% run_activity_bands.each do |b| %>
        <span class="ic-runmap__legend-item">
          <span class="ic-runmap__legend-dot ic-runmap__dot--<%= b[:key] %>" aria-hidden="true"></span>
          <span><%= b[:label] %></span>
          <span class="ic-runmap__legend-count"><%= band_counts[b[:key]] %></span>
        </span>
      <% end %>
    </div>

    <div class="ic-runmap__time-head">
      <span>Outcome</span>
      <span>Older runs</span>
      <span>Newer runs</span>
    </div>
    <div class="ic-runmap__scroll">
      <div class="ic-runmap__grid"
           style="grid-template-columns: minmax(82px, max-content) repeat(<%= n %>, 12px);">
        <% run_activity_bands.each_with_index do |b, ri| %>
          <span class="ic-runmap__band" style="grid-column: 1; grid-row: <%= ri + 1 %>;">
            <%= b[:label] %>
            <span class="ic-runmap__band-count"><%= band_counts[b[:key]] %></span>
          </span>
          <i class="ic-runmap__lane" style="grid-column: 2 / -1; grid-row: <%= ri + 1 %>;" aria-hidden="true"></i>
        <% end %>
        <% points.each do |pt| %>
          <%= link_to run_path(pt[:run][:id]),
                class: "ic-runmap__dot ic-runmap__dot--#{pt[:band]}",
                style: "grid-column: #{pt[:col]}; grid-row: #{pt[:row]};",
                data: {
                  tip: pt[:aria],
                  tip_action: pt[:run][:action].to_s.presence || '—',
                  tip_band:   pt[:band],
                  tip_status: run_activity_label(pt[:band]),
                  tip_via:    pt[:run][:routed_via],
                  tip_proof:  pt[:run][:proof].to_s.presence || 'Proof unavailable',
                  tip_time:   time_ago(pt[:run][:started_at]),
                },
                'aria-label': pt[:aria] do %><% end %>
        <% end %>
      </div>
    </div>

    <%# Custom hover tooltip — replaces the native browser title so it can be
        styled and tracks the hovered dot. One floating card, populated from the
        hovered dot's data-* fields and positioned via its bounding rect (so it
        works inside the horizontal scroll container). %>
    <div class="ic-runmap__tip" role="tooltip" aria-hidden="true">
      <div class="ic-runmap__tip-head">
        <span class="ic-runmap__tip-dot"></span>
        <span class="ic-runmap__tip-action"></span>
        <span class="ic-runmap__tip-status"></span>
      </div>
      <dl class="ic-runmap__tip-meta">
        <div class="ic-runmap__tip-row" data-row="via"><dt>Routed</dt><dd></dd></div>
        <div class="ic-runmap__tip-row" data-row="proof"><dt>Proof</dt><dd></dd></div>
        <div class="ic-runmap__tip-row" data-row="time"><dt>When</dt><dd></dd></div>
      </dl>
      <div class="ic-runmap__tip-hint">Click to open run evidence</div>
    </div>
    <script>
      (function () {
        var map = document.currentScript.closest('.ic-runmap');
        if (!map || map.dataset.tipBound) return;
        map.dataset.tipBound = '1';
        var tip    = map.querySelector('.ic-runmap__tip');
        var dotEl  = tip.querySelector('.ic-runmap__tip-dot');
        var action = tip.querySelector('.ic-runmap__tip-action');
        var status = tip.querySelector('.ic-runmap__tip-status');
        var rows   = tip.querySelectorAll('.ic-runmap__tip-row');
        var hideTimer = null;

        function setRow(row, value) {
          var dd = row.querySelector('dd');
          if (value && value.length) { dd.textContent = value; row.style.display = ''; }
          else { row.style.display = 'none'; }
        }

        function show(dot) {
          if (hideTimer) { clearTimeout(hideTimer); hideTimer = null; }
          var d = dot.dataset;
          if (!d.tipAction && !d.tip) return;
          action.textContent = d.tipAction || '—';
          status.textContent = d.tipStatus || '';
          status.style.display = d.tipStatus ? '' : 'none';
          dotEl.className = 'ic-runmap__tip-dot' + (d.tipBand ? ' ic-runmap__dot--' + d.tipBand : '');
          rows.forEach(function (row) {
            setRow(row, { via: d.tipVia, proof: d.tipProof, time: d.tipTime }[row.dataset.row]);
          });

          tip.classList.add('is-on');
          tip.setAttribute('aria-hidden', 'false');
          var r = dot.getBoundingClientRect();
          var m = map.getBoundingClientRect();
          var tw = tip.offsetWidth, th = tip.offsetHeight;
          var left = r.left - m.left + r.width / 2 - tw / 2;
          left = Math.max(6, Math.min(left, m.width - tw - 6));
          var top = r.top - m.top - th - 9;
          var below = top < 4;
          tip.classList.toggle('ic-runmap__tip--below', below);
          if (below) top = r.top - m.top + r.height + 9;
          // Point the caret at the dot even when the card is clamped sideways.
          var caret = r.left - m.left + r.width / 2 - left;
          tip.style.setProperty('--tip-caret', Math.max(10, Math.min(caret, tw - 10)) + 'px');
          tip.style.left = left + 'px';
          tip.style.top = top + 'px';
        }
        function hide() {
          hideTimer = setTimeout(function () {
            tip.classList.remove('is-on');
            tip.setAttribute('aria-hidden', 'true');
          }, 60);
        }

        map.addEventListener('mouseover', function (e) {
          var dot = e.target.closest('.ic-runmap__dot');
          if (dot) show(dot);
        });
        map.addEventListener('mouseout', function (e) {
          if (e.target.closest('.ic-runmap__dot')) hide();
        });
        map.addEventListener('focusin', function (e) {
          var dot = e.target.closest('.ic-runmap__dot');
          if (dot) show(dot);
        });
        map.addEventListener('focusout', function (e) {
          if (e.target.closest('.ic-runmap__dot')) hide();
        });
      })();
    </script>

    <div class="ic-runmap__axis">
      <span><%= time_ago(points.first[:run][:started_at]) %></span>
      <span class="ic-runmap__axis-mid">Showing latest <%= n %> run<%= 's' if n != 1 %></span>
      <span><%= time_ago(points.last[:run][:started_at]) %></span>
    </div>
  <% end %>
</section>
