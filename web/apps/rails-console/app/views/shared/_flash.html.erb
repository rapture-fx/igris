<% if flash[:notice].present? %>
  <div class="ig-strip" style="background: rgba(52,211,153,0.06); border-bottom-color: rgba(52,211,153,0.2);">
    <%= chip 'OK', tone: :ok %>
    <span style="font-size: 12px; color: var(--ig-text-body);"><%= flash[:notice] %></span>
  </div>
<% end %>
<% if flash[:alert].present? || flash[:error].present? %>
  <div class="ig-strip" style="background: rgba(251,113,133,0.06); border-bottom-color: rgba(251,113,133,0.2);">
    <%= chip 'Error', tone: :bad %>
    <span style="font-size: 12px; color: var(--ig-text-body);"><%= flash[:alert] || flash[:error] %></span>
  </div>
<% end %>
<% if local_assigns[:degraded_error].is_a?(Igris::OvertureClient::Error) %>
  <div class="ig-strip" style="background: rgba(251,191,36,0.06); border-bottom-color: rgba(251,191,36,0.25);">
    <%= chip 'Overture degraded', tone: :warn %>
    <span style="font-size: 12px; color: var(--ig-text-body);">
      <%= degraded_error.class.name.demodulize %><% if degraded_error.status %> · HTTP <%= degraded_error.status %><% end %>
      <% if degraded_error.code.present? %> · <code><%= degraded_error.code %></code><% end %>
      — showing best-effort state. Some data may be missing.
    </span>
  </div>
<% end %>
