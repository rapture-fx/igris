<%= render 'shared/runs_header_style' %>
<div class="igris-console" style="display: flex; flex-direction: column; flex: 1; min-height: 0;">
  <div class="ic-runs-header">
    <%= render 'shared/runs_view_tabs', active: 'evaluations' %>
    <div class="ic-runs-header__actions">
      <%= project_chip %>
      <%= link_to 'All evaluations', evaluations_path, class: 'ic-btn' %>
    </div>
  </div>

  <%= render 'shared/flash', degraded_error: @degraded_error %>

  <div class="ic-body ic-scroll ic-doc" style="padding: 18px 16px; max-width: 760px; width: 100%; margin: 0 auto;">
    <div class="ic-evidence" style="margin-bottom: 14px;">
      <div class="ic-evidence__head">Edit evaluation</div>
      <p class="ic-evidence__intro">Adjust the definition or its checks. Changes take effect on the next run you evaluate.</p>
    </div>
    <%= render 'form', evaluation: @evaluation, errors: @errors,
          url: evaluation_path(@evaluation[:id]), method: :patch, submit_label: 'Save changes' %>
  </div>
</div>
