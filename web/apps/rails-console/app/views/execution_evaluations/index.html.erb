<%#
  Execution Evaluation definitions — a plain explanatory list under the Runs
  lens (no cards). Each row links to the definition's detail report. Source of
  truth is Go Overture; Rails only presents.
%>
<%= render 'shared/runs_header_style' %>
<style>
  .ic-eval-list { border-top: 1px solid var(--ic-border-soft); }
  .ic-eval-row {
    display: grid; grid-template-columns: minmax(0, 1.6fr) 110px minmax(0, 1fr) 120px 96px;
    align-items: baseline; gap: 14px; padding: 12px 4px;
    border-bottom: 1px solid var(--ic-border-soft); text-decoration: none; color: inherit;
  }
  .ic-eval-row:hover { background: var(--ic-overlay-bg); }
  .ic-eval-row__name { font-size: 13px; font-weight: 600; color: var(--ic-text-bright); }
  .ic-eval-row__desc { margin-top: 2px; font-size: 11.5px; color: var(--ic-text-5); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ic-eval-row__cell { font-size: 12px; color: var(--ic-text-5); min-width: 0; }
  .ic-eval-row__cell.mono { font-family: var(--ic-mono); }
  @media (max-width: 820px) {
    .ic-eval-row { grid-template-columns: minmax(0, 1.6fr) 96px 96px; }
    .ic-eval-row__cell--target, .ic-eval-row__cell--updated { display: none; }
  }
</style>

<div class="igris-console" style="display: flex; flex-direction: column; flex: 1; min-height: 0;">
  <div class="ic-runs-header">
    <%= render 'shared/runs_view_tabs', active: 'evaluations' %>
    <div class="ic-runs-header__actions">
      <%= project_chip %>
      <%= link_to 'New evaluation', new_evaluation_path, class: 'ic-btn ic-btn--accent' %>
    </div>
  </div>

  <%= render 'shared/flash', degraded_error: @degraded_error %>

  <div class="ic-body ic-scroll ic-doc" style="padding: 18px 16px; max-width: 820px; width: 100%; margin: 0 auto;">
    <div class="ic-evidence" style="margin-bottom: 14px;">
      <div class="ic-evidence__head">Execution evaluations</div>
      <p class="ic-evidence__intro">
        Deterministic checks over recorded execution truth — did the agent call the right action,
        avoid forbidden actions, require approval when needed, recover correctly, and produce proof
        without leaking secrets. These never read prompts, model output, or raw request bodies.
        They connect Run and Prove to Evaluate: each result links back to the run that produced it.
      </p>
    </div>

    <% if @evaluations.blank? %>
      <div class="ic-evidence">
        <div class="ic-evidence__head">No evaluations yet</div>
        <p class="ic-doc__note">
          An execution evaluation is a small set of expectations you attach to an action — for example,
          “send_email was called”, “no approval was required”, and “a signed proof exists”. Run it against
          any recorded run to see, check by check, whether the run behaved correctly.
        </p>
        <p style="margin-top: 12px;">
          <%= link_to 'Create your first evaluation', new_evaluation_path, class: 'ic-btn ic-btn--accent' %>
        </p>
      </div>
    <% else %>
      <div class="ic-eval-list">
        <% @evaluations.each do |eval| %>
          <%= link_to evaluation_path(eval[:id]), class: 'ic-eval-row' do %>
            <div>
              <div class="ic-eval-row__name"><%= eval[:name].presence || 'Untitled evaluation' %></div>
              <% if eval[:description].present? %>
                <div class="ic-eval-row__desc"><%= eval[:description] %></div>
              <% end %>
            </div>
            <div class="ic-eval-row__cell">
              <span class="ic-doc__stat ic-doc__stat--<%= eval[:enabled] ? 'ok' : 'muted' %>"><%= eval[:enabled] ? 'Enabled' : 'Disabled' %></span>
            </div>
            <div class="ic-eval-row__cell mono ic-eval-row__cell--target"><%= eval[:target_action_name].presence || 'any' %></div>
            <div class="ic-eval-row__cell"><%= pluralize(eval[:assertion_count], 'assertion') %></div>
            <div class="ic-eval-row__cell ic-eval-row__cell--updated"><%= time_ago(eval[:updated_at]) %></div>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
