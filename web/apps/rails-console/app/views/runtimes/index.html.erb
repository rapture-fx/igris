<%# Runtimes — connected runtime hosts. Counts live in the topbar. %>
<% healthy_count = @runtimes.count { |r| r[:status] == 'Healthy' } %>
<div class="ic-topbar">
  <div class="ic-topbar__group">
    <span class="ic-topbar__title">Runtimes</span>
    <span class="ic-chip"><%= @runtimes.size %> connected</span>
    <span class="ic-chip" style="color: var(--ic-emerald);">
      <%= healthy_count %> healthy
    </span>
  </div>
  <div class="ic-topbar__group">
    <button class="ic-btn">Filter</button>
    <button class="ic-btn ic-btn--accent">Install runtime</button>
  </div>
</div>

<%= render 'shared/flash', degraded_error: @degraded_error %>

<div class="ic-body ic-scroll">
  <div class="ic-runtime-list">
    <% @runtimes.each do |rt| %>
      <% healthy = rt[:status] == 'Healthy' %>
      <div class="ic-runtime-row">
        <span class="ic-runtime-row__dot <%= 'ic-runtime-row__dot--ok' if healthy %> <%= 'ic-runtime-row__dot--off' unless healthy %>"></span>
        <div class="ic-runtime-row__main">
          <div class="ic-runtime-row__name"><%= rt[:name] %></div>
          <div class="ic-runtime-row__meta">
            <span class="mono"><%= rt[:runtime_id] %></span>
            <% if rt[:os].present? %> · <%= rt[:os] %><% end %>
            · last seen <%= time_ago(rt[:last_seen_at]) %>
          </div>
        </div>
        <div class="ic-runtime-row__caps">
          <% Array(rt[:capabilities]).each do |c| %>
            <span class="ic-chip"><%= c %></span>
          <% end %>
        </div>
        <span class="ic-runtime-row__status <%= healthy ? 'is-ok' : 'is-off' %>">
          <%= rt[:status] %>
        </span>
      </div>
    <% end %>
  </div>

  <div style="margin-top: 24px;">
    <div class="ic-section-head">
      <span class="ic-section-head__label">Install on a new host</span>
    </div>
    <p style="font-size: 12px; color: var(--ic-text-5); margin: 0 0 10px; max-width: 60ch;">
      Install the runtime on the machine that needs network access to your
      private resources. That's the only host involved in dispatch.
    </p>
    <%= code_snippet 'IGRIS_API_KEY=igris_... curl -fsSL https://igrisinertial.com/install | bash', language: 'bash' %>
  </div>
</div>
