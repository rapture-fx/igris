#!/usr/bin/env bash
# Igris public installer
# Usage: curl -fsSL https://igrisinertial.com/install | bash
#
# This script is intentionally readable. It installs a user-local Igris CLI
# into ~/.igris/bin, verifies checksums when available, does not use sudo, does
# not modify shell profiles, and prints no secrets.

set -euo pipefail

IGRIS_VERSION="${IGRIS_VERSION:-v1.6.0}"
IGRIS_INSTALL_DIR="${IGRIS_INSTALL_DIR:-$HOME/.igris/bin}"
IGRIS_RELEASE_BASE="${IGRIS_RELEASE_BASE:-https://github.com/Igris-inertial/system/releases/download}"
IGRIS_DOWNLOAD_BASE="${IGRIS_DOWNLOAD_BASE:-https://overture.igrisinertial.com/v1/runtime}"
IGRIS_DRY_RUN="${IGRIS_DRY_RUN:-false}"
IGRIS_RUN_DEMO="${IGRIS_RUN_DEMO:-true}"

info() { printf '[igris] %s\n' "$*" >&2; }
warn() { printf '[igris] warning: %s\n' "$*" >&2; }
die() { printf '[igris] error: %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'EOF'
Igris installer

Usage:
  curl -fsSL https://igrisinertial.com/install | bash
  IGRIS_DRY_RUN=true bash install
  IGRIS_INSTALL_DIR="$HOME/bin" bash install
  IGRIS_LOCAL_BINARY=./target/release/igris bash install

Environment:
  IGRIS_VERSION       Release tag to install. Default: v1.6.0
  IGRIS_INSTALL_DIR  User-local install dir. Default: ~/.igris/bin
  IGRIS_DRY_RUN      Print actions without installing. Default: false
  IGRIS_RUN_DEMO     Run `igris demo --recover-prove` after install. Default: true
  IGRIS_LOCAL_BINARY Install from a local binary artifact instead of downloading.
EOF
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
esac

need() {
  command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

detect_platform() {
  local os arch
  case "$(uname -s)" in
    Darwin) os="macos" ;;
    Linux) os="linux" ;;
    *) die "unsupported OS: $(uname -s). Supported: macOS and Linux." ;;
  esac

  case "$(uname -m)" in
    arm64|aarch64) arch="arm64" ;;
    x86_64|amd64) arch="x86_64" ;;
    *) die "unsupported CPU architecture: $(uname -m). Supported: arm64 and x86_64." ;;
  esac

  echo "${os}-${arch}"
}

sha256_file() {
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  elif command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  else
    echo ""
  fi
}

download() {
  local url="$1"
  local out="$2"
  curl -fsSL --retry 2 --connect-timeout 10 -H "User-Agent: igris-installer/1.1" "$url" -o "$out"
}

download_archive() {
  local platform="$1"
  local out="$2"
  local primary="${IGRIS_RELEASE_BASE}/${IGRIS_VERSION}/igris-${platform}.tar.gz"
  local fallback_platform="${platform/x86_64/amd64}"
  local fallback="${IGRIS_DOWNLOAD_BASE}/install?platform=${fallback_platform}"

  info "Downloading Igris CLI for ${platform}"
  info "Primary release URL: ${primary}"
  if download "$primary" "$out"; then
    echo "$primary"
    return 0
  fi

  warn "release artifact unavailable; trying hosted runtime distribution"
  if download "$fallback" "$out"; then
    echo "$fallback"
    return 0
  fi

  die "could not download Igris for ${platform}. If releases are not ready, set IGRIS_LOCAL_BINARY to a local build artifact."
}

verify_checksum_if_available() {
  local archive="$1"
  local source_url="$2"
  local actual expected checksum_url checksum_file

  actual="$(sha256_file "$archive")"
  if [ -z "$actual" ]; then
    warn "shasum/sha256sum not found; checksum verification skipped"
    return 0
  fi

  checksum_file="${archive}.sha256"
  checksum_url="${source_url}.sha256"
  if ! download "$checksum_url" "$checksum_file"; then
    warn "checksum file not published for this artifact; continuing without checksum verification"
    return 0
  fi

  expected="$(grep -oE '^[a-fA-F0-9]{64}' "$checksum_file" | head -1 | tr '[:upper:]' '[:lower:]')"
  [ -n "$expected" ] || die "checksum file exists but did not contain a SHA-256 digest"

  if [ "$expected" != "$actual" ]; then
    die "checksum mismatch for downloaded archive"
  fi
  info "Checksum verified"
}

install_binary() {
  local src="$1"
  local tmp="$2"
  local candidate=""

  if [ -f "$src" ]; then
    candidate="$src"
  else
    tar -C "$tmp" -xzf "$src"
    if [ -f "$tmp/igris" ]; then
      candidate="$tmp/igris"
    elif [ -f "$tmp/igris-runtime" ]; then
      candidate="$tmp/igris-runtime"
    else
      candidate="$(find "$tmp" -type f \( -name igris -o -name igris-runtime \) | head -1 || true)"
    fi
  fi

  [ -n "$candidate" ] && [ -f "$candidate" ] || die "archive did not contain an igris binary"

  if [ "$IGRIS_DRY_RUN" = "true" ]; then
    info "dry run: would install ${candidate} to ${IGRIS_INSTALL_DIR}/igris"
    info "dry run: would create compatibility command ${IGRIS_INSTALL_DIR}/igris-runtime"
    return 0
  fi

  mkdir -p "$IGRIS_INSTALL_DIR"
  cp "$candidate" "$IGRIS_INSTALL_DIR/igris"
  chmod 0755 "$IGRIS_INSTALL_DIR/igris"
  cp "$IGRIS_INSTALL_DIR/igris" "$IGRIS_INSTALL_DIR/igris-runtime"
  chmod 0755 "$IGRIS_INSTALL_DIR/igris-runtime"
}

main() {
  need curl
  need tar

  local platform tmp archive source_url
  platform="$(detect_platform)"
  tmp="$(mktemp -d)"
  trap 'rm -rf "${tmp:-}"' EXIT
  archive="$tmp/igris-${platform}.tar.gz"

  info "Detected platform: ${platform}"
  info "Install directory: ${IGRIS_INSTALL_DIR}"
  info "No sudo will be used. Shell profiles will not be modified."

  if [ "$IGRIS_DRY_RUN" = "true" ]; then
    info "Dry run enabled"
    info "dry run: would download or use IGRIS_LOCAL_BINARY for ${platform}"
    info "dry run: would install igris and igris-runtime into ${IGRIS_INSTALL_DIR}"
    info "dry run: would print PATH and uninstall instructions"
    exit 0
  fi

  if [ -n "${IGRIS_LOCAL_BINARY:-}" ]; then
    [ -f "$IGRIS_LOCAL_BINARY" ] || die "IGRIS_LOCAL_BINARY does not exist: $IGRIS_LOCAL_BINARY"
    source_url="local:${IGRIS_LOCAL_BINARY}"
    install_binary "$IGRIS_LOCAL_BINARY" "$tmp"
  else
    source_url="$(download_archive "$platform" "$archive")"
    verify_checksum_if_available "$archive" "$source_url"
    install_binary "$archive" "$tmp"
  fi

  if [ "$IGRIS_DRY_RUN" = "true" ]; then
    info "dry run complete"
    exit 0
  fi

  info "Igris installed successfully."
  if ! printf ':%s:' "${PATH:-}" | grep -q ":${IGRIS_INSTALL_DIR}:"; then
    echo ""
    echo "Add Igris to your PATH:"
    echo "  export PATH=\"${IGRIS_INSTALL_DIR}:\$PATH\""
    echo ""
  fi

  echo "Commands:"
  echo "  ${IGRIS_INSTALL_DIR}/igris doctor"
  echo "  ${IGRIS_INSTALL_DIR}/igris demo --recover-prove"
  echo "  ${IGRIS_INSTALL_DIR}/igris uninstall"
  echo ""
  echo "Uninstall:"
  echo "  ${IGRIS_INSTALL_DIR}/igris uninstall"
  echo "  rm -rf \"${IGRIS_INSTALL_DIR%/bin}\""
  echo ""

  if [ "$IGRIS_RUN_DEMO" = "true" ]; then
    info "Running local proof demo..."
    "${IGRIS_INSTALL_DIR}/igris" demo --recover-prove
  fi
}

main "$@"
