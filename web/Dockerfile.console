FROM node:20-alpine AS base
RUN corepack enable && corepack prepare pnpm@8.15.0 --activate

# ── Install deps ──────────────────────────────────────────────────────────────
FROM base AS deps
WORKDIR /monorepo

# Copy workspace manifests
COPY web/package.json web/pnpm-lock.yaml web/pnpm-workspace.yaml ./web/

# Copy workspace package manifests (needed by pnpm to resolve the workspace)
COPY labs/packages/types/package.json ./labs/packages/types/
COPY labs/packages/ui/package.json ./labs/packages/ui/
COPY labs/packages/config/package.json ./labs/packages/config/
COPY labs/packages/javascript-sdk/package.json ./labs/packages/javascript-sdk/
COPY web/apps/web-console/package.json ./web/apps/web-console/

WORKDIR /monorepo/web
# --no-frozen-lockfile: lockfile may drift when deps are added/removed locally
RUN pnpm install --no-frozen-lockfile --ignore-scripts

# ── Build ─────────────────────────────────────────────────────────────────────
FROM base AS builder
WORKDIR /monorepo

# Copy node_modules from deps stage (root + app-level)
COPY --from=deps /monorepo/web/node_modules ./web/node_modules
COPY --from=deps /monorepo/web/apps/web-console/node_modules ./web/apps/web-console/node_modules

# Copy full source
COPY web/ ./web/
COPY labs/packages/ ./labs/packages/

WORKDIR /monorepo/web
ENV NEXT_TELEMETRY_DISABLED=1

# NEXT_PUBLIC_* vars must be present at build time (they get inlined into the bundle)
ARG NEXT_PUBLIC_API_URL=https://overture.igrisinertial.com
ARG NEXT_PUBLIC_APP_URL=https://console.igrisinertial.com
ARG NEXT_PUBLIC_LANDING_URL=https://igrisinertial.com
ARG NEXT_PUBLIC_API_HEALTH_CHECK_URL=/healthz
ARG NEXT_PUBLIC_ENV=production
ARG NEXT_PUBLIC_ENABLE_ANALYTICS=true
ARG NEXT_PUBLIC_ENABLE_MONITORING=true
ARG NEXT_PUBLIC_ENABLE_MOCK_DATA=false
ARG NEXT_PUBLIC_DEV_MODE=false

ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
ENV NEXT_PUBLIC_LANDING_URL=$NEXT_PUBLIC_LANDING_URL
ENV NEXT_PUBLIC_API_HEALTH_CHECK_URL=$NEXT_PUBLIC_API_HEALTH_CHECK_URL
ENV NEXT_PUBLIC_ENV=$NEXT_PUBLIC_ENV
ENV NEXT_PUBLIC_ENABLE_ANALYTICS=$NEXT_PUBLIC_ENABLE_ANALYTICS
ENV NEXT_PUBLIC_ENABLE_MONITORING=$NEXT_PUBLIC_ENABLE_MONITORING
ENV NEXT_PUBLIC_ENABLE_MOCK_DATA=$NEXT_PUBLIC_ENABLE_MOCK_DATA
ENV NEXT_PUBLIC_DEV_MODE=$NEXT_PUBLIC_DEV_MODE

RUN pnpm --filter @igris-inertial/web-console build

# ── Production image ──────────────────────────────────────────────────────────
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copy the entire standalone directory to preserve pnpm symlinks (relative paths
# like node_modules/next → ../../../node_modules/.pnpm/... only resolve correctly
# when the full standalone tree is rooted at /app/)
COPY --from=builder /monorepo/web/apps/web-console/public ./public

COPY --from=builder --chown=nextjs:nodejs \
  /monorepo/web/apps/web-console/.next/standalone/ ./
COPY --from=builder --chown=nextjs:nodejs \
  /monorepo/web/apps/web-console/.next/static ./.next/static

USER nextjs

EXPOSE 3005
ENV PORT=3005
ENV HOSTNAME="0.0.0.0"

CMD ["node", "server.js"]
