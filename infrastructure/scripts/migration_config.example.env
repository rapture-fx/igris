# Database Migration Configuration
# Copy this file to migration_config.env and update with your actual values

# ==================== DATABASE CONNECTIONS ====================
# Source AWS RDS Database URL (read access required)
AWS_DATABASE_URL=postgresql://username:password@rds-endpoint.region.rds.amazonaws.com:5432/database_name

# Target Supabase Database URL (full access required)
SUPABASE_DATABASE_URL=postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres

# ==================== MIGRATION SETTINGS ====================
# Number of records to process in each batch (default: 1000)
# Lower values use less memory but take longer
# Higher values are faster but use more memory
MIGRATION_BATCH_SIZE=1000

# Number of parallel workers for table migration (default: 4)
# More workers = faster migration but higher resource usage
MIGRATION_PARALLEL_WORKERS=4

# Operation timeout in seconds (default: 3600 = 1 hour)
MIGRATION_TIMEOUT_SECONDS=3600

# ==================== VALIDATION SETTINGS ====================
# Whether to perform data validation after migration (default: true)
MIGRATION_VALIDATE_DATA=true

# Whether to create indexes and constraints (default: true)
MIGRATION_CREATE_INDEXES=true

# Whether to migrate database sequences (default: true)
MIGRATION_MIGRATE_SEQUENCES=true

# ==================== BACKUP AND RECOVERY ====================
# Whether to backup target database before migration (default: true)
MIGRATION_BACKUP=true

# Whether to resume migration on failure (default: true)
MIGRATION_RESUME=true

# ==================== LOGGING SETTINGS ====================
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
MIGRATION_LOG_LEVEL=INFO

# ==================== PERFORMANCE TUNING ====================
# Connection pool settings for source database
SOURCE_DB_POOL_SIZE=10
SOURCE_DB_MAX_OVERFLOW=20

# Connection pool settings for target database
TARGET_DB_POOL_SIZE=10
TARGET_DB_MAX_OVERFLOW=20

# ==================== MONITORING AND ALERTS ====================
# Webhook URL for migration status notifications (optional)
MIGRATION_WEBHOOK_URL=https://your-monitoring-system.com/webhooks/migration

# Email for critical alerts (optional)
MIGRATION_ALERT_EMAIL=admin@yourcompany.com

# ==================== SECURITY SETTINGS ====================
# SSL mode for connections (require, prefer, disable)
DB_SSL_MODE=require

# Certificate verification
DB_SSL_CERT_PATH=/path/to/cert.pem
DB_SSL_KEY_PATH=/path/to/key.pem
DB_SSL_CA_PATH=/path/to/ca.pem