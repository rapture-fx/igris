{
  "dashboard": {
    "title": "Schlep-Engine Hybrid ML Pipeline Dashboard",
    "tags": ["ml", "hybrid", "rust", "python", "streaming"],
    "timezone": "browser",
    "schemaVersion": 30,
    "version": 1,
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "title": "Data Ingestion Overview",
        "type": "row",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Batch Ingestion Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 1},
        "targets": [
          {
            "expr": "rate(batch_ingestion_total[5m])",
            "legendFormat": "Batch ingestion rate (req/s)"
          },
          {
            "expr": "rate(batch_ingestion_failed_total[5m])",
            "legendFormat": "Failed ingestions (req/s)"
          }
        ],
        "yaxes": [
          {"format": "reqps", "label": "Requests/sec"},
          {"format": "short"}
        ]
      },
      {
        "id": 3,
        "title": "Streaming Message Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 1},
        "targets": [
          {
            "expr": "rate(stream_messages_published_total[5m])",
            "legendFormat": "Published (msg/s)"
          },
          {
            "expr": "rate(stream_messages_consumed_total[5m])",
            "legendFormat": "Consumed (msg/s)"
          }
        ],
        "yaxes": [
          {"format": "msgps", "label": "Messages/sec"},
          {"format": "short"}
        ]
      },
      {
        "id": 4,
        "title": "Rust Kernel Performance",
        "type": "row",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 9}
      },
      {
        "id": 5,
        "title": "Rust Processing Duration (P95)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 10},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(rust_kernel_processing_duration_seconds_bucket[5m]))",
            "legendFormat": "P95 Processing Time"
          },
          {
            "expr": "histogram_quantile(0.99, rate(rust_kernel_processing_duration_seconds_bucket[5m]))",
            "legendFormat": "P99 Processing Time"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "Duration"},
          {"format": "short"}
        ]
      },
      {
        "id": 6,
        "title": "Memory Usage (Rust Kernels)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 10},
        "targets": [
          {
            "expr": "rust_kernel_memory_usage_bytes / 1024 / 1024 / 1024",
            "legendFormat": "Memory Usage (GB)"
          },
          {
            "expr": "10",
            "legendFormat": "Threshold (10GB)"
          }
        ],
        "yaxes": [
          {"format": "gbytes", "label": "Memory (GB)"},
          {"format": "short"}
        ],
        "alert": {
          "conditions": [
            {
              "evaluator": {"params": [10], "type": "gt"},
              "operator": {"type": "and"},
              "query": {"params": ["A", "5m", "now"]},
              "reducer": {"params": [], "type": "avg"},
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "frequency": "60s",
          "handler": 1,
          "name": "High Rust Kernel Memory Usage",
          "noDataState": "no_data",
          "notifications": []
        }
      },
      {
        "id": 7,
        "title": "ML Framework Integration",
        "type": "row",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 18}
      },
      {
        "id": 8,
        "title": "ML Framework Conversions",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 19},
        "targets": [
          {
            "expr": "rate(ml_framework_conversions_total{framework='sklearn'}[5m])",
            "legendFormat": "scikit-learn"
          },
          {
            "expr": "rate(ml_framework_conversions_total{framework='tensorflow'}[5m])",
            "legendFormat": "TensorFlow"
          },
          {
            "expr": "rate(ml_framework_conversions_total{framework='pytorch'}[5m])",
            "legendFormat": "PyTorch"
          },
          {
            "expr": "rate(ml_framework_conversions_total{framework='huggingface'}[5m])",
            "legendFormat": "HuggingFace"
          }
        ],
        "yaxes": [
          {"format": "ops", "label": "Conversions/sec"},
          {"format": "short"}
        ]
      },
      {
        "id": 9,
        "title": "Arrow IPC Transfer Efficiency",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 19},
        "targets": [
          {
            "expr": "rate(arrow_ipc_bytes_transferred_total[5m]) / 1024 / 1024",
            "legendFormat": "Data Transfer (MB/s)"
          },
          {
            "expr": "rate(arrow_ipc_conversions_total[5m])",
            "legendFormat": "Zero-copy conversions (ops/s)"
          }
        ],
        "yaxes": [
          {"format": "MBs", "label": "Throughput"},
          {"format": "ops"}
        ]
      },
      {
        "id": 10,
        "title": "Data Quality & Processing",
        "type": "row",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 27}
      },
      {
        "id": 11,
        "title": "Dataset Processing Throughput",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 28},
        "targets": [
          {
            "expr": "rate(dataset_rows_processed_total[5m])",
            "legendFormat": "Rows processed/sec"
          },
          {
            "expr": "rate(dataset_deduplication_total[5m])",
            "legendFormat": "Deduplication ops/sec"
          },
          {
            "expr": "rate(dataset_join_operations_total[5m])",
            "legendFormat": "Join ops/sec"
          }
        ],
        "yaxes": [
          {"format": "ops", "label": "Operations/sec"},
          {"format": "short"}
        ]
      },
      {
        "id": 12,
        "title": "Memory Optimization Ratio",
        "type": "stat",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 28},
        "targets": [
          {
            "expr": "(1 - (rust_kernel_memory_usage_bytes / pandas_equivalent_memory_bytes)) * 100",
            "legendFormat": "Memory Savings (%)"
          }
        ],
        "options": {
          "graphMode": "area",
          "colorMode": "value",
          "justifyMode": "center",
          "textMode": "value_and_name",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          }
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 50, "color": "yellow"},
                {"value": 70, "color": "green"}
              ]
            },
            "unit": "percent"
          }
        }
      },
      {
        "id": 13,
        "title": "Streaming Performance",
        "type": "row",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 36}
      },
      {
        "id": 14,
        "title": "Stream Processing Latency",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 37},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(stream_processing_duration_seconds_bucket[5m])) * 1000",
            "legendFormat": "P50 Latency (ms)"
          },
          {
            "expr": "histogram_quantile(0.95, rate(stream_processing_duration_seconds_bucket[5m])) * 1000",
            "legendFormat": "P95 Latency (ms)"
          },
          {
            "expr": "histogram_quantile(0.99, rate(stream_processing_duration_seconds_bucket[5m])) * 1000",
            "legendFormat": "P99 Latency (ms)"
          }
        ],
        "yaxes": [
          {"format": "ms", "label": "Latency"},
          {"format": "short"}
        ]
      },
      {
        "id": 15,
        "title": "NATS JetStream Queue Depth",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 37},
        "targets": [
          {
            "expr": "nats_jetstream_stream_messages",
            "legendFormat": "Pending Messages"
          },
          {
            "expr": "10000",
            "legendFormat": "Alert Threshold"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Messages"},
          {"format": "short"}
        ]
      }
    ],
    "templating": {
      "list": [
        {
          "name": "datasource",
          "type": "datasource",
          "query": "prometheus"
        },
        {
          "name": "environment",
          "type": "query",
          "query": "label_values(environment)",
          "multi": false
        }
      ]
    },
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"]
    },
    "annotations": {
      "list": [
        {
          "datasource": "Prometheus",
          "enable": true,
          "expr": "ALERTS{alertstate=\"firing\"}",
          "iconColor": "red",
          "name": "Alerts",
          "tagKeys": "alertname,severity"
        }
      ]
    }
  }
}
