# Railway Environment Configuration Template for Schlep-engine FastAPI Backend
# Copy this file, rename to '.env', and configure the values for your specific deployment
# 
# SECURITY NOTE: Never commit actual secrets to version control.
# Use Railway's environment variable dashboard for sensitive values.

# =============================================================================
# CORE APPLICATION CONFIGURATION
# =============================================================================

# Application Settings
PORT=8000
ENVIRONMENT=production
LOG_LEVEL=INFO
APP_VERSION=1.0.0
HOST=0.0.0.0

# Application URLs and Domains
# Replace with your actual domain(s)
CORS_ORIGINS=https://*.railway.app,https://yourdomain.com,https://api.yourdomain.com
ALLOWED_HOSTS=*.railway.app,yourdomain.com,api.yourdomain.com

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# Authentication & Security
# CRITICAL: Change these values for production deployment
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Session Configuration
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax

# Security Headers
ENABLE_SECURITY_HEADERS=true
FORCE_HTTPS=true
ENABLE_HSTS=true

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Primary Database (PostgreSQL)
# Configure in Railway dashboard or use Railway's ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://username:password@hostname:5432/database_name

# Supabase Configuration (if using Supabase)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Database Connection Pooling
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

# Redis for Caching and Celery
# Configure in Railway dashboard or use Railway's ${{Redis.REDIS_URL}}
REDIS_URL=redis://username:password@hostname:6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0

# Redis Connection Settings
REDIS_MAX_CONNECTIONS=20
REDIS_RETRY_ON_TIMEOUT=true
REDIS_SOCKET_KEEPALIVE=true

# =============================================================================
# ML AND AI CONFIGURATION
# =============================================================================

# ML Model Configuration
ML_MODEL_CACHE_SIZE=2000
ML_BATCH_SIZE=16
ML_MAX_PARALLEL_JOBS=2
ML_MEMORY_LIMIT=3072
ML_TIMEOUT=300

# TensorFlow Optimization (CPU-only for Railway)
TENSORFLOW_INTER_OP_PARALLELISM_THREADS=2
TENSORFLOW_INTRA_OP_PARALLELISM_THREADS=2
TF_CPP_MIN_LOG_LEVEL=2
CUDA_VISIBLE_DEVICES=-1

# PyTorch Optimization
TORCH_NUM_THREADS=2
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2

# Hugging Face Configuration (if using Transformers)
TRANSFORMERS_CACHE=/app/cache/transformers
HF_HOME=/app/cache/huggingface

# =============================================================================
# WORKER AND PERFORMANCE CONFIGURATION
# =============================================================================

# Uvicorn/Gunicorn Settings
WORKERS=2
MAX_WORKER_CONNECTIONS=1000
WORKER_CLASS=uvicorn.workers.UvicornWorker
KEEP_ALIVE=30
TIMEOUT=300
GRACEFUL_TIMEOUT=30
MAX_REQUESTS=1000
MAX_REQUESTS_JITTER=100

# Memory Management
MALLOC_TRIM_THRESHOLD=131072
MALLOC_MMAP_THRESHOLD=131072
PYTHONMALLOC=malloc
PYTHONHASHSEED=random

# =============================================================================
# CELERY BACKGROUND PROCESSING
# =============================================================================

# Celery Configuration
CELERY_BROKER_URL=redis://username:password@hostname:6379/0
CELERY_RESULT_BACKEND=redis://username:password@hostname:6379/0
CELERY_WORKER_CONCURRENCY=2
CELERY_TASK_TIME_LIMIT=600
CELERY_TASK_SOFT_TIME_LIMIT=540
CELERY_TASK_ROUTES={}

# Celery Beat (Scheduler)
CELERY_BEAT_SCHEDULE_FILENAME=/app/celerybeat-schedule
CELERY_TIMEZONE=UTC

# =============================================================================
# FILE PROCESSING AND STORAGE
# =============================================================================

# File Upload Configuration
MAX_UPLOAD_SIZE=52428800
ALLOWED_FILE_TYPES=csv,xlsx,xls,json,parquet,pdf,txt,png,jpg,jpeg
UPLOAD_TIMEOUT=120
UPLOAD_DIR=/app/uploads

# Google Cloud Storage (if using GCS)
GCS_BUCKET_NAME=your-gcs-bucket-name
GOOGLE_APPLICATION_CREDENTIALS=/app/gcs-credentials.json

# AWS S3 Configuration (if using S3)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=your-s3-bucket-name
AWS_REGION=us-east-1

# Local Storage Fallback
LOCAL_STORAGE_PATH=/app/storage
ENABLE_LOCAL_STORAGE=true

# =============================================================================
# MONITORING AND OBSERVABILITY
# =============================================================================

# Prometheus Metrics
PROMETHEUS_METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_PATH=/metrics

# Sentry Error Tracking
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Application Performance Monitoring
APM_ENABLED=true
APM_SERVICE_NAME=schlep-engine-api
APM_ENVIRONMENT=production

# Custom Metrics
CUSTOM_METRICS_ENABLED=true
BUSINESS_METRICS_ENABLED=true

# =============================================================================
# API RATE LIMITING
# =============================================================================

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60
RATE_LIMIT_BURST=20
RATE_LIMIT_STORAGE_URL=redis://username:password@hostname:6379/1

# API Key Rate Limits
API_KEY_RATE_LIMIT=1000
API_KEY_RATE_PERIOD=3600

# =============================================================================
# THIRD-PARTY INTEGRATIONS
# =============================================================================

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@yourdomain.com

# Slack Integration (for alerts)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
SLACK_CHANNEL=#alerts

# Webhook Configuration
WEBHOOK_SECRET=your-webhook-secret
WEBHOOK_TIMEOUT=30

# =============================================================================
# DEVELOPMENT AND DEBUGGING
# =============================================================================

# Debug Settings (set to false in production)
DEBUG=false
ENABLE_SWAGGER_UI=false
ENABLE_REDOC=false

# Testing Configuration
TEST_DATABASE_URL=sqlite:///./test.db
TESTING=false

# Development Tools
ENABLE_PROFILER=false
PROFILER_OUTPUT_DIR=/app/profiles

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Logging Settings
LOG_FORMAT=json
LOG_FILE=/app/logs/app.log
LOG_MAX_SIZE=100MB
LOG_BACKUP_COUNT=5
LOG_ROTATION=daily

# Component-specific Logging
DB_LOG_LEVEL=WARNING
REDIS_LOG_LEVEL=WARNING
CELERY_LOG_LEVEL=INFO
ML_LOG_LEVEL=INFO

# Structured Logging
ENABLE_STRUCTURED_LOGGING=true
LOG_REQUEST_ID=true
LOG_USER_ID=true

# =============================================================================
# HEALTH CHECKS AND READINESS
# =============================================================================

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_TIMEOUT=30
HEALTH_CHECK_INTERVAL=60

# Readiness Probe Configuration
READINESS_CHECK_ENABLED=true
READINESS_CHECK_TIMEOUT=10
READINESS_CHECK_DEPENDENCIES=database,redis

# Liveness Probe Configuration
LIVENESS_CHECK_ENABLED=true
LIVENESS_CHECK_TIMEOUT=5

# =============================================================================
# FEATURE FLAGS AND TOGGLES
# =============================================================================

# Feature Flags
ENABLE_ML_PROCESSING=true
ENABLE_DOCUMENT_EXTRACTION=true
ENABLE_DATA_QUALITY_CHECKS=true
ENABLE_SEMANTIC_SEARCH=true
ENABLE_REAL_TIME_PROCESSING=true

# Beta Features
ENABLE_EXPERIMENTAL_FEATURES=false
ENABLE_ADVANCED_ANALYTICS=true

# =============================================================================
# COMPLIANCE AND AUDIT
# =============================================================================

# Data Protection
ENABLE_DATA_ENCRYPTION=true
ENABLE_PII_DETECTION=true
ENABLE_AUDIT_LOGGING=true

# GDPR Compliance
ENABLE_RIGHT_TO_ERASURE=true
ENABLE_DATA_PORTABILITY=true
DATA_RETENTION_DAYS=365

# Audit Configuration
AUDIT_LOG_LEVEL=INFO
AUDIT_LOG_FILE=/app/logs/audit.log
ENABLE_REQUEST_LOGGING=true

# =============================================================================
# OPTIMIZATION AND CACHING
# =============================================================================

# Application Caching
ENABLE_RESPONSE_CACHING=true
CACHE_DEFAULT_TIMEOUT=300
CACHE_MAX_SIZE=1000

# Model Caching
ENABLE_MODEL_CACHING=true
MODEL_CACHE_SIZE=5
MODEL_CACHE_TTL=3600

# Query Caching
ENABLE_QUERY_CACHING=true
QUERY_CACHE_TTL=600

# =============================================================================
# EXAMPLE VALUES FOR TESTING
# =============================================================================

# These are example values for development/testing purposes
# DO NOT use these in production

# Example Database URL (for local development)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/schlep_engine_dev

# Example Redis URL (for local development)
# REDIS_URL=redis://localhost:6379/0

# Example Secret Key (for development only)
# SECRET_KEY=dev-secret-key-not-for-production-use-only

