# Schlep Engine Phase One - Vultr VPS Environment Configuration
# Copy this file to .env.phase-one and customize for your VPS deployment

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================

ENVIRONMENT=production
DEBUG=false

# Domain Configuration
DOMAIN=schlep-engine.com
API_URL=https://api.schlep-engine.com
FRONTEND_URL=https://schlep-engine.com
GRAFANA_URL=https://monitoring.schlep-engine.com

# CORS and Security
ALLOWED_ORIGINS=https://schlep-engine.com,https://admin.schlep-engine.com,https://docs.schlep-engine.com,https://monitoring.schlep-engine.com
ALLOWED_HOSTS=api.schlep-engine.com,admin.schlep-engine.com,docs.schlep-engine.com,monitoring.schlep-engine.com

# =============================================================================
# SECURITY KEYS (GENERATE NEW ONES!)
# =============================================================================

# Generate with: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_GENERATED_32_CHAR_HEX_KEY
JWT_SECRET_KEY=REPLACE_WITH_GENERATED_32_CHAR_HEX_KEY

# Algorithm for JWT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# DATABASE CONFIGURATION - Phase One PostgreSQL
# =============================================================================

# PostgreSQL Configuration
POSTGRES_DB=schlep_engine
POSTGRES_USER=schlep_user
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

# Database URL for application
DATABASE_URL=postgresql://schlep_user:REPLACE_WITH_SECURE_PASSWORD@postgres:5432/schlep_engine

# PostgreSQL Performance Tuning (VPS Optimized)
# Adjust based on your VPS RAM (recommended for 2-4GB VPS)
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=512MB
POSTGRES_MAX_CONNECTIONS=100

# =============================================================================
# REDIS CONFIGURATION - Phase One Cache
# =============================================================================

# Redis Configuration
# Generate with: openssl rand -base64 24
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD

# Redis URL for application
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@redis:6379/0

# =============================================================================
# OBJECT STORAGE - MinIO S3 Compatible
# =============================================================================

# MinIO Configuration
MINIO_ROOT_USER=schlep_admin
# Generate with: openssl rand -base64 32
MINIO_ROOT_PASSWORD=REPLACE_WITH_MINIO_PASSWORD
MINIO_DOMAIN=minio.schlep-engine.com
MINIO_REGION=us-east-1

# S3 Configuration for Application
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=schlep_admin
S3_SECRET_KEY=REPLACE_WITH_MINIO_PASSWORD
S3_REGION=us-east-1
S3_BUCKET_PREFIX=schlep-

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================

# Grafana Admin Credentials
GRAFANA_ADMIN_USER=admin
# Generate with: openssl rand -base64 16
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_GRAFANA_PASSWORD

# Monitoring Features
ENABLE_MONITORING=true
ENABLE_PERFORMANCE_TRACKING=true

# =============================================================================
# APPLICATION PERFORMANCE TUNING
# =============================================================================

# Connection Pool Configuration (VPS Optimized)
MAX_CONNECTIONS=50
CONNECTION_POOL_SIZE=10
CONNECTION_POOL_MAX_OVERFLOW=20

# Cache Configuration
CACHE_TTL=3600
CACHE_MAX_ENTRIES=10000

# Rate Limiting (VPS Friendly)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# File Upload Limits
UPLOAD_MAX_SIZE=50MB
MAX_FILE_SIZE=50MB

# =============================================================================
# RESOURCE OPTIMIZATION FOR VPS
# =============================================================================

# CPU and Memory Limits (adjust based on your VPS specs)
# For 2GB VPS:
POSTGRES_MEMORY_LIMIT=512M
REDIS_MEMORY_LIMIT=256M
API_MEMORY_LIMIT=256M
NGINX_MEMORY_LIMIT=64M
GRAFANA_MEMORY_LIMIT=128M
PROMETHEUS_MEMORY_LIMIT=256M

# For 4GB VPS (uncomment and use these):
# POSTGRES_MEMORY_LIMIT=1G
# REDIS_MEMORY_LIMIT=512M
# API_MEMORY_LIMIT=512M
# NGINX_MEMORY_LIMIT=128M
# GRAFANA_MEMORY_LIMIT=256M
# PROMETHEUS_MEMORY_LIMIT=512M

# Worker Configuration
ML_WORKERS=1
API_WORKERS=2

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# ML and AI Features
ENABLE_ML_PROCESSING=true
ENABLE_DOCUMENT_EXTRACTION=true
ENABLE_VECTOR_SEARCH=true

# Database Features
ENABLE_DATABASE_MIGRATIONS=true
ENABLE_BACKUP_AUTOMATION=true

# Monitoring Features
ENABLE_PROMETHEUS_METRICS=true
ENABLE_GRAFANA_DASHBOARDS=true
ENABLE_HEALTH_CHECKS=true

# =============================================================================
# BACKUP AND RECOVERY
# =============================================================================

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=7
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
BACKUP_COMPRESSION=gzip

# Recovery Configuration
ENABLE_POINT_IN_TIME_RECOVERY=true
WAL_ARCHIVE_ENABLED=false  # Enable for production

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log Levels
LOG_LEVEL=INFO
DATABASE_LOG_LEVEL=WARNING
REDIS_LOG_LEVEL=NOTICE

# Log Retention
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# Sentry Error Tracking (Optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# =============================================================================
# DEVELOPMENT/TESTING FLAGS
# =============================================================================

# Testing Configuration (disable in production)
ENABLE_TEST_ENDPOINTS=false
ENABLE_DEBUG_LOGGING=false
ENABLE_PROFILING=false

# Development Features (disable in production)
ENABLE_SWAGGER_UI=false
ENABLE_CORS_ALL=false

# =============================================================================
# MIGRATION READINESS (Phase Two Preparation)
# =============================================================================

# YugabyteDB Configuration (for future Phase Two migration)
YUGABYTEDB_ENABLED=false
YUGABYTEDB_HOST=
YUGABYTEDB_PORT=5433
YUGABYTEDB_DATABASE=schlep_engine
YUGABYTEDB_USER=
YUGABYTEDB_PASSWORD=

# DragonflyDB Configuration (for future Phase Two migration)
DRAGONFLY_ENABLED=false
DRAGONFLY_HOST=
DRAGONFLY_PORT=6379
DRAGONFLY_PASSWORD=

# Migration Flags
ENABLE_DUAL_WRITE=false
ENABLE_MIGRATION_MODE=false
MIGRATION_VALIDATION_ENABLED=false

# =============================================================================
# COST OPTIMIZATION
# =============================================================================

# Resource Monitoring
COST_TRACKING_ENABLED=true
RESOURCE_USAGE_ALERTS=true
COST_LIMIT_MONTHLY=25  # USD for VPS monitoring

# Auto-scaling (when traffic increases)
AUTO_SCALING_ENABLED=false
SCALE_UP_THRESHOLD_CPU=80
SCALE_UP_THRESHOLD_MEMORY=85

# Cleanup Automation
AUTO_CLEANUP_LOGS=true
AUTO_CLEANUP_TEMP_FILES=true
AUTO_CLEANUP_CACHE=true

# =============================================================================
# HEALTH CHECK CONFIGURATION
# =============================================================================

# Health Check Intervals
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3

# Service Health Endpoints
POSTGRES_HEALTH_CHECK=true
REDIS_HEALTH_CHECK=true
MINIO_HEALTH_CHECK=true
API_HEALTH_CHECK=true

# =============================================================================
# NETWORK CONFIGURATION
# =============================================================================

# Network Configuration
NETWORK_MODE=bridge
ENABLE_IPV6=false

# SSL/TLS Configuration
SSL_ENABLED=true
SSL_CERTIFICATE_PATH=/etc/ssl/certs
SSL_PRIVATE_KEY_PATH=/etc/ssl/private

# Cloudflare Integration
CLOUDFLARE_ENABLED=true
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# =============================================================================
# VULTR VPS SPECIFIC OPTIMIZATIONS
# =============================================================================

# VPS Resource Optimization
VPS_PLAN=vc2-1c-2gb  # Adjust to your actual Vultr plan
VPS_REGION=ewr  # Adjust to your VPS region
VPS_OPTIMIZATION_ENABLED=true

# Storage Optimization
ENABLE_SSD_OPTIMIZATION=true
ENABLE_COMPRESSION=true
ENABLE_DEDUPLICATION=false

# Network Optimization
ENABLE_CDN=true
ENABLE_GZIP_COMPRESSION=true
ENABLE_CACHING_HEADERS=true

# =============================================================================
# EMERGENCY CONFIGURATION
# =============================================================================

# Emergency Contacts and Procedures
EMERGENCY_EMAIL=admin@schlep-engine.com
EMERGENCY_WEBHOOK=
EMERGENCY_PHONE=

# Circuit Breaker Configuration
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60

# Graceful Degradation
ENABLE_GRACEFUL_DEGRADATION=true
FALLBACK_MODE_ENABLED=true