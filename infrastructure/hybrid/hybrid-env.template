# Hybrid Architecture Environment Configuration Template
# Schlep Engine - Railway + Supabase Setup
# 
# SECURITY NOTE: Never commit actual secrets to version control.
# Use platform-specific secret management for sensitive values.

# =============================================================================
# DEPLOYMENT ENVIRONMENT
# =============================================================================

# Environment Configuration
ENVIRONMENT=production
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# =============================================================================
# DOMAIN AND CORS CONFIGURATION
# =============================================================================

# Primary Domain
PRIMARY_DOMAIN=schlep-engine.com

# Application URLs
LANDING_URL=https://schlep-engine.com
ADMIN_URL=https://admin.schlep-engine.com
DOCS_URL=https://docs.schlep-engine.com
API_URL=https://api.schlep-engine.com

# CORS Origins (comma-separated)
CORS_ORIGINS=https://schlep-engine.com,https://admin.schlep-engine.com,https://docs.schlep-engine.com,https://api.schlep-engine.com

# Allowed Hosts
ALLOWED_HOSTS=api.schlep-engine.com,*.railway.app,localhost

# =============================================================================
# SUPABASE DATABASE CONFIGURATION
# =============================================================================

# Supabase Project Configuration
# Get these from your Supabase project settings
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Database Connection
# Use Supabase connection string format
DATABASE_URL=postgresql://postgres:[password]@db.[project-id].supabase.co:5432/postgres
SUPABASE_DATABASE_URL=postgresql://postgres:[password]@db.[project-id].supabase.co:5432/postgres

# Database Pool Configuration
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_ECHO=false

# =============================================================================
# RAILWAY REDIS CONFIGURATION
# =============================================================================

# Redis Configuration (Railway managed)
# Railway will provide this automatically
REDIS_URL=${{Redis.REDIS_URL}}
REDIS_PASSWORD=${{Redis.REDIS_PASSWORD}}
REDIS_DB=0

# Redis Connection Settings
REDIS_MAX_CONNECTIONS=30
REDIS_RETRY_ON_TIMEOUT=true
REDIS_SOCKET_KEEPALIVE=true
REDIS_SOCKET_KEEPALIVE_OPTIONS=true

# Redis Cache Configuration
CACHE_REDIS_URL=${{Redis.REDIS_URL}}/1
CACHE_DEFAULT_TIMEOUT=300
CACHE_MAX_SIZE=1000

# =============================================================================
# AUTHENTICATION AND SECURITY
# =============================================================================

# JWT Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Session Configuration
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax
SESSION_MAX_AGE=86400

# Security Headers
ENABLE_SECURITY_HEADERS=true
FORCE_HTTPS=true
ENABLE_HSTS=true
HSTS_MAX_AGE=31536000

# CSRF Protection
CSRF_COOKIE_SECURE=true
CSRF_COOKIE_HTTPONLY=true
CSRF_COOKIE_SAMESITE=strict

# =============================================================================
# SUPABASE AUTHENTICATION INTEGRATION
# =============================================================================

# Supabase Auth Configuration
SUPABASE_AUTH_ENABLED=true
SUPABASE_AUTH_AUTO_REFRESH=true
SUPABASE_AUTH_PERSIST_SESSION=true

# OAuth Providers (configure in Supabase dashboard)
ENABLE_GOOGLE_AUTH=true
ENABLE_GITHUB_AUTH=true
ENABLE_MICROSOFT_AUTH=false

# Auth Redirects
AUTH_REDIRECT_URL=https://admin.schlep-engine.com/auth/callback
AUTH_SUCCESS_REDIRECT=https://admin.schlep-engine.com/dashboard
AUTH_ERROR_REDIRECT=https://admin.schlep-engine.com/auth/error

# =============================================================================
# CELERY BACKGROUND PROCESSING
# =============================================================================

# Celery Broker Configuration (Redis)
CELERY_BROKER_URL=${{Redis.REDIS_URL}}/0
CELERY_RESULT_BACKEND=${{Redis.REDIS_URL}}/1

# Celery Worker Configuration
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_MAX_TASKS_PER_CHILD=1000
CELERY_WORKER_MAX_MEMORY_PER_CHILD=200000  # 200MB

# Celery Task Configuration
CELERY_TASK_TIME_LIMIT=600           # 10 minutes
CELERY_TASK_SOFT_TIME_LIMIT=540      # 9 minutes
CELERY_TASK_ROUTES={}
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=['json']

# Celery Beat (Scheduler)
CELERY_BEAT_SCHEDULE_FILENAME=/app/celerybeat-schedule
CELERY_TIMEZONE=UTC
CELERY_ENABLE_UTC=true

# =============================================================================
# ML AND AI CONFIGURATION
# =============================================================================

# ML Processing Configuration
ML_WORKERS=4
ML_BATCH_SIZE=32
ML_MAX_PARALLEL_JOBS=4
ML_MEMORY_LIMIT=6144
ML_TIMEOUT=300
ML_MODEL_CACHE_SIZE=2000

# TensorFlow Configuration
TENSORFLOW_INTER_OP_PARALLELISM_THREADS=4
TENSORFLOW_INTRA_OP_PARALLELISM_THREADS=4
TF_CPP_MIN_LOG_LEVEL=2
TF_ENABLE_ONEDNN_OPTS=0
CUDA_VISIBLE_DEVICES=-1  # CPU-only for Railway

# PyTorch Configuration
TORCH_NUM_THREADS=4
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
PYTORCH_ENABLE_MPS_FALLBACK=1

# Hugging Face Configuration
TRANSFORMERS_CACHE=/app/cache/transformers
HF_HOME=/app/cache/huggingface
HF_HUB_CACHE=/app/cache/hub
TRANSFORMERS_OFFLINE=false

# OpenAI API (for embeddings and GPT models)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# =============================================================================
# SUPABASE STORAGE CONFIGURATION
# =============================================================================

# Supabase Storage
SUPABASE_STORAGE_BUCKET=schlep-engine-documents
SUPABASE_STORAGE_URL=https://your-project-id.supabase.co/storage/v1
ENABLE_LOCAL_STORAGE=false

# File Upload Configuration
MAX_UPLOAD_SIZE=104857600  # 100MB
ALLOWED_FILE_TYPES=csv,xlsx,xls,json,parquet,pdf,txt,png,jpg,jpeg,docx
UPLOAD_TIMEOUT=120
UPLOAD_DIR=/app/uploads  # Temporary local storage

# Document Processing
ENABLE_OCR=true
OCR_LANGUAGE=eng
PDF_MAX_PAGES=100

# =============================================================================
# API RATE LIMITING
# =============================================================================

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_PERIOD=60
RATE_LIMIT_BURST=50
RATE_LIMIT_STORAGE_URL=${{Redis.REDIS_URL}}/2

# API Key Rate Limits
API_KEY_RATE_LIMIT=5000
API_KEY_RATE_PERIOD=3600

# Tier-based Rate Limits
FREE_TIER_LIMIT=100
STARTER_TIER_LIMIT=1000
PRO_TIER_LIMIT=10000
ENTERPRISE_TIER_LIMIT=100000

# =============================================================================
# SUPABASE REAL-TIME CONFIGURATION
# =============================================================================

# Real-time Features
ENABLE_SUPABASE_REALTIME=true
REALTIME_SCHEMA=public
REALTIME_TABLES=jobs,user_profiles,api_usage

# WebSocket Configuration
WEBSOCKET_ENABLED=true
WEBSOCKET_MAX_CONNECTIONS=1000
WEBSOCKET_PING_INTERVAL=30
WEBSOCKET_PING_TIMEOUT=10

# =============================================================================
# MONITORING AND OBSERVABILITY
# =============================================================================

# Prometheus Metrics
PROMETHEUS_METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_PATH=/metrics
ENABLE_CUSTOM_METRICS=true

# Sentry Error Tracking
SENTRY_DSN=your-sentry-dsn
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
SENTRY_RELEASE=1.0.0

# Application Performance Monitoring
APM_ENABLED=true
APM_SERVICE_NAME=schlep-engine-api
APM_ENVIRONMENT=production

# Logging Configuration
LOG_FORMAT=json
LOG_FILE=/app/logs/app.log
LOG_MAX_SIZE=100MB
LOG_BACKUP_COUNT=5
LOG_ROTATION=daily

# Component Logging Levels
DB_LOG_LEVEL=WARNING
REDIS_LOG_LEVEL=WARNING
CELERY_LOG_LEVEL=INFO
ML_LOG_LEVEL=INFO
SUPABASE_LOG_LEVEL=INFO

# =============================================================================
# HEALTH CHECKS AND READINESS
# =============================================================================

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_TIMEOUT=30
HEALTH_CHECK_INTERVAL=60

# Readiness Probe
READINESS_CHECK_ENABLED=true
READINESS_CHECK_TIMEOUT=10
READINESS_CHECK_DEPENDENCIES=supabase,redis

# Liveness Probe
LIVENESS_CHECK_ENABLED=true
LIVENESS_CHECK_TIMEOUT=5

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Core Features
ENABLE_ML_PROCESSING=true
ENABLE_DOCUMENT_EXTRACTION=true
ENABLE_DATA_QUALITY_CHECKS=true
ENABLE_SEMANTIC_SEARCH=true
ENABLE_REAL_TIME_PROCESSING=true
ENABLE_VECTOR_SEARCH=true

# Advanced Features
ENABLE_COLLABORATIVE_FEATURES=true
ENABLE_API_VERSIONING=true
ENABLE_AUDIT_LOGGING=true
ENABLE_MULTI_TENANCY=true

# Beta Features
ENABLE_EXPERIMENTAL_FEATURES=false
ENABLE_ADVANCED_ANALYTICS=true
ENABLE_AUTO_ML=false

# =============================================================================
# UVICORN/GUNICORN CONFIGURATION
# =============================================================================

# Server Configuration
WORKERS=4
MAX_WORKER_CONNECTIONS=1000
WORKER_CLASS=uvicorn.workers.UvicornWorker
KEEP_ALIVE=30
TIMEOUT=300
GRACEFUL_TIMEOUT=30
MAX_REQUESTS=1000
MAX_REQUESTS_JITTER=100

# Memory Management
MALLOC_TRIM_THRESHOLD=131072
MALLOC_MMAP_THRESHOLD=131072
PYTHONMALLOC=malloc
PYTHONHASHSEED=random

# =============================================================================
# THIRD-PARTY INTEGRATIONS
# =============================================================================

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@schlep-engine.com
SMTP_USE_TLS=true

# Slack Integration (for alerts)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
SLACK_CHANNEL=#alerts

# LemonSqueezy (Payments)
LEMONSQUEEZY_API_KEY=your-lemonsqueezy-api-key
LEMONSQUEEZY_STORE_ID=your-store-id
LEMONSQUEEZY_WEBHOOK_SECRET=your-webhook-secret

# =============================================================================
# COMPLIANCE AND AUDIT
# =============================================================================

# Data Protection
ENABLE_DATA_ENCRYPTION=true
ENABLE_PII_DETECTION=true
ENABLE_AUDIT_LOGGING=true
ENABLE_DATA_RETENTION_POLICY=true

# GDPR Compliance
ENABLE_RIGHT_TO_ERASURE=true
ENABLE_DATA_PORTABILITY=true
DATA_RETENTION_DAYS=365
ENABLE_CONSENT_MANAGEMENT=true

# Audit Configuration
AUDIT_LOG_LEVEL=INFO
AUDIT_LOG_FILE=/app/logs/audit.log
ENABLE_REQUEST_LOGGING=true

# =============================================================================
# RAILWAY-SPECIFIC VARIABLES
# =============================================================================

# Railway automatically provides these variables:
# ${{RAILWAY_ENVIRONMENT}}
# ${{RAILWAY_SERVICE_NAME}}
# ${{RAILWAY_DEPLOYMENT_ID}}
# ${{RAILWAY_PROJECT_ID}}
# ${{RAILWAY_GIT_COMMIT_SHA}}
# ${{RAILWAY_GIT_BRANCH}}

# Railway Redis automatically provides:
# ${{Redis.REDIS_URL}}
# ${{Redis.REDIS_PASSWORD}}

# =============================================================================
# EXAMPLE VALUES FOR DEVELOPMENT
# =============================================================================

# Example values for local development (DO NOT use in production)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/schlep_engine_dev
# REDIS_URL=redis://localhost:6379/0
# SECRET_KEY=dev-secret-key-not-for-production-use-only
# SUPABASE_URL=http://localhost:54321
# SUPABASE_ANON_KEY=your-local-anon-key

# =============================================================================
# DEPLOYMENT NOTES
# =============================================================================

# 1. Create Supabase project and get connection details
# 2. Set up Railway project with Redis addon
# 3. Configure environment variables in Railway dashboard
# 4. Deploy using Railway CLI or GitHub integration
# 5. Run database migrations in Supabase
# 6. Test all endpoints and features
# 7. Set up monitoring and alerts
# 8. Configure custom domain and SSL

# Railway Environment Variables to Set:
# - All SUPABASE_* variables
# - SECRET_KEY (generate new one)
# - SENTRY_DSN (if using Sentry)
# - OPENAI_API_KEY (if using OpenAI)
# - EMAIL configuration for notifications

# Supabase Setup Required:
# 1. Create project at https://supabase.com
# 2. Run the schema.sql file to create tables
# 3. Configure authentication providers
# 4. Set up storage buckets
# 5. Configure Row Level Security policies
# 6. Set up real-time subscriptions