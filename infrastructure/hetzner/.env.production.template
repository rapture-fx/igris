# =============================================================================
# SCHLEP ENGINE - PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this to .env.production and fill in your values
# =============================================================================

# =============================================================================
# CORE CONFIGURATION
# =============================================================================
ENVIRONMENT=production
DEBUG=false
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# Security Keys (GENERATE NEW ONES!)
SECRET_KEY=your-super-secret-key-here-32-chars-minimum
JWT_SECRET_KEY=your-jwt-secret-key-here-32-chars-minimum
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_DB=schlep_engine
POSTGRES_USER=schlep_user
POSTGRES_PASSWORD=your-super-secure-db-password-here
DATABASE_URL=postgresql://schlep_user:your-super-secure-db-password-here@postgres:5432/schlep_engine

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_PASSWORD=your-redis-password-here
REDIS_URL=redis://redis:6379

# =============================================================================
# DOMAIN CONFIGURATION
# =============================================================================
API_URL=https://api.schlep-engine.com
FRONTEND_URL=https://schlep-engine.com
ADMIN_URL=https://admin.schlep-engine.com
DOCS_URL=https://docs.schlep-engine.com

# CORS Settings (adjust based on your domains)
ALLOWED_ORIGINS=["https://schlep-engine.com","https://admin.schlep-engine.com","https://docs.schlep-engine.com"]
ALLOWED_HOSTS=["api.schlep-engine.com","schlep-engine.com"]

# =============================================================================
# STORAGE CONFIGURATION
# =============================================================================
UPLOAD_MAX_SIZE=100MB
STORAGE_PATH=/app/storage
ENABLE_LOCAL_STORAGE=true

# =============================================================================
# MACHINE LEARNING CONFIGURATION
# =============================================================================
ML_WORKERS=2
ML_BATCH_SIZE=16
ENABLE_ML_PROCESSING=true
TENSORFLOW_INTER_OP_PARALLELISM_THREADS=2
TENSORFLOW_INTRA_OP_PARALLELISM_THREADS=2

# =============================================================================
# FEATURE TOGGLES
# =============================================================================
ENABLE_DOCUMENT_EXTRACTION=true
ENABLE_VECTOR_SEARCH=true
ENABLE_ADVANCED_ML=true
ENABLE_BATCH_PROCESSING=true
ENABLE_REAL_TIME_PROCESSING=true

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_PERIOD=60

# =============================================================================
# MONITORING & LOGGING
# =============================================================================
SENTRY_DSN=your-sentry-dsn-if-using
SENTRY_ENVIRONMENT=production

# =============================================================================
# EXTERNAL SERVICES (Add your own keys)
# =============================================================================
# LemonSqueezy (Payment Processing)
LEMONSQUEEZY_API_KEY=your-lemonsqueezy-api-key
LEMONSQUEEZY_WEBHOOK_SECRET=your-webhook-secret
LEMONSQUEEZY_STORE_ID=your-store-id

# OAuth Providers
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Email Service (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# Encryption for sensitive data
ENCRYPTION_KEY=your-32-character-encryption-key

# Session configuration
SESSION_TIMEOUT_MINUTES=60
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================
# API Workers (adjust based on your server specs)
API_WORKERS=2
API_MAX_CONNECTIONS=1000
API_KEEPALIVE=2

# Database connection pooling
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Cache settings
CACHE_DEFAULT_TIMEOUT=300
CACHE_MAX_ENTRIES=10000

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=your-backup-bucket
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=eu-central-1