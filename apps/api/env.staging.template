# ==================== STAGING ENVIRONMENT CONFIGURATION ====================
# This file contains staging-specific configuration values.
# DO NOT commit secrets to version control - use environment variables or secrets manager.

# ==================== CORE APPLICATION SETTINGS ====================
ENVIRONMENT=staging
DEBUG=false
TESTING_MODE=false

# ==================== DATABASE SETTINGS ====================
# Database connection URL (set via environment variable in deployment)
DATABASE_URL=postgresql://postgres:password@staging-db:5432/schlep_engine_staging

# Database connection components (for backward compatibility)
DB_HOST=staging-db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=schlep_engine_staging

# Connection pooling settings (optimized for staging load)
DB_POOL_SIZE=25
DB_MAX_OVERFLOW=40

# ==================== REDIS SETTINGS ====================
REDIS_URL=redis://staging-redis:6379/0
REDIS_HOST=staging-redis
REDIS_PORT=6379
REDIS_DB=0

# ==================== JWT SETTINGS ====================
# IMPORTANT: Set these via environment variables or secrets manager
JWT_SECRET_KEY=your_staging_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==================== SECURITY SETTINGS ====================
# IMPORTANT: Set these via environment variables or secrets manager
ENCRYPTION_KEY=your_staging_encryption_key_here

# Rate limiting (moderate for staging)
RATE_LIMIT_PER_MINUTE=200
RATE_LIMIT_PER_HOUR=5000

# Security features
ENHANCED_AUTH_ENABLED=true

# ==================== CORS SETTINGS ====================
BACKEND_CORS_ORIGINS=https://staging.schlep-engine.com,https://staging-admin.schlep-engine.com

# ==================== FILE UPLOAD SETTINGS ====================
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=100MB
ALLOWED_FILE_TYPES=csv,json,xlsx,xls,txt,parquet

# ==================== CLOUD STORAGE SETTINGS ====================
# Google Cloud Storage Configuration
CLOUD_STORAGE_ENABLED=true
CLOUD_STORAGE_PROVIDER=gcs
GCS_BUCKET_NAME=schlep-engine-staging-uploads
GCS_PROJECT_ID=your-gcs-project-id
GCS_CREDENTIALS_PATH=/app/gcs-credentials.json
GCS_REGION=us-central1

# File retention and cleanup settings
FILE_RETENTION_DAYS=7
ENABLE_AUTOMATIC_CLEANUP=true
CLEANUP_BATCH_SIZE=200

# ==================== CDN SETTINGS ====================
# CDN Configuration for staging
CDN_ENABLED=true
CDN_PROVIDER=cloudflare
CDN_DOMAIN=staging-cdn.schlep-engine.com
CDN_API_TOKEN=your-staging-cdn-api-token

# Cache settings
CDN_CACHE_DURATION=1800
CDN_CACHE_HEADERS=true

# ==================== CELERY SETTINGS ====================
CELERY_BROKER_URL=redis://staging-redis:6379/0
CELERY_RESULT_BACKEND=redis://staging-redis:6379/1

# ==================== EXTERNAL SERVICES ====================
# LemonSqueezy (use staging keys)
LEMONSQUEEZY_API_KEY=your_staging_lemonsqueezy_api_key_here
LEMONSQUEEZY_WEBHOOK_SECRET=your_staging_lemonsqueezy_webhook_secret_here

# AI Model Settings
MODEL_PATH=/app/models/
BATCH_SIZE=64

# ==================== MONITORING SETTINGS ====================
ENABLE_METRICS=true
PROMETHEUS_MULTIPROC_DIR=/tmp

# ==================== SSL/TLS CONFIGURATION ====================
# SSL is required in staging - set these via environment variables or secrets manager
# SSL_CERT_PATH=/path/to/staging.crt
# SSL_KEY_PATH=/path/to/staging.key
# SSL_CA_PATH=/path/to/staging_ca.crt

# ==================== SECURITY FEATURE FLAGS ====================
# Staging-specific security settings (production-like but with some debugging)
SECURITY_ENCRYPTION_ENABLED=true
SECURITY_AUDIT_ENABLED=true
SECURITY_MFA_ENABLED=false
SECURITY_MONITORING_ENABLED=true
SECURITY_PERMISSIONS_ENABLED=true
SECURITY_RATE_LIMITING_ENABLED=true
SECURITY_HEADERS_ENABLED=true
SECURITY_PII_DETECTION_ENABLED=true
SECURITY_COMPLIANCE_ENABLED=true
SECURITY_DATA_CLASSIFICATION_ENABLED=true 