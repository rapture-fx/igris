# LemonSqueezy Configuration (production credentials)
LEMONSQUEEZY_API_KEY=${LEMONSQUEEZY_API_KEY}
LEMONSQUEEZY_WEBHOOK_SECRET=${LEMONSQUEEZY_WEBHOOK_SECRET}
LEMONSQUEEZY_STORE_ID=${LEMONSQUEEZY_STORE_ID}

# RL Optimization Configuration
RL_ENABLED=true
RL_MAX_CONCURRENT_SESSIONS=5
RL_DEFAULT_MAX_EPISODES=50
RL_DEFAULT_STRATEGY=ppo
RL_CHECKPOINT_DIRECTORY=./checkpoints/rl_optimization/
RL_LOGS_DIRECTORY=./logs/rl_optimization/
RL_TENSORBOARD_ENABLED=true
RL_PROMETHEUS_METRICS_ENABLED=true

# RL Resource Limits
RL_MAX_CPU_CORES_PER_SESSION=4
RL_MAX_MEMORY_GB_PER_SESSION=16
RL_MAX_TRAINING_TIME_SECONDS=3600
RL_EARLY_STOPPING_PATIENCE=10

# RL Model Configuration
RL_LEARNING_RATE=3e-4
RL_BATCH_SIZE=64
RL_N_STEPS=2048
RL_GAMMA=0.99
RL_GAE_LAMBDA=0.95

# RL Storage Configuration
RL_S3_BUCKET=${RL_S3_BUCKET}
RL_S3_ACCESS_KEY=${RL_S3_ACCESS_KEY}
RL_S3_SECRET_KEY=${RL_S3_SECRET_KEY}
RL_S3_REGION=us-east-1

# RL Monitoring Configuration
RL_ALERT_WEBHOOK_URL=${RL_ALERT_WEBHOOK_URL}
RL_MONITORING_INTERVAL_SECONDS=30
RL_PERFORMANCE_THRESHOLD_MIN=0.01
RL_RESOURCE_ALERT_THRESHOLD_CPU=80
RL_RESOURCE_ALERT_THRESHOLD_MEMORY=85 