# Test Environment Variables for Pytest
# DO NOT USE THESE VALUES IN PRODUCTION

# Core Settings
SECRET_KEY="dummy_secret_key_for_testing_purposes_only_1234567890"
JWT_SECRET_KEY="dummy_jwt_secret_key_for_testing_1234567890"
ENCRYPTION_KEY="dummy_encryption_key_for_testing_12345678901234567890123456789012"

# Database URL (use a test database if available, otherwise a dummy value)
ASYNC_DATABASE_URI="postgresql+asyncpg://testuser:testpassword@localhost:5432/testdb"
DATABASE_URL="postgresql://testuser:testpassword@localhost:5432/testdb"

# Celery Broker
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"

# OAuth Credentials (dummy values)
GOOGLE_CLIENT_ID="dummy_google_client_id"
GOOGLE_CLIENT_SECRET="dummy_google_client_secret"
GITHUB_CLIENT_ID="dummy_github_client_id"
GITHUB_CLIENT_SECRET="dummy_github_client_secret"

# Safe Data Directory for Tests
SAFE_DATA_DIRECTORY="/tmp/safe_test_data"
