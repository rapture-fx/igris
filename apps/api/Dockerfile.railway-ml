# Railway-Optimized ML Service Dockerfile
# Schlep-engine ML Service for Railway deployment
# Optimized for: 4GB RAM, CPU-only, fast startup, efficient caching

# Use Python 3.11 slim for better performance and smaller size
FROM python:3.11-slim as base

# Railway-specific environment variables for ML optimization
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONHASHSEED=random \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=300 \
    # CPU optimization for Railway (4 vCPU limit)
    TORCH_NUM_THREADS=4 \
    OMP_NUM_THREADS=4 \
    MKL_NUM_THREADS=4 \
    OPENBLAS_NUM_THREADS=4 \
    # Memory optimization for 4GB RAM limit
    PYTHONMALLOC=malloc \
    MALLOC_ARENA_MAX=2 \
    # TensorFlow CPU optimization
    TF_CPP_MIN_LOG_LEVEL=2 \
    TF_ENABLE_ONEDNN_OPTS=1 \
    # Transformers optimization
    TRANSFORMERS_OFFLINE=0 \
    HF_HUB_DISABLE_TELEMETRY=1 \
    # FastAPI optimization
    FASTAPI_ENV=production \
    # Railway port
    PORT=8000

# Create non-root user for security
RUN groupadd -r railwayml && useradd -r -g railwayml railwayml

# Install system dependencies (minimal for Railway)
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Build essentials for ML libraries
    gcc \
    g++ \
    libc6-dev \
    # PostgreSQL client
    libpq-dev \
    # BLAS/LAPACK for numpy/scipy
    libopenblas-dev \
    liblapack-dev \
    # Image processing
    libjpeg-dev \
    libpng-dev \
    # Tesseract OCR
    tesseract-ocr \
    tesseract-ocr-eng \
    # PDF processing
    poppler-utils \
    # Compression
    liblz4-dev \
    # Health check utility
    curl \
    # Clean up
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Set work directory
WORKDIR /app

# Multi-stage build for optimization
FROM base as builder

# Copy requirements first for better Docker layer caching
COPY requirements-railway-ml.txt /tmp/requirements.txt

# Install Python dependencies in user directory (more efficient)
RUN pip install --upgrade pip setuptools wheel && \
    # Install CPU-only PyTorch first (Railway optimization)
    pip install --user --no-warn-script-location \
        torch==2.1.1+cpu \
        torchvision==0.16.1+cpu \
        torchaudio==2.1.1+cpu \
        --extra-index-url https://download.pytorch.org/whl/cpu && \
    # Install TensorFlow CPU
    pip install --user --no-warn-script-location tensorflow-cpu==2.15.0 && \
    # Install remaining ML dependencies
    pip install --user --no-warn-script-location -r /tmp/requirements.txt && \
    # Clean up pip cache
    pip cache purge

# Production stage
FROM base as production

# Copy installed packages from builder stage
COPY --from=builder /root/.local /root/.local

# Update PATH to include user-installed packages
ENV PATH=/root/.local/bin:$PATH

# Create necessary directories with proper permissions
RUN mkdir -p /app/models /app/data /app/logs /app/cache /app/temp && \
    chown -R railwayml:railwayml /app

# Copy application code (optimized order for caching)
COPY app/core/ /app/app/core/
COPY app/database/ /app/app/database/
COPY app/auth/ /app/app/auth/
COPY app/middleware/ /app/app/middleware/

# Copy ML services
COPY app/services/advanced_ml_engine.py /app/app/services/
COPY app/services/ai_framework_integration.py /app/app/services/
COPY app/services/advanced_auto_labeler.py /app/app/services/
COPY app/services/transformation_engine.py /app/app/services/
COPY app/services/ml_service_client.py /app/app/services/
COPY app/services/ai_engine.py /app/app/services/
COPY app/services/__init__.py /app/app/services/

# Copy main application files
COPY app/__init__.py /app/app/
COPY app/main.py /app/app/
COPY ml_service_main.py /app/

# Copy startup script
COPY scripts/start-ml-service.sh /app/scripts/
RUN chmod +x /app/scripts/start-ml-service.sh

# Create Railway-specific configuration
RUN echo '#!/bin/bash\n\
# Railway ML Service Health Check\n\
curl -f http://localhost:$PORT/health || exit 1\n\
' > /app/health-check.sh && chmod +x /app/health-check.sh

# Switch to non-root user
USER railwayml

# Expose Railway port
EXPOSE $PORT

# Railway-optimized health check (faster intervals for Railway)
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD /app/health-check.sh

# Pre-load ML models and cache (Railway optimization)
RUN python -c "\
import warnings; warnings.filterwarnings('ignore'); \
import numpy as np; \
import pandas as pd; \
import sklearn; \
print('Core ML libraries loaded successfully'); \
try: \
    import torch; \
    print('PyTorch loaded successfully'); \
except Exception as e: \
    print(f'PyTorch warning: {e}'); \
try: \
    import tensorflow as tf; \
    print('TensorFlow loaded successfully'); \
except Exception as e: \
    print(f'TensorFlow warning: {e}'); \
"

# Railway deployment command (use startup script for flexibility)
CMD ["/app/scripts/start-ml-service.sh"]

# Railway build optimization labels
LABEL \
    org.opencontainers.image.title="Schlep-engine ML Service" \
    org.opencontainers.image.description="Railway-optimized ML service with TensorFlow, PyTorch, and scikit-learn" \
    org.opencontainers.image.version="1.0.0" \
    railway.deployment.type="ml-service" \
    railway.optimization.cpu="true" \
    railway.optimization.memory="4gb" \
    railway.optimization.startup="fast"