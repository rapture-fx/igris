{
  "dashboard": {
    "id": null,
    "title": "RL Optimization System Dashboard",
    "tags": ["rl", "optimization", "machine-learning"],
    "style": "dark",
    "timezone": "browser",
    "refresh": "30s",
    "schemaVersion": 30,
    "version": 1,
    "panels": [
      {
        "id": 1,
        "title": "Active RL Sessions",
        "type": "stat",
        "targets": [
          {
            "expr": "rl_active_sessions_count",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "unit": "short",
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 3},
                {"color": "red", "value": 5}
              ]
            }
          }
        },
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Optimization Queue Size",
        "type": "stat",
        "targets": [
          {
            "expr": "rl_optimization_queue_size",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "unit": "short",
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 5},
                {"color": "red", "value": 10}
              ]
            }
          }
        },
        "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0}
      },
      {
        "id": 3,
        "title": "Session Success Rate",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(rl_optimization_sessions_total{status=\"completed\"}[5m]) / rate(rl_optimization_sessions_total[5m]) * 100",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "unit": "percent",
            "thresholds": {
              "steps": [
                {"color": "red", "value": null},
                {"color": "yellow", "value": 70},
                {"color": "green", "value": 85}
              ]
            }
          }
        },
        "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0}
      },
      {
        "id": 4,
        "title": "Average Episode Duration",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(rl_episode_duration_seconds_sum[5m]) / rate(rl_episode_duration_seconds_count[5m])",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "unit": "s"
          }
        },
        "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0}
      },
      {
        "id": 5,
        "title": "Episode Rewards Over Time",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rl_episode_reward",
            "refId": "A",
            "legendFormat": "{{session_id}} - {{strategy}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "unit": "short",
            "min": 0,
            "max": 1
          }
        },
        "gridPos": {"h": 9, "w": 12, "x": 0, "y": 8}
      },
      {
        "id": 6,
        "title": "Session Performance by Strategy",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rl_session_best_performance",
            "refId": "A",
            "legendFormat": "{{strategy}} - {{pipeline_id}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "unit": "short"
          }
        },
        "gridPos": {"h": 9, "w": 12, "x": 12, "y": 8}
      },
      {
        "id": 7,
        "title": "Resource Utilization",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rl_resource_utilization_percent{resource_type=\"cpu\"}",
            "refId": "A",
            "legendFormat": "CPU - {{session_id}}"
          },
          {
            "expr": "rl_resource_utilization_percent{resource_type=\"memory\"}",
            "refId": "B",
            "legendFormat": "Memory - {{session_id}}"
          },
          {
            "expr": "rl_resource_utilization_percent{resource_type=\"disk\"}",
            "refId": "C",
            "legendFormat": "Disk - {{session_id}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "unit": "percent",
            "min": 0,
            "max": 100
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 17}
      },
      {
        "id": 8,
        "title": "Training Time by Strategy",
        "type": "barchart",
        "targets": [
          {
            "expr": "sum by (strategy) (rate(rl_training_time_seconds_total[1h]))",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "unit": "s"
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 17}
      },
      {
        "id": 9,
        "title": "Convergence Analysis",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rl_convergence_episode_number",
            "refId": "A",
            "legendFormat": "{{strategy}} - Session {{session_id}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "unit": "short"
          }
        },
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 25}
      },
      {
        "id": 10,
        "title": "Model Accuracy Distribution",
        "type": "histogram",
        "targets": [
          {
            "expr": "rl_optimized_model_accuracy",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "unit": "short",
            "min": 0,
            "max": 1
          }
        },
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 25}
      },
      {
        "id": 11,
        "title": "System Errors",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(rl_system_errors_total[5m])",
            "refId": "A",
            "legendFormat": "{{error_type}} - {{component}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "unit": "rps"
          }
        },
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 25}
      },
      {
        "id": 12,
        "title": "Performance Improvement",
        "type": "table",
        "targets": [
          {
            "expr": "rl_optimization_improvement_percent",
            "refId": "A",
            "format": "table"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "unit": "percent"
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 33}
      },
      {
        "id": 13,
        "title": "Hyperparameter Trial Rate",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(rl_hyperparameter_trials_total[5m])",
            "refId": "A",
            "legendFormat": "{{strategy}} trials/sec"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "unit": "rps"
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 33}
      },
      {
        "id": 14,
        "title": "Session Duration Distribution",
        "type": "heatmap",
        "targets": [
          {
            "expr": "rate(rl_episode_duration_seconds_bucket[5m])",
            "refId": "A",
            "format": "heatmap",
            "legendFormat": "{{le}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "spectrum"
            },
            "unit": "s"
          }
        },
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 41}
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
    }
  }
}