{
  "dashboard": {
    "id": null,
    "title": "Schlep Engine - Rust Kernel Performance",
    "description": "Enterprise-grade monitoring for hybrid Python + Rust architecture",
    "tags": ["schlep-engine", "rust-kernels", "performance", "enterprise"],
    "style": "dark",
    "timezone": "browser",
    "editable": true,
    "graphTooltip": 1,
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {
      "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
    },
    "templating": {
      "list": [
        {
          "name": "operation",
          "type": "query",
          "label": "Operation",
          "query": "label_values(schlep_rust_kernel_requests_total, operation)",
          "multi": true,
          "includeAll": true,
          "allValue": ".*",
          "refresh": 1
        },
        {
          "name": "acceleration_type",
          "type": "query",
          "label": "Acceleration Type",
          "query": "label_values(schlep_rust_kernel_requests_total, acceleration_type)",
          "multi": true,
          "includeAll": true,
          "allValue": ".*",
          "refresh": 1
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "title": "🚀 Rust Kernel Overview",
        "type": "stat",
        "gridPos": {"h": 4, "w": 24, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "schlep_rust_kernel_availability",
            "legendFormat": "Kernel Available",
            "refId": "A"
          },
          {
            "expr": "sum(rate(schlep_rust_kernel_requests_total{status=\"success\"}[5m]))",
            "legendFormat": "Requests/sec",
            "refId": "B"
          },
          {
            "expr": "avg(schlep_rust_kernel_performance_gain_ratio)",
            "legendFormat": "Avg Performance Gain",
            "refId": "C"
          },
          {
            "expr": "avg(schlep_rust_kernel_fallback_rate_percent)",
            "legendFormat": "Fallback Rate %",
            "refId": "D"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": {"mode": "palette-classic"},
            "custom": {
              "displayMode": "lcd",
              "orientation": "horizontal"
            }
          },
          "overrides": [
            {
              "matcher": {"id": "byName", "options": "Kernel Available"},
              "properties": [
                {"id": "unit", "value": "bool"},
                {"id": "color", "value": {"fixedColor": "green", "mode": "fixed"}}
              ]
            },
            {
              "matcher": {"id": "byName", "options": "Avg Performance Gain"},
              "properties": [
                {"id": "unit", "value": "percentunit"},
                {"id": "color", "value": {"fixedColor": "blue", "mode": "fixed"}}
              ]
            },
            {
              "matcher": {"id": "byName", "options": "Fallback Rate %"},
              "properties": [
                {"id": "unit", "value": "percent"},
                {"id": "color", "value": {"fixedColor": "orange", "mode": "fixed"}}
              ]
            }
          ]
        }
      },
      {
        "id": 2,
        "title": "⚡ Request Rate by Operation",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
        "targets": [
          {
            "expr": "sum(rate(schlep_rust_kernel_requests_total{operation=~\"$operation\"}[5m])) by (operation, status)",
            "legendFormat": "{{operation}} ({{status}})",
            "refId": "A"
          }
        ],
        "yAxes": [
          {"label": "Requests/sec", "min": 0},
          {"show": false}
        ],
        "xAxis": {"show": true},
        "legend": {"show": true, "values": true, "current": true, "max": true},
        "tooltip": {"shared": true, "sort": 2, "value_type": "individual"}
      },
      {
        "id": 3,
        "title": "🔥 Performance Gains by Operation",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
        "targets": [
          {
            "expr": "schlep_rust_kernel_performance_gain_ratio{operation=~\"$operation\"}",
            "legendFormat": "{{operation}} Performance Gain",
            "refId": "A"
          }
        ],
        "yAxes": [
          {"label": "Speedup Ratio", "min": 0},
          {"show": false}
        ],
        "xAxis": {"show": true},
        "legend": {"show": true, "values": true, "current": true, "max": true},
        "tooltip": {"shared": true, "sort": 2, "value_type": "individual"},
        "thresholds": [
          {"value": 1.0, "colorMode": "critical", "op": "lt", "fill": true, "line": true, "yaxis": "left"},
          {"value": 1.5, "colorMode": "custom", "op": "gt", "fill": true, "line": true, "yaxis": "left", "fillColor": "rgba(31, 120, 193, 0.18)", "lineColor": "rgba(31, 120, 193, 0.6)"}
        ]
      },
      {
        "id": 4,
        "title": "📊 Throughput Comparison: Rust vs Python",
        "type": "graph",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 12},
        "targets": [
          {
            "expr": "schlep_rust_kernel_throughput_rows_per_second{acceleration_type=\"rust_kernels\", operation=~\"$operation\"}",
            "legendFormat": "{{operation}} (Rust)",
            "refId": "A"
          },
          {
            "expr": "schlep_rust_kernel_throughput_rows_per_second{acceleration_type=\"python_pandas\", operation=~\"$operation\"}",
            "legendFormat": "{{operation}} (Python)",
            "refId": "B"
          }
        ],
        "yAxes": [
          {"label": "Rows/second", "min": 0, "logBase": 10},
          {"show": false}
        ],
        "xAxis": {"show": true},
        "legend": {"show": true, "values": true, "current": true, "max": true, "alignAsTable": true},
        "tooltip": {"shared": true, "sort": 2, "value_type": "individual"},
        "seriesOverrides": [
          {
            "alias": "/Rust/",
            "color": "#FF7F00",
            "lineWidth": 3
          },
          {
            "alias": "/Python/",
            "color": "#3F7CAC",
            "lineWidth": 2,
            "dashes": true
          }
        ]
      },
      {
        "id": 5,
        "title": "🛡️ Fallback System Performance",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
        "targets": [
          {
            "expr": "schlep_rust_kernel_fallback_rate_percent{operation=~\"$operation\"}",
            "legendFormat": "{{operation}} Fallback Rate",
            "refId": "A"
          },
          {
            "expr": "schlep_rust_kernel_error_rate_percent{operation=~\"$operation\"}",
            "legendFormat": "{{operation}} Error Rate",
            "refId": "B"
          }
        ],
        "yAxes": [
          {"label": "Percentage", "min": 0, "max": 100},
          {"show": false}
        ],
        "xAxis": {"show": true},
        "legend": {"show": true, "values": true, "current": true, "max": true},
        "tooltip": {"shared": true, "sort": 2, "value_type": "individual"},
        "thresholds": [
          {"value": 5, "colorMode": "custom", "op": "gt", "fill": true, "line": true, "yaxis": "left", "fillColor": "rgba(234, 112, 112, 0.18)", "lineColor": "rgba(234, 112, 112, 0.6)"},
          {"value": 1, "colorMode": "custom", "op": "gt", "fill": true, "line": true, "yaxis": "left", "fillColor": "rgba(250, 222, 42, 0.18)", "lineColor": "rgba(250, 222, 42, 0.6)"}
        ]
      },
      {
        "id": 6,
        "title": "💾 Memory Efficiency",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
        "targets": [
          {
            "expr": "schlep_rust_kernel_memory_efficiency_ratio{operation=~\"$operation\"}",
            "legendFormat": "{{operation}} Memory Efficiency",
            "refId": "A"
          }
        ],
        "yAxes": [
          {"label": "Efficiency Ratio", "min": 0, "max": 1},
          {"show": false}
        ],
        "xAxis": {"show": true},
        "legend": {"show": true, "values": true, "current": true, "max": true},
        "tooltip": {"shared": true, "sort": 2, "value_type": "individual"},
        "thresholds": [
          {"value": 0.4, "colorMode": "custom", "op": "gt", "fill": true, "line": true, "yaxis": "left", "fillColor": "rgba(50, 172, 45, 0.18)", "lineColor": "rgba(50, 172, 45, 0.6)"}
        ]
      },
      {
        "id": 7,
        "title": "📈 Processing Duration Distribution",
        "type": "heatmap",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 28},
        "targets": [
          {
            "expr": "sum(rate(schlep_rust_kernel_processing_duration_seconds_bucket{operation=~\"$operation\"}[5m])) by (le, operation, acceleration_type)",
            "legendFormat": "{{operation}} ({{acceleration_type}})",
            "refId": "A"
          }
        ],
        "heatmap": {
          "xBucketSize": null,
          "xBucketNumber": null,
          "yBucketSize": null,
          "yBucketNumber": null
        },
        "cards": {
          "cardColor": "#b4ff00",
          "cardPadding": null,
          "cardRound": null
        },
        "color": {
          "mode": "spectrum",
          "cardColor": "#b4ff00",
          "colorScale": "sqrt",
          "exponent": 0.5,
          "min": null,
          "max": null
        },
        "legend": {"show": false},
        "yAxis": {"label": "Processing Time (seconds)", "min": null, "max": null, "logBase": 2}
      },
      {
        "id": 8,
        "title": "📊 Data Size Distribution",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 28},
        "targets": [
          {
            "expr": "sum(rate(schlep_rust_kernel_data_size_bytes_bucket{operation=~\"$operation\"}[5m])) by (le, operation)",
            "legendFormat": "{{operation}} Data Size Distribution",
            "refId": "A"
          }
        ],
        "yAxes": [
          {"label": "Requests/sec", "min": 0},
          {"show": false}
        ],
        "xAxis": {"show": true},
        "legend": {"show": true, "values": true, "current": true, "max": true},
        "tooltip": {"shared": true, "sort": 2, "value_type": "individual"}
      },
      {
        "id": 9,
        "title": "🔄 Concurrent Operations",
        "type": "graph",
        "gridPos": {"h": 6, "w": 12, "x": 0, "y": 36},
        "targets": [
          {
            "expr": "schlep_rust_kernel_concurrent_operations_current{operation=~\"$operation\"}",
            "legendFormat": "{{operation}} Concurrent",
            "refId": "A"
          }
        ],
        "yAxes": [
          {"label": "Operations", "min": 0},
          {"show": false}
        ],
        "xAxis": {"show": true},
        "legend": {"show": true, "values": true, "current": true, "max": true},
        "tooltip": {"shared": true, "sort": 2, "value_type": "individual"}
      },
      {
        "id": 10,
        "title": "❌ Fallback Reasons",
        "type": "table",
        "gridPos": {"h": 6, "w": 12, "x": 12, "y": 36},
        "targets": [
          {
            "expr": "sum(increase(schlep_rust_kernel_fallback_reasons_total{operation=~\"$operation\"}[1h])) by (operation, reason)",
            "legendFormat": "",
            "refId": "A",
            "format": "table",
            "instant": true
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {"Time": true, "__name__": true, "job": true, "instance": true},
              "indexByName": {},
              "renameByName": {
                "operation": "Operation",
                "reason": "Fallback Reason",
                "Value": "Count"
              }
            }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "displayMode": "color-background",
              "align": "left"
            }
          }
        }
      }
    ],
    "annotations": {
      "list": [
        {
          "name": "Rust Kernel Deployments",
          "datasource": "prometheus",
          "enable": true,
          "expr": "changes(schlep_rust_kernel_info[1h]) > 0",
          "iconColor": "rgba(255, 96, 96, 1)",
          "step": "60s",
          "titleFormat": "Kernel Update",
          "textFormat": "Rust kernels updated"
        }
      ]
    },
    "refresh": "30s",
    "version": 1
  }
}