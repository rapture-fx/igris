# Schlep-engine Environment Configuration Template
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to version control

# CRITICAL: Generate secure values for production
# Use: openssl rand -hex 32

# Core Application Settings
ENVIRONMENT=development
SECRET_KEY=your_256_bit_secret_key_here
APP_VERSION=1.0.0
DEBUG=false

# Database Configuration
DATABASE_URL=postgresql+asyncpg://username:password@host:port/database
POSTGRES_PASSWORD=secure_password_here
POSTGRES_USER=your_db_user
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=schlep_engine_dev

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Frontend URLs
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002

# OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# LemonSqueezy Configuration (Get new keys!)
LEMONSQUEEZY_API_KEY=your_new_lemonsqueezy_api_key
LEMONSQUEEZY_WEBHOOK_SECRET=your_new_webhook_secret
LEMONSQUEEZY_STORE_ID=your_store_id

# Google Cloud Storage
GCS_PROJECT_ID=your_gcs_project_id
GCS_PRIVATE_KEY_ID=your_private_key_id
GCS_PRIVATE_KEY=your_private_key_here
GCS_CLIENT_EMAIL=your_service_account_email
GCS_CLIENT_ID=your_client_id
GCS_CLIENT_X509_CERT_URL=your_cert_url

# CORS and Security
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:3002"]
ALLOWED_HOSTS=["*"]

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log