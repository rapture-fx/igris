# Schlep-engine AI-powered data analysis platform - Specific Exclusions

# Uploaded data files (for privacy and size)
backend/uploads/
uploads/
data/
datasets/

# Exclude large data files but keep demo files
*.csv
!test_data.csv
*.xlsx
*.xls
# Allow demo.html and package.json files
!demo.html
!package.json
!package-lock.json
!**/package.json
!**/package-lock.json
*.parquet
*.tsv

# AI/ML model files (can be large)
# Note: Exclude binary model files but NOT Go source code in apps/go-gateway/internal/models/
*.pkl
*.joblib
*.h5
*.pt
*.pth
*.onnx
*.tflite
# Only ignore model binary directories, not Go source directories
**/trained_models/
**/saved_models/
**/model_checkpoints/

# Processing results and temporary files
results/
output/
processed_data/
temp_files/
# Note: cache/ directory is for Go source code, not temp files
# Use specific patterns for cache data instead:
*.cache
.cache/
**/cache_data/

# API keys and sensitive configuration
secrets/
keys/
credentials/
.env.secret
.env.production
config/secrets.json

# Test data (keep test_data.csv as it's small and part of demo)
# large_test_data/
# sample_datasets/

# Development artifacts
.vscode/settings.json
.idea/workspace.xml
*.swp
*.swo
*~

# Docker
.dockerignore
docker-compose.override.yml

# Monitoring and metrics
prometheus_data/
grafana_data/
logs/

# Backup files
*.bak
*.backup
*.old

# System files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

