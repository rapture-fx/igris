# Re-include web app source `lib/` directories — the broad Python `lib/`
# rule above otherwise excludes them and breaks Cloudflare/CI builds.
!web/apps/*/src/lib/
!web/apps/*/src/lib/**
!web/apps/*/lib/
!web/apps/*/lib/**
