%% Rust FFI Integration: Thompson Sampling Optimizer
%% Based on internal/inference/optimizer/ffi/ffi_wrapper.go and rust-core/rust_kernel/src/optimizer
%% Updated: 2025-10-20 - Synchronized with codebase

graph TB
    subgraph Go["Go Layer"]
        InferHandler[InferHandler<br/>handlers/infer.go]
        ShadowRunner[ShadowRunner<br/>shadow.ShadowRunner]
        OptimizerHandle[OptimizerHandle<br/>ffi.OptimizerHandle]
    end

    subgraph CGO["CGO Layer (FFI Bridge)"]
        direction LR
        InitFunc[optimizer_init<br/>*C.char config_json]
        SelectFunc[optimizer_select_action<br/>*OptimizerHandle]
        UpdateRewardFunc[optimizer_update_reward<br/>action_id, reward]
        UpdateMetricsFunc[optimizer_update_metrics<br/>action_id, metrics_json]
        GetStatsFunc[optimizer_get_stats<br/>*OptimizerHandle]
        ExportStateFunc[optimizer_export_state<br/>*OptimizerHandle]
        FreeFunc[optimizer_free<br/>*OptimizerHandle]
        FreeStringFunc[optimizer_free_string<br/>*C.char]
    end

    subgraph Rust["Rust Optimizer (libigris_kernel.a)"]
        direction TB
        BanditEngine[ThompsonSampling<br/>Multi-Armed Bandit]
        BetaDist[BetaDistribution<br/>Per-Arm State<br/>α, β parameters]
        RewardCalc[RewardCalculator<br/>Weighted Metrics<br/>latency_weight, cost_weight]
        StateManager[StateManager<br/>Serialize/Deserialize<br/>JSON Export]
    end

    Config[OptimizerConfig<br/>arms: []string<br/>initial_alpha: 1.0<br/>initial_beta: 1.0<br/>reward_policy: RewardPolicy] --> OptimizerHandle

    OptimizerHandle -->|NewOptimizer| InitFunc
    InitFunc -->|JSON config| BanditEngine
    BanditEngine -->|Initialize| BetaDist

    InferHandler --> ShadowRunner
    ShadowRunner -->|SelectAction| OptimizerHandle
    OptimizerHandle -->|C call| SelectFunc
    SelectFunc --> BanditEngine
    BanditEngine -->|Sample Beta| BetaDist
    BetaDist -->|Highest sample| BanditEngine
    BanditEngine -->|Action JSON| SelectFunc
    SelectFunc -->|*C.char| OptimizerHandle
    OptimizerHandle -->|Unmarshal| ShadowRunner

    ShadowRunner -->|UpdateMetrics| OptimizerHandle
    OptimizerHandle -->|Marshal JSON| UpdateMetricsFunc
    UpdateMetricsFunc --> RewardCalc
    RewardCalc -->|Calculate weighted reward<br/>0.0 - 1.0| BanditEngine
    BanditEngine -->|Update α, β| BetaDist

    OptimizerHandle -->|GetStats| GetStatsFunc
    GetStatsFunc --> StateManager
    StateManager -->|ArmStats JSON<br/>[{action_id, α, β, pulls, mean_reward}]| GetStatsFunc
    GetStatsFunc -->|*C.char| OptimizerHandle
    OptimizerHandle -->|[]ArmStats| ShadowRunner

    OptimizerHandle -.->|Close| FreeFunc
    FreeFunc -.->|Cleanup| BanditEngine
    OptimizerHandle -.->|defer| FreeStringFunc

    Feedback[InferResponse<br/>latency_ms: float64<br/>cost_usd: float64<br/>success: bool<br/>cache_hit: bool] --> ShadowRunner

    style Go fill:#D6EAF8
    style CGO fill:#FCF3CF
    style Rust fill:#FADBD8
    style BetaDist fill:#D5F5E3
    style RewardCalc fill:#E8DAEF
    style StateManager fill:#FDEBD0
