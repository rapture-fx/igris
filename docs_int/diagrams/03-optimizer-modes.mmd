%% Optimizer Modes: Three Operating Modes
%% Based on internal/inference/optimizer/shadow/shadow_runner.go:17-24
%% Updated: 2025-10-22 - Added SLO Breaker monitoring

graph TB
    subgraph Mode1["Mode: go (ShadowModeGo)"]
        direction TB
        Request1[Request] --> InferenceRouter1[InferenceRouter<br/>router.InferenceRouter]
        InferenceRouter1 --> ProviderRegistry1[ProviderRegistry]
        ProviderRegistry1 --> Provider1[Provider]
        Provider1 --> Response1[Response]

        Note1[Go Router Only<br/>No Rust optimizer<br/>Policy-based selection]
    end

    subgraph Mode2["Mode: shadow (ShadowModeShadow)"]
        direction TB
        Request2[Request] --> ShadowRunner2[ShadowRunner]
        ShadowRunner2 --> ShouldSample{ShouldSample<br/>rand < sample_rate}

        ShouldSample -->|Always| Primary[InferenceRouter<br/>PRIMARY PATH]
        ShouldSample -.->|If sampled| RustShadow[RustOptimizer<br/>PARALLEL PATH<br/>ffi.OptimizerHandle]

        Primary --> Provider2A[Provider]
        RustShadow -.->|selectAction| Provider2B[Provider<br/>Shadow]

        Provider2A --> Response2[Response to Client]
        Provider2B -.-> ComparisonLog[ShadowLogger<br/>Log Comparison]

        ComparisonLog -.-> MetricsRecorder[MetricsRecorder<br/>Agreement Rate<br/>Cost Delta<br/>Latency Delta]

        MetricsRecorder -.-> SLOBreaker2[SLOBreaker<br/>Monitor Performance]
        SLOBreaker2 -.->|P95 latency >10%<br/>Cost >5%<br/>Error rate >0.5%| AutoRevert2[Auto-Revert<br/>to Go Mode]

        Note2[Client gets Go result<br/>Rust runs in parallel<br/>No production impact<br/>Logs to shadow_comparisons.jsonl<br/>SLO monitored]
    end

    subgraph Mode3["Mode: rust (ShadowModeRust)"]
        direction TB
        Request3[Request] --> ShadowRunner3[ShadowRunner]
        ShadowRunner3 --> Sample{Sample Check<br/>rand < sample_rate}

        Sample -->|Sampled| RustPrimary[RustOptimizer<br/>PRIMARY<br/>Thompson Sampling]
        Sample -->|Not sampled| GoFallback1[InferenceRouter]

        RustPrimary --> Execute{Execute<br/>selectAction}
        Execute -->|Success| Provider3[Provider]
        Execute -.->|Error| GoFallback2[InferenceRouter<br/>AUTO FALLBACK]

        GoFallback1 --> Provider3
        GoFallback2 --> Provider3

        Provider3 --> Response3[Response]
        Response3 --> UpdateMetrics[UpdateMetrics<br/>updateReward<br/>Update Beta α, β]

        UpdateMetrics --> SLOBreaker3[SLOBreaker<br/>Monitor Performance]
        SLOBreaker3 -.->|SLO Breach| AutoRevert3[Auto-Revert<br/>to Go Mode]
        AutoRevert3 -.-> GoFallback1

        Note3[Configurable sample rate<br/>Automatic Go fallback<br/>Continuous learning<br/>Production traffic<br/>SLO-protected]
    end

    ConfigNote[Configuration via OPTIMIZER_MODE env var<br/>or POST /admin/optimizer API<br/>Hot-reload without restart]

    Mode1 -.->|OPTIMIZER_MODE=go| ConfigNote
    Mode2 -.->|OPTIMIZER_MODE=shadow| ConfigNote
    Mode3 -.->|OPTIMIZER_MODE=rust| ConfigNote

    style Mode1 fill:#D6EAF8,stroke:#1976d2
    style Mode2 fill:#FDEBD0,stroke:#f57c00
    style Mode3 fill:#D5F5E3,stroke:#388e3c
    style ComparisonLog fill:#E8DAEF
    style UpdateMetrics fill:#FADBD8
    style Note1 fill:#fff,stroke:#999,stroke-dasharray: 5 5
    style Note2 fill:#fff,stroke:#999,stroke-dasharray: 5 5
    style Note3 fill:#fff,stroke:#999,stroke-dasharray: 5 5
    style ConfigNote fill:#FEF9E7,stroke:#f57f17
