    style PG1 fill:#F48FB1,stroke:#880E4F
    style PG2 fill:#F48FB1,stroke:#880E4F
    style PG3 fill:#F48FB1,stroke:#880E4F
    style Redis fill:#F8BBD0,stroke:#AD1457,stroke-width:2px
    style RedisCache fill:#F48FB1,stroke:#880E4F

