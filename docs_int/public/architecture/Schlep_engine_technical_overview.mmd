%%{init: {'theme':'base', 'themeVariables': {'fontSize':'13px'}}}%%
graph TD
    Client[Client Application<br/>REST API, Streaming, SDK]

    APIGateway[API Gateway<br/>Fiber HTTP Server<br/>POST /v1/infer]

    subgraph Middleware[" Middleware Stack "]
        MW1[Recovery & CORS]
        MW2[Trace ID Generation]
        MW3[Request Logger]
        MW4[Tenant Auth Optional]
    end

    subgraph Safety[" Safety & Control Layer "]
        SafetyController[Safety Controller<br/>Pre-Request Validation]
        BudgetTracker[Budget Tracker<br/>Monthly Spend Limits]
        TokenEnforcer[Token Enforcer<br/>Max Token Limits]
        KeyValidator[Key Validator<br/>API Key Validation]
        AuditLogger[Audit Logger<br/>Compliance Tracking]
    end

    subgraph Routing[" Intelligent Routing Engine "]
        InferenceHandler[Inference Handler<br/>Request Processing]

        subgraph RouterModes[" Routing Modes "]
            GoRouter[Go Router<br/>Statistics-Based]
            RustOptimizer[Rust Optimizer<br/>Thompson Sampling]
            ShadowRunner[Shadow Runner<br/>Parallel Testing]
        end

        SLOBreaker[SLO Breaker<br/>Auto-Revert on Breach]
        RuntimeConfig[Runtime Config<br/>Hot-Reload Mode Switch]
    end

    subgraph Providers[" Provider Layer "]
        Registry[Provider Registry]
        OpenAIProvider[OpenAI Provider<br/>GPT-4, GPT-3.5]
        AnthropicProvider[Anthropic Provider<br/>Claude 3.5, Claude 3]
        BenchmarkProviders[Benchmark Providers<br/>Testing Mode]
    end

    subgraph External[" External LLM APIs "]
        OpenAI_API[OpenAI API]
        Anthropic_API[Anthropic API]
    end

    subgraph DataLayer[" Data & Persistence "]
        PostgreSQL[(PostgreSQL)]
        PG1[Budgets Table]
        PG2[Spending Log]
        PG3[Policy Settings]

        Redis[(Redis Cache)]
        RedisCache[ML Predictions Cache]
    end

    subgraph Observability[" Observability & Monitoring "]
        MetricsCollector[Metrics Collector<br/>In-Memory Aggregation]
        Prometheus[Prometheus Metrics<br/>HTTP Endpoint]
        Tracing[Distributed Tracing<br/>Trace ID Propagation]
        CostTracker[Cost Tracker<br/>Per-Request Estimation]
        AdminAPI[Admin API<br/>Runtime Configuration]
    end

    subgraph MultiTenancy[" Multi-Tenancy - Optional "]
        TenantMgmt[Tenant Management]
        VaultKeys[Vault Key Storage]
        TenantPolicies[Per-Tenant Policies]
    end

    %% Main request flow
    Client -->|HTTP Request| APIGateway
    APIGateway --> Middleware
    Middleware --> MW1
    Middleware --> MW2
    Middleware --> MW3
    Middleware --> MW4

    MW4 -.->|If Enabled| MultiTenancy

    Middleware --> SafetyController

    %% Safety layer
    SafetyController --> BudgetTracker
    SafetyController --> TokenEnforcer
    SafetyController --> KeyValidator
    SafetyController --> AuditLogger

    %% Safety to routing
    SafetyController --> InferenceHandler

    %% Routing modes
    InferenceHandler --> RouterModes
    RouterModes --> GoRouter
    RouterModes --> RustOptimizer
    RouterModes --> ShadowRunner

    %% SLO monitoring
    RustOptimizer --> SLOBreaker
    ShadowRunner --> SLOBreaker
    SLOBreaker -.->|Auto-Revert| GoRouter

    %% Runtime config
    RuntimeConfig ==>|Switch Mode| RouterModes
    AdminAPI ==>|Update| RuntimeConfig

    %% Routing to providers
    GoRouter --> Registry
    RustOptimizer --> Registry
    ShadowRunner --> Registry

    Registry --> OpenAIProvider
    Registry --> AnthropicProvider
    Registry --> BenchmarkProviders

    %% Providers to external APIs
    OpenAIProvider -->|Real Mode| OpenAI_API
    AnthropicProvider -->|Real Mode| Anthropic_API

    %% Response flow
    OpenAI_API -.->|Response| OpenAIProvider
    Anthropic_API -.->|Response| AnthropicProvider

    OpenAIProvider -.-> InferenceHandler
    AnthropicProvider -.-> InferenceHandler
    BenchmarkProviders -.-> InferenceHandler

    InferenceHandler -.->|Response| Client

    %% Feedback loop
    InferenceHandler ==>|Performance Data| RustOptimizer
    InferenceHandler ==>|Stats| MetricsCollector

    %% Database connections
    BudgetTracker --> PG1
    AuditLogger --> PG2
    TenantPolicies --> PG3

    Registry --> RedisCache

    %% Observability
    InferenceHandler --> MetricsCollector
    MetricsCollector --> Prometheus
    MW2 --> Tracing
    InferenceHandler --> CostTracker
    CostTracker --> BudgetTracker

    %% Styling - Client & Gateway
    style Client fill:#D6EAF8,stroke:#1E88E5,stroke-width:3px
    style APIGateway fill:#D6EAF8,stroke:#1E88E5,stroke-width:2px

    %% Styling - Middleware
    style Middleware fill:#E3F2FD,stroke:#1976D2,stroke-width:2px
    style MW1 fill:#BBDEFB,stroke:#1565C0
    style MW2 fill:#BBDEFB,stroke:#1565C0
    style MW3 fill:#BBDEFB,stroke:#1565C0
    style MW4 fill:#BBDEFB,stroke:#1565C0,stroke-dasharray: 5 5

    %% Styling - Safety Layer
    style Safety fill:#FFF3E0,stroke:#F57C00,stroke-width:2px
    style SafetyController fill:#FFE0B2,stroke:#EF6C00,stroke-width:2px
    style BudgetTracker fill:#FFCC80,stroke:#E65100
    style TokenEnforcer fill:#FFCC80,stroke:#E65100
    style KeyValidator fill:#FFCC80,stroke:#E65100
    style AuditLogger fill:#FFCC80,stroke:#E65100

