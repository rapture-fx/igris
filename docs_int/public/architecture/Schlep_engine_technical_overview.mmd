    style AnthropicProvider fill:#A5D6A7,stroke:#1B5E20
    style BenchmarkProviders fill:#A5D6A7,stroke:#1B5E20

    %% Styling - External APIs
    style External fill:#FFEBEE,stroke:#C62828,stroke-width:2px
    style OpenAI_API fill:#FFCDD2,stroke:#C62828
    style Anthropic_API fill:#FFCDD2,stroke:#C62828

