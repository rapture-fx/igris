# Schlep Engine Phase One Environment Configuration
# Copy this file to .env and customize for your environment

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Configuration
POSTGRES_DB=schlep_engine
POSTGRES_USER=schlep_user
POSTGRES_PASSWORD=schlep_postgres_dev_2024
POSTGRES_PORT=5432

# PostgreSQL Performance Tuning (adjust based on available resources)
POSTGRES_SHARED_BUFFERS=512MB      # 25% of available RAM
POSTGRES_EFFECTIVE_CACHE_SIZE=2GB   # 75% of available RAM
POSTGRES_MAX_CONNECTIONS=200        # For 1000+ concurrent users

# Redis Configuration
REDIS_PASSWORD=schlep_redis_dev_2024
REDIS_PORT=6379

# =============================================================================
# OBJECT STORAGE CONFIGURATION
# =============================================================================

# MinIO Configuration
MINIO_ROOT_USER=schlep_admin
MINIO_ROOT_PASSWORD=schlep_minio_dev_password_2024
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_DOMAIN=minio.schlep-local.dev
MINIO_REGION=us-east-1

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================

# Prometheus Configuration
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=30d
PROMETHEUS_RETENTION_SIZE=10GB

# Grafana Configuration
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=schlep_grafana_dev_2024

# Exporters
POSTGRES_EXPORTER_PORT=9187
REDIS_EXPORTER_PORT=9121

# =============================================================================
# PROXY CONFIGURATION
# =============================================================================

# Nginx Ports
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443

# =============================================================================
# DATA STORAGE PATHS
# =============================================================================

# Local data paths (relative to docker-compose file)
POSTGRES_DATA_PATH=./data/postgres
REDIS_DATA_PATH=./data/redis
MINIO_DATA_PATH=./data/minio
PROMETHEUS_DATA_PATH=./data/prometheus
GRAFANA_DATA_PATH=./data/grafana
BACKUP_DATA_PATH=./data/backups

# =============================================================================
# DEVELOPMENT/PRODUCTION SETTINGS
# =============================================================================

# Environment
ENVIRONMENT=development

# Debug settings
DEBUG=true
LOG_LEVEL=INFO

# =============================================================================
# COST OPTIMIZATION SETTINGS
# =============================================================================

# Resource limits for cost control
# These settings keep infrastructure under $300/month

# CPU Limits (total across all services: ~6 cores)
POSTGRES_CPU_LIMIT=2.0
REDIS_CPU_LIMIT=1.0
MINIO_CPU_LIMIT=1.0
PROMETHEUS_CPU_LIMIT=1.0
GRAFANA_CPU_LIMIT=0.5
NGINX_CPU_LIMIT=0.5

# Memory Limits (total: ~7GB)
POSTGRES_MEMORY_LIMIT=2G
REDIS_MEMORY_LIMIT=1G
MINIO_MEMORY_LIMIT=1G
PROMETHEUS_MEMORY_LIMIT=2G
GRAFANA_MEMORY_LIMIT=512M
NGINX_MEMORY_LIMIT=256M

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================

# Backup settings
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
BACKUP_COMPRESSION=gzip

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# Security
ENABLE_TLS=false  # Set to true for production
TLS_CERT_PATH=./certs/tls.crt
TLS_KEY_PATH=./certs/tls.key

# Network security
ALLOWED_HOSTS=localhost,127.0.0.1,schlep-local.dev
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# =============================================================================
# MIGRATION READINESS SETTINGS
# =============================================================================

# Phase Two migration flags (for future use)
ENABLE_YUGABYTEDB_MIGRATION=false
ENABLE_DRAGONFLY_MIGRATION=false
MIGRATION_DRY_RUN=false

# YugabyteDB settings (for Phase Two)
YUGABYTEDB_HOST=
YUGABYTEDB_PORT=5433
YUGABYTEDB_DATABASE=schlep_engine
YUGABYTEDB_USER=
YUGABYTEDB_PASSWORD=

# DragonflyDB settings (for Phase Two)
DRAGONFLY_HOST=
DRAGONFLY_PORT=6379
DRAGONFLY_PASSWORD=

# =============================================================================
# PERFORMANCE MONITORING
# =============================================================================

# Performance targets for 1000 concurrent users
TARGET_RESPONSE_TIME_MS=100
TARGET_THROUGHPUT_RPS=1000
TARGET_UPTIME_PERCENTAGE=99.9

# Alert thresholds
ALERT_CPU_THRESHOLD=80
ALERT_MEMORY_THRESHOLD=85
ALERT_DISK_THRESHOLD=90
ALERT_RESPONSE_TIME_THRESHOLD=500

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Development features
ENABLE_DEBUG_LOGGING=true
ENABLE_METRICS_COLLECTION=true
ENABLE_PERFORMANCE_PROFILING=false

# Operational features
ENABLE_AUTOMATED_BACKUPS=true
ENABLE_HEALTH_CHECKS=true
ENABLE_MONITORING_ALERTS=true