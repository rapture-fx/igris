# Igris Inertial Environment Configuration
# Production-Ready Multi-Tenant Configuration

# ====================
# Server Configuration
# ====================
PORT=8080
HOST=0.0.0.0
ENV=production
DEBUG=false
LOG_LEVEL=info
LOG_FORMAT=json

# ====================
# Provider Configuration
# ====================

# Provider Mode
# Options: "mock", "benchmark", "real", "hybrid"
# - mock: Mock providers (no API calls, instant responses)
# - benchmark: Realistic simulation (no API calls, realistic latency/pricing)
# - real: Real API calls using BYOK (requires API keys below)
# - hybrid: Mix of benchmark and real providers
PROVIDER_MODE=benchmark

# API Keys (BYOK - Bring Your Own Key)
# Required when PROVIDER_MODE=real or hybrid for the selected provider.
# Keep real keys in local/untracked env only.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
ZAI_API_KEY=
DEEPSEEK_API_KEY=

# ====================
# Database Configuration (Phase 2)
# ====================

# Postgres Database
ENABLE_PERSISTENCE=true
DATABASE_URL=postgres://igris_user:changeme@localhost:5432/igris?sslmode=disable
POSTGRES_DB=igris
POSTGRES_USER=igris_user
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# Connection Pool Settings
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# Optimizer State Persistence
USE_PG_OPTIMIZER_STATE=true

# ====================
# Redis Configuration (Phase 2)
# ====================

# Redis Cache & Distributed State
USE_REDIS=true
REDIS_URL=redis://:changeme@localhost:6379/0
REDIS_PASSWORD=changeme
REDIS_PORT=6379

# Distributed Locking
USE_DISTRIBUTED_LOCK=true
LOCK_TTL_SECONDS=30

# ====================
# Billing (Polar.sh)
# ====================
POLAR_API_KEY=
POLAR_WEBHOOK_SECRET=
# Optional: override Polar API base URL (leave blank to use https://api.polar.sh)
POLAR_BASE_URL=

# ====================
# Email (Resend)
# ====================
RESEND_API_KEY=
RESEND_FROM_EMAIL=Igris Inertial <noreply@igrisinertial.com>

# ====================
# Clerk Authentication
# ====================

# Clerk JWKS URL — required for Clerk JWT verification on the backend.
# Find this in the Clerk dashboard under API Keys > Advanced > JWKS endpoint.
# Either CLERK_JWKS_URL or CLERK_FRONTEND_API must be set.
CLERK_JWKS_URL=https://<your-instance>.clerk.accounts.dev/.well-known/jwks.json
# Alternative: provide the base frontend API URL and the JWKS path will be appended automatically.
# CLERK_FRONTEND_API=https://<your-instance>.clerk.accounts.dev

# ====================
# Multi-Tenancy Configuration
# ====================

# Multi-Tenant Mode
ENABLE_MULTI_TENANCY=true

# Authentication Requirements
# - false: Public mode (no auth required)
# - true: Required auth mode (JWT mandatory for /v1/infer)
REQUIRE_AUTH_FOR_INFERENCE=false

# JWT Configuration
JWT_SECRET=please-change-this-secret-in-production
JWT_EXPIRATION_HOURS=24

# Vault Configuration (for encrypted tenant API keys)
VAULT_MASTER_KEY=please-change-this-vault-key-in-production

# ====================
# PHASE 2: Safety Controls
# FUTURE: Customer-Facing Budget & Policy Controls
# ====================

# Test Mode (Sandbox Mode)
# When enabled, applies enhanced safety controls:
# - Truncates excessive token requests instead of rejecting
# - Limits temperature and top_p to safe ranges
# - Automatically falls back to benchmark on errors
# FUTURE: This will become customer "Sandbox Mode" for safe testing
PROVIDER_TEST_MODE=false

# Budget Controls
# FUTURE: Customer "Monthly Budget Cap" feature
# Tracks cumulative monthly spend and enforces limit
MAX_MONTHLY_COST_USD=5.0
ENABLE_BUDGET_LIMIT=true

# When budget is exceeded, automatically fallback to benchmark mode
# FUTURE: Customer "Cost Protection" tier
FALLBACK_ON_BUDGET_BREACH=true

# Token Limits
# FUTURE: Customer "Usage Policy" controls
# Maximum tokens per single request (prompt + completion)
MAX_TOKENS_PER_REQUEST=1024
ENABLE_TOKEN_LIMIT=true

# Failover Controls
# FUTURE: Customer "Reliability Tier" (Enterprise feature)
# Automatically fallback to benchmark mode on provider errors
ENABLE_BENCHMARK_FALLBACK=true

# Key Validation
# FUTURE: Customer "BYOK Validation" on key upload
# Validates API keys at startup by making test requests
VALIDATE_KEYS_ON_STARTUP=true

# If validation fails, abort startup (recommended for production)
FAIL_FAST_ON_INVALID_KEY=true

# ====================
# Optimizer Configuration
# ====================

# Optimizer Mode
# Options: "go", "shadow", "rust"
# - go: Use Go-based router (simple, stable)
# - shadow: Run Rust optimizer in shadow mode (comparison logging)
# - rust: Use Rust optimizer for routing (Thompson Sampling)
OPTIMIZER_MODE=go

# Sample Rate (for rust mode)
# Percentage of requests to route through Rust optimizer (0.0-1.0)
# Start low (0.1 = 10%) and gradually increase
OPTIMIZER_SAMPLE_RATE=0.0

# ====================
# Observability (Phase 2/3)
# ====================

# Metrics
METRICS_ENABLED=true
METRICS_PORT=9090
PROMETHEUS_PORT=9090

# Distributed Tracing (Phase 4.2)
TRACING_ENABLED=false
TRACE_SAMPLING_RATE=1.0
JAEGER_ENDPOINT=http://jaeger:14268/api/traces
JAEGER_UI_PORT=16686
JAEGER_COLLECTOR_PORT=14268
JAEGER_AGENT_PORT=6831
JAEGER_ZIPKIN_PORT=9411

# Grafana (Optional - for visualization)
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ====================
# Advanced Configuration
# ====================

# HTTP timeouts (seconds)
REQUEST_TIMEOUT=60
PROVIDER_TIMEOUT=30

# Retry configuration
MAX_RETRIES=3
RETRY_DELAY_MS=500

# ====================
# Provider Rate Limiting (Anthropic)
# ====================

# Rate limiter configuration for Anthropic provider
# Prevents HTTP 429 errors by queuing and throttling requests

# Enable/disable rate limiting
ANTHROPIC_RATE_LIMIT_ENABLED=true

# Requests per minute (Anthropic default: 50)
ANTHROPIC_RATE_LIMIT_RPM=50

# Tokens per minute (Anthropic default: 400000)
ANTHROPIC_RATE_LIMIT_TPM=400000

# Maximum queue size for burst traffic
ANTHROPIC_RATE_LIMIT_QUEUE_SIZE=100

# Base backoff delay in milliseconds for retries
ANTHROPIC_RATE_LIMIT_BACKOFF_MS=200

# Maximum retry attempts for rate limit errors
ANTHROPIC_RATE_LIMIT_MAX_RETRIES=5

# Maximum jitter in milliseconds (added to backoff for randomness)
ANTHROPIC_RATE_LIMIT_JITTER_MS=100

# ====================
# Development Helpers
# ====================

# Enable verbose logging
VERBOSE_LOGGING=false

# Log directory for shadow mode comparisons
SHADOW_LOG_DIR=./logs/optimizer

# ====================
# Future Configuration (Phase 14+)
# ====================

# These will be added in future phases:

# Per-tenant budget limits
# TENANT_BUDGET_ENABLED=false
# TENANT_DEFAULT_BUDGET_USD=100.0

# Rate limiting
# RATE_LIMIT_RPM=1000
# RATE_LIMIT_PER_USER=100

# Alert webhooks for budget/limits
# ALERT_WEBHOOK_URL=
# BUDGET_WARNING_THRESHOLD=0.8

# Cost forecasting
# ENABLE_COST_FORECASTING=false
# FORECAST_HORIZON_DAYS=7

# ====================
# Production Checklist (Phase 3)
# ====================

# Before deploying to production:

# Security
# [ ] Change JWT_SECRET to strong random value (min 32 chars)
# [ ] Change VAULT_MASTER_KEY to strong random value (min 32 chars)
# [ ] Change POSTGRES_PASSWORD to strong password
# [ ] Change REDIS_PASSWORD to strong password
# [ ] Set REQUIRE_AUTH_FOR_INFERENCE=true (if using multi-tenancy)
# [ ] Review API key security (OPENAI_API_KEY, ANTHROPIC_API_KEY)

# Database
# [ ] Configure DATABASE_URL for production Postgres instance
# [ ] Run database migrations (see migrations directory)
# [ ] Configure connection pool (DB_MAX_OPEN_CONNS, DB_MAX_IDLE_CONNS)
# [ ] Enable SSL mode in DATABASE_URL (sslmode=require)

# Redis
# [ ] Configure REDIS_URL for production Redis instance
# [ ] Set strong REDIS_PASSWORD
# [ ] Configure Redis persistence (RDB or AOF)

# Provider Configuration
# [ ] Set PROVIDER_MODE=real or hybrid
# [ ] Set valid OPENAI_API_KEY and/or ANTHROPIC_API_KEY
# [ ] Set VALIDATE_KEYS_ON_STARTUP=true
# [ ] Set FAIL_FAST_ON_INVALID_KEY=true

# Safety Controls
# [ ] Configure MAX_MONTHLY_COST_USD appropriately
# [ ] Set ENABLE_BUDGET_LIMIT=true
# [ ] Set ENABLE_BENCHMARK_FALLBACK=true
# [ ] Review MAX_TOKENS_PER_REQUEST for your use case

# Observability
# [ ] Configure METRICS_ENABLED=true
# [ ] Set LOG_LEVEL=info (or warn for production)
# [ ] Set LOG_FORMAT=json
# [ ] Configure Prometheus scraping
# [ ] Set up Grafana dashboards (optional)

# General
# [ ] Set ENV=production
# [ ] Set DEBUG=false
# [ ] Review REQUEST_TIMEOUT and PROVIDER_TIMEOUT
# [ ] Test health endpoints (/v1/health, /healthz)
# [ ] Run integration tests
# [ ] Perform load testing

# ====================
# Customer Configuration (Future UI)
# ====================

# Phase 15 will add UI for customers to configure:
# - Monthly budget caps per team/project
# - Token limits by user tier (Free/Pro/Enterprise)
# - Custom usage policies (time-based, model restrictions)
# - Failover preferences (benchmark, own infrastructure)
# - Alert preferences (email, Slack, webhook)
# - Cost allocation and chargeback
