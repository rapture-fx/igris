# Makefile for Phase 13 Validation Suite
# Provides convenient commands to run all validation tests

.PHONY: help test-validation test-cognitive test-regression test-shadow-replay test-chaos test-all clean-validation validate-phase13

help:
	@echo "Phase 13 Validation Suite Commands"
	@echo "==================================="
	@echo ""
	@echo "Test Commands:"
	@echo "  make test-validation         - Run all validation tests"
	@echo "  make test-cognitive          - Run cognitive validation tests (30 tests)"
	@echo "  make test-regression         - Run Phase 13 regression tests"
	@echo "  make test-shadow-replay      - Run shadow replay validation"
	@echo "  make test-chaos              - Run Phase 13 chaos scenarios"
	@echo "  make test-all                - Run complete certification suite (71 tests)"
	@echo ""
	@echo "Validation Commands:"
	@echo "  make validate-phase13        - Full Phase 13 certification validation"
	@echo "  make validate-quick          - Quick validation check (subset of tests)"
	@echo ""
	@echo "Report Commands:"
	@echo "  make report-validation       - Generate validation status report"
	@echo "  make report-regression       - Generate regression analysis report"
	@echo "  make report-certification    - Generate certification test matrix report"
	@echo ""
	@echo "Utility Commands:"
	@echo "  make clean-validation        - Clean validation artifacts"
	@echo "  make setup-validation        - Setup validation environment"
	@echo ""

# Setup validation environment
setup-validation:
	@echo "Setting up validation environment..."
	mkdir -p validation/reports
	mkdir -p validation/results
	mkdir -p chaos/harness_updates
	@echo "✅ Validation environment ready"

# Run cognitive validation tests
test-cognitive:
	@echo "=== Running Cognitive Validation Tests ==="
	cd integration/tests && cargo test cognitive_validation --release -- --test-threads=1
	@echo "✅ Cognitive validation complete"

# Run Phase 13 regression tests
test-regression:
	@echo "=== Running Phase 13 Regression Tests ==="
	cd integration/tests && cargo test phase13_regression --release -- --test-threads=1
	@echo "✅ Regression analysis complete"

# Run shadow replay validation
test-shadow-replay:
	@echo "=== Running Shadow Replay Validation ==="
	cd integration/tests && cargo test shadow_replay_validation --release -- --test-threads=1
	@echo "✅ Shadow replay validation complete"

# Run Phase 13 chaos scenarios
test-chaos:
	@echo "=== Running Phase 13 Chaos Scenarios ==="
	./chaos/harness_updates/phase13_chaos_scenarios.sh phase13-suite
	@echo "✅ Chaos scenarios complete"

# Run all validation tests
test-validation: test-cognitive test-regression test-shadow-replay
	@echo "✅ All validation tests complete"

# Run complete certification suite
test-all: test-cognitive test-regression test-shadow-replay test-chaos
	@echo ""
	@echo "=== CERTIFICATION SUITE COMPLETE ==="
	@echo "Generating final report..."
	@$(MAKE) report-certification
	@echo "✅ Certification suite finished"

# Full Phase 13 certification validation
validate-phase13: setup-validation
	@echo "=== Starting Full Phase 13 Certification Validation ==="
	@echo ""
	@echo "Phase 1: Cognitive Validation (30 tests)"
	@$(MAKE) test-cognitive
	@echo ""
	@echo "Phase 2: Shadow Replay Validation (6 tests)"
	@$(MAKE) test-shadow-replay
	@echo ""
	@echo "Phase 3: Regression Analysis (7 tests)"
	@$(MAKE) test-regression
	@echo ""
	@echo "Phase 4: Chaos Engineering (5 scenarios)"
	@$(MAKE) test-chaos
	@echo ""
	@echo "Phase 5: Integration Tests (100 scenarios)"
	cd integration/tests/integration_suite && go test -v -timeout 30m
	@echo ""
	@echo "=== VALIDATION COMPLETE ==="
	@$(MAKE) report-validation
	@echo "✅ Phase 13 certified"

# Quick validation check (subset)
validate-quick: test-cognitive test-regression
	@echo "✅ Quick validation complete"

# Generate validation status report
report-validation:
	@echo "Generating validation status report..."
	@python3 scripts/generate_validation_report.py --output validation/reports/validation_status.md
	@echo "✅ Report generated: validation/reports/validation_status.md"

# Generate regression analysis report
report-regression:
	@echo "Generating regression analysis report..."
	cd integration/tests && cargo test phase13_regression --release -- --nocapture | tee ../../validation/reports/regression_report.txt
	@echo "✅ Report generated: validation/reports/regression_report.txt"

# Generate certification matrix report
report-certification:
	@echo "Generating certification test matrix report..."
	@echo "Certification report already available at: validation/reports/cert_matrix.md"
	@echo "✅ Certification matrix documented"

# Clean validation artifacts
clean-validation:
	@echo "Cleaning validation artifacts..."
	rm -rf validation/results/*
	rm -f /var/log/schlep/chaos_phase13.log
	rm -f /var/log/schlep/chaos_phase13_results.json
	@echo "✅ Validation artifacts cleaned"

# Python tests validation
test-python-validation:
	@echo "=== Running Python Validation Tests ==="
	pytest tests/validation/ -v --tb=short
	@echo "✅ Python validation tests complete"

# Rust kernel tests
test-rust-kernel:
	@echo "=== Running Rust Kernel Tests ==="
	cd rust_kernel && cargo test --all --release
	@echo "✅ Rust kernel tests complete"

# Integration suite tests
test-integration-suite:
	@echo "=== Running Integration Suite (100 scenarios) ==="
	cd integration/tests/integration_suite && go test -v -timeout 30m
	@echo "✅ Integration suite complete"

# CI validation (for automated pipelines)
ci-validate: setup-validation test-validation test-python-validation
	@echo "=== CI Validation Complete ==="
	@echo "Checking pass rate..."
	@python3 -c "import json; \
		data = json.load(open('validation/results/test_results.json')); \
		pass_rate = data['passed'] / data['total'] * 100; \
		print(f'Pass Rate: {pass_rate:.2f}%'); \
		assert pass_rate >= 98.0, f'Pass rate {pass_rate}% below 98% threshold'"
	@echo "✅ CI validation passed"

# Continuous validation (for scheduled runs)
continuous-validate:
	@echo "=== Running Continuous Validation ==="
	@$(MAKE) test-cognitive
	@$(MAKE) test-regression
	@echo "✅ Continuous validation complete"
