%% Optimizer Modes: Three Operating Modes
%% Based on internal/inference/optimizer/shadow/shadow_runner.go:17-24

graph TB
    subgraph Mode1["Mode: go"]
        direction TB
        Request1[Request] --> GoRouter1[Go Router]
        GoRouter1 --> Provider1[Provider]
        Provider1 --> Response1[Response]

        Note1[Go Router Only<br/>No Rust optimizer]
    end

    subgraph Mode2["Mode: shadow"]
        direction TB
        Request2[Request] --> Decision2{Sample Rate<br/>Check}

        Decision2 -->|Always| Primary[Go Router<br/>PRIMARY]
        Decision2 -.->|If sampled| RustShadow[Rust Optimizer<br/>PARALLEL]

        Primary --> Provider2A[Provider]
        RustShadow -.-> Provider2B[Provider<br/>Shadow]

        Provider2A --> Response2[Response to Client]
        Provider2B -.-> Logger[Shadow Logger]

        Logger -.-> Metrics2[Comparison Metrics<br/>Agreement Rate<br/>Cost Delta<br/>Latency Delta]

        Note2[Client gets Go result<br/>Rust runs in parallel<br/>No production impact]
    end

    subgraph Mode3["Mode: rust"]
        direction TB
        Request3[Request] --> Sample{Sample Rate<br/>Check}

        Sample -->|rand < rate| RustPrimary[Rust Optimizer<br/>PRIMARY]
        Sample -->|rand >= rate| GoFallback1[Go Router]

        RustPrimary --> Execute{Execute}
        Execute -->|Success| Provider3[Provider]
        Execute -.->|Error| GoFallback2[Go Router<br/>AUTO FALLBACK]

        GoFallback1 --> Provider3
        GoFallback2 --> Provider3

        Provider3 --> Response3[Response]
        Response3 --> Feedback[Update Rust<br/>Optimizer]

        Note3[Configurable sample rate<br/>Automatic Go fallback<br/>Continuous learning]
    end

    ConfigNote[Configuration via OPTIMIZER_MODE env var or Admin API]

    Mode1 -.->|OPTIMIZER_MODE=go| ConfigNote
    Mode2 -.->|OPTIMIZER_MODE=shadow| ConfigNote
    Mode3 -.->|OPTIMIZER_MODE=rust| ConfigNote

    style Mode1 fill:#e3f2fd,stroke:#1976d2
    style Mode2 fill:#fff3e0,stroke:#f57c00
    style Mode3 fill:#e8f5e9,stroke:#388e3c
    style Logger fill:#f3e5f5
    style Feedback fill:#e1bee7
    style Note1 fill:#fff,stroke:#999,stroke-dasharray: 5 5
    style Note2 fill:#fff,stroke:#999,stroke-dasharray: 5 5
    style Note3 fill:#fff,stroke:#999,stroke-dasharray: 5 5
    style ConfigNote fill:#fff9c4,stroke:#f57f17
