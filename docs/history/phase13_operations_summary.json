  "merge_strategies": {
    "recommended": {
      "name": "Merge (--no-ff)",
      "command": "git merge --no-ff <branch>",
      "pros": [
        "Preserves complete branch history",
        "Clear visualization of parallel work",
        "Easy to trace feature development",
        "Non-destructive"
      ],
      "cons": [
        "Can create merge commit clutter",
        "History may be complex"
      ],
      "best_for": "Phase 13 parallel branches with significant changes"
    },
    "alternative_rebase": {
      "name": "Rebase",
      "command": "git rebase <base-branch>",
      "warning": "Rewrites history - use with extreme caution on shared branches",
      "pros": [
        "Clean, linear history",
        "No merge commits",
        "Easy to follow chronologically"
      ],
      "cons": [
        "Rewrites commit history",
        "Conflicts must be resolved per commit",
        "Dangerous if branch is shared"
      ],
      "best_for": "Private branches before final merge"
    },
    "alternative_squash": {
      "name": "Squash Merge",
      "command": "git merge --squash <branch>",
      "pros": [
        "Combines all commits into one",
        "Very clean history",
        "Good for cleanup"
      ],
      "cons": [
        "Loses granular commit history",
        "Hard to trace individual changes",
        "Cannot easily revert specific changes"
      ],
      "best_for": "Many small WIP commits that should be one logical change"
    }
  },
