%% Request Flow: Standard Inference
%% Shows the complete path from client to response
%% Updated: 2025-10-20 - Synchronized with handlers/infer.go

sequenceDiagram
    participant C as Client
    participant G as API Gateway<br/>(Fiber)
    participant H as InferHandler
    participant S as SafetyController
    participant SR as ShadowRunner
    participant R as InferenceRouter
    participant PR as ProviderRegistry
    participant P as Provider
    participant E as External LLM
    participant M as Metrics & Tracing

    C->>G: POST /v1/infer<br/>{model, messages, stream}

    activate G
    G->>G: Middleware: CORS,<br/>Recovery, TraceID
    G->>H: Route to InferHandler
    activate H

    H->>H: Parse & Validate Request<br/>models.InferRequest

    H->>S: Check Safety Guardrails
    activate S
    S-->>H: Approved / Rejected
    deactivate S

    H->>H: Get RuntimeConfig<br/>Check OptimizerMode

    alt Mode: shadow (sampled)
        par Primary Path (Go)
            H->>R: selectProvider()
            activate R
            R->>PR: Select by policy
            PR-->>R: Provider
            R->>P: Infer(request)
        and Shadow Path (Rust)
            H->>SR: RunShadowComparison()
            activate SR
            SR->>SR: ShouldSample()<br/>Check sample rate
            SR-->>SR: Rust selectAction()
            SR-->>H: Log comparison
            deactivate SR
        end
    else Mode: rust
        H->>SR: SelectAction via Rust
        SR-->>H: Action / Error
        alt Rust Success
            H->>R: Use Rust decision
        else Rust Error
            H->>R: Automatic fallback to Go
        end
    else Mode: go
        H->>R: selectProvider()
        R->>PR: Select by policy
        PR-->>R: Provider
    end

    activate P
    P->>E: HTTP POST /v1/chat/completions
    E-->>P: LLM Response
    deactivate P

    P-->>R: InferResponse
    deactivate R

    R-->>H: Response + Metadata

    H->>M: RecordMetrics()<br/>(latency, tokens, cost)
    H->>M: RecordTrace()<br/>(span, trace_id)

    alt Update Optimizer
        H->>SR: UpdateMetrics()<br/>(action_id, reward_metrics)
        SR-->>SR: Update Beta(α, β)
    end

    H->>H: CalculateCost()<br/>Add X-Trace-ID header
    H-->>G: JSON Response
    deactivate H

    G-->>C: 200 OK<br/>X-Trace-ID: xxx-xxx
    deactivate G

    Note over M: Prometheus: infer_requests_total++<br/>latency_histogram, cost_gauge,<br/>tokens_total recorded
