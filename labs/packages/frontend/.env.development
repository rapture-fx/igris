# Development Environment Configuration
NODE_ENV=development
NEXT_PUBLIC_DEBUG=true

# API Configuration
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_VERSION=v1
NEXT_PUBLIC_WS_HOST=localhost:8000

# App Configuration
NEXT_PUBLIC_APP_NAME=Igris Inertial
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth Configuration
NEXT_PUBLIC_OAUTH_GOOGLE_ENABLED=true
NEXT_PUBLIC_OAUTH_GITHUB_ENABLED=true
NEXT_PUBLIC_OAUTH_DISCORD_ENABLED=false

# Feature Flags
NEXT_PUBLIC_ENABLE_ML_FEATURES=true
NEXT_PUBLIC_ENABLE_REAL_TIME=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_MONITORING=true

# Analytics & Monitoring
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_POSTHOG_KEY=

# Storage Configuration
NEXT_PUBLIC_MAX_FILE_SIZE=100MB
NEXT_PUBLIC_ALLOWED_FILE_TYPES=csv,json,xlsx,parquet,txt

# Development Tools
NEXT_PUBLIC_SHOW_DEV_TOOLS=true
NEXT_PUBLIC_API_MOCKING=false
