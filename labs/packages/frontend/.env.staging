# Staging Environment Configuration
NODE_ENV=production
NEXT_PUBLIC_DEBUG=false

# API Configuration
NEXT_PUBLIC_API_URL=https://api-staging.igris-inertial.com
NEXT_PUBLIC_API_VERSION=v1
NEXT_PUBLIC_WS_HOST=ws-staging.igris-inertial.com

# App Configuration
NEXT_PUBLIC_APP_NAME=Igris Inertial (Staging)
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_APP_URL=https://staging.igris-inertial.com

# Auth Configuration
NEXT_PUBLIC_OAUTH_GOOGLE_ENABLED=true
NEXT_PUBLIC_OAUTH_GITHUB_ENABLED=true
NEXT_PUBLIC_OAUTH_DISCORD_ENABLED=false

# Feature Flags
NEXT_PUBLIC_ENABLE_ML_FEATURES=true
NEXT_PUBLIC_ENABLE_REAL_TIME=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_MONITORING=true

# Analytics & Monitoring
NEXT_PUBLIC_SENTRY_DSN=${SENTRY_DSN}
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=${GA_TRACKING_ID}
NEXT_PUBLIC_POSTHOG_KEY=${POSTHOG_KEY}

# Storage Configuration
NEXT_PUBLIC_MAX_FILE_SIZE=500MB
NEXT_PUBLIC_ALLOWED_FILE_TYPES=csv,json,xlsx,parquet,txt,xml,sql

# Development Tools
NEXT_PUBLIC_SHOW_DEV_TOOLS=true
NEXT_PUBLIC_API_MOCKING=false

# Security
NEXT_PUBLIC_CSRF_PROTECTION=true
NEXT_PUBLIC_RATE_LIMITING=true