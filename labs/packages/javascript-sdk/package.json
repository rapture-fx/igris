{
  "name": "@schlep-engine/javascript-sdk",
  "version": "1.0.0",
  "description": "Official JavaScript/TypeScript SDK for Schlep-engine - Advanced data processing, machine learning, and analytics platform",
  "keywords": [
    "schlep-engine",
    "data-processing",
    "machine-learning",
    "analytics",
    "api-client",
    "sdk",
    "typescript",
    "javascript"
  ],
  "author": "Schlep-engine <support@schlep-engine.com>",
  "license": "MIT",
  "type": "module",
  "homepage": "https://schlep-engine.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/schlep-engine/javascript-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/schlep-engine/javascript-sdk/issues"
  },
  "main": "src/index.ts",
  "module": "src/index.ts",
  "browser": {
    "./src/index.ts": "./src/index.ts"
  },
  "types": "src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./src/index.ts",
      "browser": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
  "scripts": {
    "build": "rollup -c --bundleConfigAsCjs && rollup -c rollup.browser.config.js --bundleConfigAsCjs",
    "build:watch": "rollup -c -w",
    "dev": "rollup -c -w",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:browser": "playwright test",
    "lint": "eslint src --ext .ts,.js",
    "lint:fix": "eslint src --ext .ts,.js --fix",
    "type-check": "tsc --noEmit",
    "docs": "typedoc",
    "prepare": "echo 'Skipping build'",
    "prepublishOnly": "npm run test && npm run build",
    "size": "size-limit"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@rollup/plugin-alias": "^5.0.1",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-json": "^6.0.1",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.5",
    "@size-limit/preset-small-lib": "^11.0.1",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.9.0",
    "@typescript-eslint/eslint-plugin": "^6.11.0",
    "@typescript-eslint/parser": "^6.11.0",
    "eslint": "^8.54.0",
    "eslint-plugin-import": "^2.29.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "msw": "^2.0.8",
    "rimraf": "^5.0.5",
    "rollup": "^4.5.0",
    "rollup-plugin-dts": "^6.1.0",
    "rollup-plugin-terser": "^7.0.2",
    "size-limit": "^11.0.1",
    "ts-jest": "^29.1.1",
    "tslib": "^2.6.2",
    "typedoc": "^0.25.4",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "cross-fetch": "^4.0.0",
    "eventemitter3": "^5.0.1"
  },
  "peerDependencies": {
    "typescript": ">=4.5.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "size-limit": [
    {
      "path": "dist/index.esm.js",
      "limit": "50 KB"
    },
    {
      "path": "dist/index.umd.js",
      "limit": "60 KB"
    }
  ],
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not IE 11"
  ]
}