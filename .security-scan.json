{
  "skipPackages": [
    "@schlep-engine/development-only"
  ],
  "ignoreCVEs": [],
  "severityThresholds": {
    "critical": 0,
    "high": 1,
    "moderate": 5,
    "low": 20
  },
  "outputFormats": ["console", "json", "html"],
  "reportPath": "./security-reports",
  "notifications": {
    "slack": {
      "enabled": false,
      "webhook": ""
    },
    "email": {
      "enabled": false,
      "recipients": []
    }
  },
  "autoFix": {
    "enabled": true,
    "severities": ["critical", "high"],
    "createPR": false
  }
}