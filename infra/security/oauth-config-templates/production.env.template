# 🚀 PRODUCTION OAuth Configuration Template for Schlep Engine
# 
# SECURITY WARNING:
# - Replace ALL placeholder values with actual production credentials
# - Never commit this file with real values to version control
# - Use secure secret management systems in production
# - Rotate secrets regularly (recommended: every 90 days)
#
# Generated: 2025-09-01
# Environment: PRODUCTION
#

# ================================================================
# 🔐 CORE SECURITY CONFIGURATION
# ================================================================

# Environment designation
ENVIRONMENT=production
DEBUG=false
TESTING=false

# Core security keys (CRITICAL: Generate new 512-bit keys)
# Generate with: openssl rand -hex 64
SECRET_KEY=REPLACE_WITH_512_BIT_PRODUCTION_SECRET_KEY
JWT_SECRET_KEY=REPLACE_WITH_512_BIT_JWT_SECRET_KEY
JWT_ALGORITHM=HS256

# Token expiration (production-recommended values)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption key for OAuth token storage (Fernet key)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=REPLACE_WITH_FERNET_ENCRYPTION_KEY

# CSRF protection key (32+ characters)
# Generate with: openssl rand -hex 32
CSRF_SECRET=REPLACE_WITH_CSRF_PROTECTION_KEY

# ================================================================
# 🔑 OAUTH PROVIDER CONFIGURATION
# ================================================================

# Google OAuth 2.0 Configuration
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=REPLACE_WITH_PRODUCTION_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_PRODUCTION_GOOGLE_CLIENT_SECRET

# GitHub OAuth Configuration  
# Get from: https://github.com/settings/developers
GITHUB_CLIENT_ID=REPLACE_WITH_PRODUCTION_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=REPLACE_WITH_PRODUCTION_GITHUB_CLIENT_SECRET

# Discord OAuth Configuration (Optional)
# Get from: https://discord.com/developers/applications
DISCORD_CLIENT_ID=REPLACE_WITH_PRODUCTION_DISCORD_CLIENT_ID
DISCORD_CLIENT_SECRET=REPLACE_WITH_PRODUCTION_DISCORD_CLIENT_SECRET

# OAuth redirect URI (MUST use HTTPS in production)
OAUTH_REDIRECT_URI=https://yourdomain.com/api/v1/auth/oauth/callback

# OAuth security settings
OAUTH_STATE_EXPIRE_MINUTES=10
OAUTH_TOKEN_REFRESH_THRESHOLD=300
OAUTH_RATE_LIMIT_PER_PROVIDER=10
OAUTH_RATE_LIMIT_WINDOW=60

# ================================================================
# 🛡️ SECURITY HEADERS AND PROTECTION
# ================================================================

# CORS configuration (restrictive for production)
ALLOWED_ORIGINS=["https://yourdomain.com","https://app.yourdomain.com"]
ALLOWED_HOSTS=["yourdomain.com","app.yourdomain.com"]

# Rate limiting (global)
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=3600

# Security headers
SECURE_HEADERS_ENABLED=true
HSTS_MAX_AGE=31536000
CONTENT_SECURITY_POLICY="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline';"

# ================================================================
# 💾 DATABASE CONFIGURATION
# ================================================================

# Primary database (PostgreSQL recommended for production)
DATABASE_URL=postgresql+asyncpg://username:password@host:port/database
DB_HOST=your-production-db-host
DB_PORT=5432
DB_NAME=schlep_engine_prod
DB_USER=schlep_engine_user
DB_PASSWORD=REPLACE_WITH_SECURE_DB_PASSWORD
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_SSL_MODE=require

# ================================================================
# 📡 REDIS CONFIGURATION (Required for OAuth state storage)
# ================================================================

# Redis for OAuth state, sessions, and caching
REDIS_URL=redis://username:password@host:port/0
REDIS_HOST=your-production-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_SECURE_REDIS_PASSWORD
REDIS_DB=0
REDIS_SSL=true
USE_REDIS_CACHE=true

# ================================================================
# 📊 MONITORING AND LOGGING
# ================================================================

# Logging configuration
LOG_LEVEL=INFO
LOG_FILE=/var/log/schlep-engine/app.log
LOG_FORMAT=json
LOG_ROTATION=true

# Sentry error tracking (highly recommended for production)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Prometheus metrics
PROMETHEUS_ENABLED=true
METRICS_RETENTION_DAYS=90

# OAuth-specific monitoring
OAUTH_MONITORING_ENABLED=true
OAUTH_SECURITY_ALERTS_ENABLED=true
OAUTH_FAILURE_THRESHOLD=10
OAUTH_ALERT_EMAIL=security@yourdomain.com

# ================================================================
# 🔔 NOTIFICATION SERVICES
# ================================================================

# Email configuration for security alerts
SMTP_HOST=your-smtp-host
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_TLS=true

# Alternative: SendGrid
SENDGRID_API_KEY=REPLACE_WITH_SENDGRID_API_KEY
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# ================================================================
# 🌐 EXTERNAL SERVICES
# ================================================================

# Content Delivery Network
CDN_URL=https://cdn.yourdomain.com
CDN_API_KEY=REPLACE_WITH_CDN_API_KEY

# File storage (production recommendations)
STORAGE_PROVIDER=gcs  # or s3, azure
STORAGE_BUCKET=schlep-engine-prod
STORAGE_REGION=us-central1
STORAGE_CREDENTIALS_PATH=/path/to/service-account-key.json

# ================================================================
# 🔧 PRODUCTION OPTIMIZATION
# ================================================================

# Application server configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4
WORKER_CLASS=uvicorn.workers.UvicornWorker
WORKER_CONNECTIONS=1000
MAX_REQUESTS=1000
MAX_REQUESTS_JITTER=100

# Connection pooling
HTTP_CLIENT_TIMEOUT=30
HTTP_CLIENT_POOL_SIZE=100
HTTP_CLIENT_POOL_MAX_SIZE=200

# Caching
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# ================================================================
# 🧪 FEATURE FLAGS (Production)
# ================================================================

# Core features (should be stable in production)
ENABLE_OAUTH_GOOGLE=true
ENABLE_OAUTH_GITHUB=true
ENABLE_OAUTH_DISCORD=false
ENABLE_PKCE=true
ENABLE_CSRF_PROTECTION=true

# Advanced features
ENABLE_ADVANCED_AI=true
ENABLE_ML_PIPELINE=true
ENABLE_DATA_PROCESSING=true
ENABLE_MONITORING=true
ENABLE_SECURITY=true

# Beta features (use with caution in production)
ENABLE_EXPERIMENTAL_FEATURES=false

# ================================================================
# 🔍 COMPLIANCE AND AUDITING
# ================================================================

# Data retention policies (GDPR compliance)
USER_DATA_RETENTION_DAYS=2555  # 7 years
OAUTH_LOG_RETENTION_DAYS=365   # 1 year
SECURITY_LOG_RETENTION_DAYS=2555

# Audit logging
AUDIT_LOGGING_ENABLED=true
AUDIT_LOG_LEVEL=INFO
AUDIT_LOG_INCLUDE_OAUTH=true

# Privacy settings
GDPR_COMPLIANCE_ENABLED=true
DATA_ANONYMIZATION_ENABLED=true
RIGHT_TO_ERASURE_ENABLED=true

# ================================================================
# 🔐 ADDITIONAL SECURITY MEASURES
# ================================================================

# Account security
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_UPPERCASE=true

# Session security
SESSION_TIMEOUT_MINUTES=480  # 8 hours
SESSION_ABSOLUTE_TIMEOUT_HOURS=24
REMEMBER_ME_DURATION_DAYS=30

# API security
API_RATE_LIMIT_STRICT=true
API_KEY_ROTATION_DAYS=30
API_CORS_STRICT=true

# Network security
ALLOWED_IPS=""  # Leave empty to allow all, or specify IPs for restrictions
BLOCKED_IPS=""
GEOIP_BLOCKING_ENABLED=false

# ================================================================
# 📝 MAINTENANCE AND BACKUP
# ================================================================

# Backup configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
BACKUP_RETENTION_DAYS=90
BACKUP_ENCRYPTION_ENABLED=true

# Maintenance windows
MAINTENANCE_MODE_ENABLED=false
MAINTENANCE_MESSAGE="Schlep Engine is temporarily unavailable for maintenance."

# Health checks
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_OAUTH_PROVIDERS=true

# ================================================================
# 🚨 EMERGENCY SETTINGS
# ================================================================

# Circuit breakers
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60

# Emergency OAuth disable (use only in security incidents)
EMERGENCY_OAUTH_DISABLE=false
EMERGENCY_OAUTH_MESSAGE="OAuth authentication temporarily disabled for security reasons."

# Emergency contacts (comma-separated emails)
EMERGENCY_CONTACTS="admin@yourdomain.com,security@yourdomain.com"

# ================================================================
# 📋 DEPLOYMENT VERIFICATION CHECKLIST
# ================================================================

# Before deploying, verify:
# [ ] All REPLACE_WITH_* values have been replaced with actual values
# [ ] OAuth provider configurations are tested in staging
# [ ] HTTPS is enforced for all OAuth redirect URIs
# [ ] Monitoring and alerting are configured
# [ ] Database and Redis connections are secure and tested
# [ ] Rate limiting is appropriate for production load
# [ ] All security keys are cryptographically strong and unique
# [ ] Backup and disaster recovery procedures are in place
# [ ] Security incident response plan is ready
# [ ] Performance benchmarks meet requirements

