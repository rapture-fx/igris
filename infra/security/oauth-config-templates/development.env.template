# 🛠️ DEVELOPMENT OAuth Configuration Template for Schlep Engine
# 
# Purpose: Local development environment for OAuth testing and development
# Use Case: Developer workstations, local testing, feature development
# Security Level: Moderate (secure but convenient for development)
#
# Generated: 2025-09-01
# Environment: DEVELOPMENT
#

# ================================================================
# 🔐 CORE DEVELOPMENT CONFIGURATION
# ================================================================

# Environment designation
ENVIRONMENT=development
DEBUG=true
TESTING=false

# Development security keys (separate from production, but still secure)
# Generate with: openssl rand -hex 32  (shorter for dev convenience)
SECRET_KEY=dev_secret_key_replace_with_actual_key_32_chars_minimum
JWT_SECRET_KEY=dev_jwt_secret_key_replace_with_actual_key_32_chars_minimum
JWT_ALGORITHM=HS256

# Token expiration (shorter for development convenience)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120  # 2 hours for development
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30     # Longer refresh for convenience

# Encryption key (development)
ENCRYPTION_KEY=dev_encryption_key_base64_encoded_fernet_key_here

# CSRF protection (still important in development)
CSRF_SECRET=dev_csrf_secret_32_characters_minimum

# ================================================================
# 🔑 OAUTH PROVIDER CONFIGURATION (DEVELOPMENT APPS)
# ================================================================

# Google OAuth 2.0 Configuration (Development App)
# Create separate OAuth app for development with localhost callbacks
GOOGLE_CLIENT_ID=REPLACE_WITH_DEV_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_DEV_GOOGLE_CLIENT_SECRET

# GitHub OAuth Configuration (Development App)
GITHUB_CLIENT_ID=REPLACE_WITH_DEV_GITHUB_CLIENT_ID  
GITHUB_CLIENT_SECRET=REPLACE_WITH_DEV_GITHUB_CLIENT_SECRET

# Discord OAuth Configuration (Optional for testing)
DISCORD_CLIENT_ID=REPLACE_WITH_DEV_DISCORD_CLIENT_ID
DISCORD_CLIENT_SECRET=REPLACE_WITH_DEV_DISCORD_CLIENT_SECRET

# OAuth redirect URI (localhost for development)
OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/callback

# OAuth security settings (relaxed for development)
OAUTH_STATE_EXPIRE_MINUTES=30  # Longer expiry for development
OAUTH_TOKEN_REFRESH_THRESHOLD=600
OAUTH_RATE_LIMIT_PER_PROVIDER=50  # Higher limits for development
OAUTH_RATE_LIMIT_WINDOW=60

# ================================================================
# 🛡️ DEVELOPMENT SECURITY CONFIGURATION
# ================================================================

# CORS configuration (permissive for local development)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:3002","http://127.0.0.1:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1","0.0.0.0"]

# Rate limiting (relaxed for development)
RATE_LIMIT_REQUESTS=10000  # High limit to avoid blocking development
RATE_LIMIT_WINDOW=3600

# Security headers (enabled but not strict)
SECURE_HEADERS_ENABLED=false  # May interfere with local development tools
HSTS_MAX_AGE=0  # Disabled for localhost
CONTENT_SECURITY_POLICY=""  # Disabled to allow dev tools

# ================================================================
# 💾 LOCAL DATABASE CONFIGURATION
# ================================================================

# Local PostgreSQL (Docker or local installation)
DATABASE_URL=postgresql+asyncpg://schlep_dev:dev_password@localhost:5432/schlep_engine_dev
DB_HOST=localhost
DB_PORT=5432
DB_NAME=schlep_engine_dev
DB_USER=schlep_dev
DB_PASSWORD=dev_password
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_SSL_MODE=disable  # SSL not required for local development

# Alternative: SQLite for simple local development
# DATABASE_URL=sqlite:///./schlep_engine_dev.db

# ================================================================
# 📡 LOCAL REDIS CONFIGURATION
# ================================================================

# Local Redis (Docker or local installation)
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""  # No password for local development
REDIS_DB=0
REDIS_SSL=false
USE_REDIS_CACHE=true

# Alternative: In-memory cache for simple development
# USE_REDIS_CACHE=false

# ================================================================
# 📊 DEVELOPMENT LOGGING AND DEBUGGING
# ================================================================

# Verbose logging for development
LOG_LEVEL=DEBUG
LOG_FILE=logs/development.log
LOG_FORMAT=colorized  # Colorized output for terminal
LOG_ROTATION=false

# Sentry (optional for development - use separate project)
SENTRY_DSN=""  # Leave empty to disable or use dev project
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0

# Metrics (optional in development)
PROMETHEUS_ENABLED=false
METRICS_RETENTION_DAYS=7

# OAuth monitoring (verbose for debugging)
OAUTH_MONITORING_ENABLED=true
OAUTH_SECURITY_ALERTS_ENABLED=false  # Disabled to avoid noise
OAUTH_FAILURE_THRESHOLD=100  # High threshold for development
OAUTH_ALERT_EMAIL=""

# ================================================================
# 📧 DEVELOPMENT NOTIFICATION SERVICES
# ================================================================

# Email (mock/file-based for development)
SMTP_HOST=""  # Leave empty to use file-based email
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_TLS=false

# Development email backend (saves emails to files)
EMAIL_BACKEND=file
EMAIL_FILE_PATH=logs/emails/

# SendGrid (disabled in development)
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL=""

# ================================================================
# 🌐 LOCAL EXTERNAL SERVICES
# ================================================================

# CDN (disabled in development)
CDN_URL=""
CDN_API_KEY=""

# Local file storage
STORAGE_PROVIDER=local
STORAGE_BUCKET=local-storage
STORAGE_PATH=./storage/
STORAGE_REGION=""
STORAGE_CREDENTIALS_PATH=""

# ================================================================
# 🔧 DEVELOPMENT SERVER CONFIGURATION
# ================================================================

# Local development server
HOST=0.0.0.0  # Allow connections from other devices on network
PORT=8000
WORKERS=1  # Single worker for easier debugging
WORKER_CLASS=uvicorn.workers.UvicornWorker
WORKER_CONNECTIONS=100
RELOAD=true  # Auto-reload on code changes
MAX_REQUESTS=0  # No limit for development
MAX_REQUESTS_JITTER=0

# Connection pooling (minimal for development)
HTTP_CLIENT_TIMEOUT=60  # Longer timeout for debugging
HTTP_CLIENT_POOL_SIZE=10
HTTP_CLIENT_POOL_MAX_SIZE=20

# Caching (short TTL for development)
CACHE_TTL=60
CACHE_MAX_SIZE=100

# ================================================================
# 🧪 DEVELOPMENT FEATURES AND FLAGS
# ================================================================

# Core OAuth features
ENABLE_OAUTH_GOOGLE=true
ENABLE_OAUTH_GITHUB=true
ENABLE_OAUTH_DISCORD=true  # Enable for testing
ENABLE_PKCE=true
ENABLE_CSRF_PROTECTION=true

# Development-specific features
ENABLE_TEST_ENDPOINTS=true
ENABLE_MOCK_PROVIDERS=false  # Use real providers for realistic testing
ENABLE_DEBUG_LOGGING=true
ENABLE_PERFORMANCE_PROFILING=false  # May slow down development
ENABLE_HOT_RELOAD=true
ENABLE_DEBUG_TOOLBAR=true

# Application features (enable all for development)
ENABLE_ADVANCED_AI=true
ENABLE_ML_PIPELINE=true
ENABLE_DATA_PROCESSING=true
ENABLE_MONITORING=false  # May be disabled to reduce complexity
ENABLE_SECURITY=true
ENABLE_EXPERIMENTAL_FEATURES=true

# ================================================================
# 🔍 DEVELOPMENT AUDITING (MINIMAL)
# ================================================================

# Data retention (short for development)
USER_DATA_RETENTION_DAYS=30
OAUTH_LOG_RETENTION_DAYS=7
SECURITY_LOG_RETENTION_DAYS=30

# Audit logging (minimal for development)
AUDIT_LOGGING_ENABLED=false
AUDIT_LOG_LEVEL=INFO
AUDIT_LOG_INCLUDE_OAUTH=true

# Privacy settings (relaxed for development)
GDPR_COMPLIANCE_ENABLED=false
DATA_ANONYMIZATION_ENABLED=false
RIGHT_TO_ERASURE_ENABLED=false

# ================================================================
# 🔐 DEVELOPMENT SECURITY (BALANCED)
# ================================================================

# Account security (relaxed for development convenience)
MAX_LOGIN_ATTEMPTS=20  # Higher limit to avoid lockouts during testing
LOCKOUT_DURATION_MINUTES=5  # Shorter lockout
PASSWORD_MIN_LENGTH=6  # Relaxed for test accounts
PASSWORD_REQUIRE_SPECIAL=false
PASSWORD_REQUIRE_NUMBERS=false
PASSWORD_REQUIRE_UPPERCASE=false

# Session security (longer sessions for convenience)
SESSION_TIMEOUT_MINUTES=480  # 8 hours
SESSION_ABSOLUTE_TIMEOUT_HOURS=24
REMEMBER_ME_DURATION_DAYS=30

# API security (relaxed)
API_RATE_LIMIT_STRICT=false
API_KEY_ROTATION_DAYS=365
API_CORS_STRICT=false

# Network security (open for local development)
ALLOWED_IPS=""
BLOCKED_IPS=""
GEOIP_BLOCKING_ENABLED=false

# ================================================================
# 🧪 DEVELOPMENT TESTING FEATURES
# ================================================================

# Test data and utilities
ENABLE_TEST_DATA_GENERATION=true
ENABLE_SEED_DATA=true
ENABLE_RESET_ENDPOINTS=true  # Endpoints to reset test data

# OAuth testing utilities
OAUTH_TEST_MODE=false  # Set to true to use mock OAuth responses
OAUTH_BYPASS_STATE=false  # Set to true to bypass state validation (development only)
OAUTH_MOCK_USER_DATA=false

# Performance testing (light)
PERFORMANCE_TESTING_ENABLED=false
LOAD_TESTING_MAX_USERS=10
LOAD_TESTING_DURATION=60

# ================================================================
# 🚨 DEVELOPMENT SAFETY MEASURES
# ================================================================

# Circuit breakers (disabled or relaxed)
CIRCUIT_BREAKER_ENABLED=false
CIRCUIT_BREAKER_FAILURE_THRESHOLD=10
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=30

# Development safeguards
DEV_DATA_ISOLATION=true
PRODUCTION_DATA_ACCESS=false
AUTO_CLEAN_TEST_DATA=true

# Emergency settings (for testing)
EMERGENCY_OAUTH_DISABLE=false
EMERGENCY_OAUTH_MESSAGE="OAuth disabled for development testing."
EMERGENCY_CONTACTS="developer@localhost"

# ================================================================
# 🔧 DEVELOPMENT TOOLS AND UTILITIES
# ================================================================

# Development utilities
ENABLE_API_DOCS=true  # Swagger/OpenAPI docs
ENABLE_GRAPHIQL=true  # GraphQL playground (if using GraphQL)
ENABLE_DB_ADMIN=true  # Database admin interface
ENABLE_REDIS_ADMIN=true  # Redis admin interface

# Code quality tools
ENABLE_LINTING=false  # May slow down development
ENABLE_TYPE_CHECKING=false
ENABLE_COVERAGE_REPORTING=false

# Development shortcuts
ENABLE_AUTO_LOGIN=false  # Bypass login for development (use carefully)
ENABLE_SKIP_EMAIL_VERIFICATION=true
ENABLE_ADMIN_BACKDOOR=false  # Super admin access (use very carefully)

