# 🧪 STAGING OAuth Configuration Template for Schlep Engine
# 
# Purpose: Pre-production testing environment that mirrors production
# Use Case: Final testing before production deployment
# Security Level: High (similar to production with testing accommodations)
#
# Generated: 2025-09-01
# Environment: STAGING
#

# ================================================================
# 🔐 CORE SECURITY CONFIGURATION
# ================================================================

# Environment designation
ENVIRONMENT=staging
DEBUG=false
TESTING=false

# Core security keys (Use strong keys, but separate from production)
# Generate with: openssl rand -hex 64
SECRET_KEY=REPLACE_WITH_STAGING_SECRET_KEY
JWT_SECRET_KEY=REPLACE_WITH_STAGING_JWT_SECRET_KEY
JWT_ALGORITHM=HS256

# Token expiration (same as production for realistic testing)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption key for OAuth token storage
ENCRYPTION_KEY=REPLACE_WITH_STAGING_ENCRYPTION_KEY

# CSRF protection key
CSRF_SECRET=REPLACE_WITH_STAGING_CSRF_SECRET

# ================================================================
# 🔑 OAUTH PROVIDER CONFIGURATION (STAGING)
# ================================================================

# Google OAuth 2.0 Configuration (Staging App)
# Create separate OAuth app for staging environment
GOOGLE_CLIENT_ID=REPLACE_WITH_STAGING_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_STAGING_GOOGLE_CLIENT_SECRET

# GitHub OAuth Configuration (Staging App)
GITHUB_CLIENT_ID=REPLACE_WITH_STAGING_GITHUB_CLIENT_ID  
GITHUB_CLIENT_SECRET=REPLACE_WITH_STAGING_GITHUB_CLIENT_SECRET

# Discord OAuth Configuration (Optional)
DISCORD_CLIENT_ID=REPLACE_WITH_STAGING_DISCORD_CLIENT_ID
DISCORD_CLIENT_SECRET=REPLACE_WITH_STAGING_DISCORD_CLIENT_SECRET

# OAuth redirect URI (Use staging domain)
OAUTH_REDIRECT_URI=https://staging.yourdomain.com/api/v1/auth/oauth/callback

# OAuth security settings (same as production)
OAUTH_STATE_EXPIRE_MINUTES=10
OAUTH_TOKEN_REFRESH_THRESHOLD=300
OAUTH_RATE_LIMIT_PER_PROVIDER=10
OAUTH_RATE_LIMIT_WINDOW=60

# ================================================================
# 🛡️ SECURITY CONFIGURATION
# ================================================================

# CORS configuration (allow staging domains)
ALLOWED_ORIGINS=["https://staging.yourdomain.com","https://staging-app.yourdomain.com"]
ALLOWED_HOSTS=["staging.yourdomain.com","staging-app.yourdomain.com"]

# Rate limiting (same as production for realistic testing)
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=3600

# Security headers (enabled for testing)
SECURE_HEADERS_ENABLED=true
HSTS_MAX_AGE=3600  # Shorter for staging
CONTENT_SECURITY_POLICY="default-src 'self' 'unsafe-eval' 'unsafe-inline';"

# ================================================================
# 💾 DATABASE CONFIGURATION
# ================================================================

# Staging database (separate from production)
DATABASE_URL=postgresql+asyncpg://staging_user:password@staging-db-host:5432/schlep_engine_staging
DB_HOST=staging-db-host
DB_PORT=5432
DB_NAME=schlep_engine_staging
DB_USER=schlep_engine_staging
DB_PASSWORD=REPLACE_WITH_STAGING_DB_PASSWORD
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_SSL_MODE=prefer

# ================================================================
# 📡 REDIS CONFIGURATION
# ================================================================

# Staging Redis (separate from production)
REDIS_URL=redis://staging-redis-host:6379/0
REDIS_HOST=staging-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_STAGING_REDIS_PASSWORD
REDIS_DB=0
REDIS_SSL=false  # May not be required in staging
USE_REDIS_CACHE=true

# ================================================================
# 📊 MONITORING AND LOGGING
# ================================================================

# Enhanced logging for debugging
LOG_LEVEL=DEBUG
LOG_FILE=/var/log/schlep-engine/staging.log
LOG_FORMAT=json
LOG_ROTATION=true

# Sentry (use separate project for staging)
SENTRY_DSN=https://staging-sentry-dsn@sentry.io/staging-project-id
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=1.0  # Full tracing in staging
SENTRY_PROFILES_SAMPLE_RATE=1.0

# Metrics
PROMETHEUS_ENABLED=true
METRICS_RETENTION_DAYS=30

# OAuth monitoring (enhanced for testing)
OAUTH_MONITORING_ENABLED=true
OAUTH_SECURITY_ALERTS_ENABLED=true
OAUTH_FAILURE_THRESHOLD=5  # Lower threshold for testing
OAUTH_ALERT_EMAIL=staging-alerts@yourdomain.com

# ================================================================
# 🔔 NOTIFICATION SERVICES
# ================================================================

# Email (staging configuration)
SMTP_HOST=staging-smtp-host
SMTP_PORT=587
SMTP_USER=staging-noreply@yourdomain.com
SMTP_PASSWORD=REPLACE_WITH_STAGING_SMTP_PASSWORD
SMTP_TLS=true

# SendGrid (staging key)
SENDGRID_API_KEY=REPLACE_WITH_STAGING_SENDGRID_API_KEY
SENDGRID_FROM_EMAIL=staging-noreply@yourdomain.com

# ================================================================
# 🌐 EXTERNAL SERVICES
# ================================================================

# CDN (staging)
CDN_URL=https://staging-cdn.yourdomain.com
CDN_API_KEY=REPLACE_WITH_STAGING_CDN_API_KEY

# Storage (staging bucket)
STORAGE_PROVIDER=gcs
STORAGE_BUCKET=schlep-engine-staging
STORAGE_REGION=us-central1
STORAGE_CREDENTIALS_PATH=/path/to/staging-service-account-key.json

# ================================================================
# 🔧 APPLICATION CONFIGURATION
# ================================================================

# Server settings (optimized for testing)
HOST=0.0.0.0
PORT=8000
WORKERS=2  # Fewer workers in staging
WORKER_CLASS=uvicorn.workers.UvicornWorker
WORKER_CONNECTIONS=500
MAX_REQUESTS=500
MAX_REQUESTS_JITTER=50

# Connection pooling (smaller pools for staging)
HTTP_CLIENT_TIMEOUT=30
HTTP_CLIENT_POOL_SIZE=50
HTTP_CLIENT_POOL_MAX_SIZE=100

# Caching (shorter TTL for testing)
CACHE_TTL=300
CACHE_MAX_SIZE=500

# ================================================================
# 🧪 TESTING AND DEBUGGING FEATURES
# ================================================================

# Feature flags (enable testing features)
ENABLE_OAUTH_GOOGLE=true
ENABLE_OAUTH_GITHUB=true
ENABLE_OAUTH_DISCORD=true  # May enable for testing
ENABLE_PKCE=true
ENABLE_CSRF_PROTECTION=true

# Testing features
ENABLE_TEST_ENDPOINTS=true
ENABLE_MOCK_PROVIDERS=false
ENABLE_DEBUG_LOGGING=true
ENABLE_PERFORMANCE_PROFILING=true

# Advanced features (test all features)
ENABLE_ADVANCED_AI=true
ENABLE_ML_PIPELINE=true
ENABLE_DATA_PROCESSING=true
ENABLE_MONITORING=true
ENABLE_SECURITY=true
ENABLE_EXPERIMENTAL_FEATURES=true  # Test beta features

# ================================================================
# 🔍 COMPLIANCE AND AUDITING (RELAXED FOR TESTING)
# ================================================================

# Data retention (shorter for staging)
USER_DATA_RETENTION_DAYS=90
OAUTH_LOG_RETENTION_DAYS=30
SECURITY_LOG_RETENTION_DAYS=90

# Audit logging (enhanced for testing)
AUDIT_LOGGING_ENABLED=true
AUDIT_LOG_LEVEL=DEBUG
AUDIT_LOG_INCLUDE_OAUTH=true

# Privacy settings (testing mode)
GDPR_COMPLIANCE_ENABLED=true
DATA_ANONYMIZATION_ENABLED=false  # Keep data for debugging
RIGHT_TO_ERASURE_ENABLED=true

# ================================================================
# 🔐 SECURITY MEASURES (PRODUCTION-LIKE)
# ================================================================

# Account security (same as production)
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15  # Shorter for testing
PASSWORD_MIN_LENGTH=8  # May be relaxed for testing
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_UPPERCASE=true

# Session security
SESSION_TIMEOUT_MINUTES=120  # Shorter for testing
SESSION_ABSOLUTE_TIMEOUT_HOURS=8
REMEMBER_ME_DURATION_DAYS=7

# API security
API_RATE_LIMIT_STRICT=false  # Relaxed for testing
API_KEY_ROTATION_DAYS=90
API_CORS_STRICT=false

# Network security (open for testing)
ALLOWED_IPS=""
BLOCKED_IPS=""
GEOIP_BLOCKING_ENABLED=false

# ================================================================
# 📝 TESTING AND QA CONFIGURATION
# ================================================================

# Test automation
ENABLE_AUTOMATED_TESTS=true
TEST_OAUTH_PROVIDERS=["google", "github"]
TEST_FAILURE_SIMULATION=true
TEST_LOAD_SIMULATION=true

# Performance testing
PERFORMANCE_TESTING_ENABLED=true
LOAD_TESTING_MAX_USERS=100
LOAD_TESTING_DURATION=300

# Security testing
SECURITY_TESTING_ENABLED=true
PENETRATION_TESTING_MODE=false
VULNERABILITY_SCANNING=true

# ================================================================
# 🚨 TESTING SAFETY MEASURES
# ================================================================

# Circuit breakers (more sensitive for testing)
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=30

# Testing safeguards
STAGING_DATA_ISOLATION=true
PRODUCTION_DATA_ACCESS=false
TEST_DATA_CLEANUP=true

# Emergency settings (for testing emergency procedures)
EMERGENCY_OAUTH_DISABLE=false
EMERGENCY_OAUTH_MESSAGE="Staging OAuth temporarily disabled for testing."
EMERGENCY_CONTACTS="staging-admin@yourdomain.com"

# ================================================================
# 📋 STAGING DEPLOYMENT CHECKLIST
# ================================================================

# Before deploying to staging:
# [ ] All OAuth providers configured with staging applications
# [ ] Staging database is isolated from production
# [ ] Test data is populated and realistic
# [ ] Monitoring and alerting are configured
# [ ] Load testing environment is prepared
# [ ] Security testing tools are configured
# [ ] Staging domain certificates are valid
# [ ] CDN and external services point to staging resources
# [ ] Performance benchmarks are established
# [ ] Rollback procedures are tested

# ================================================================
# 🔬 TESTING SCENARIOS
# ================================================================

# OAuth Testing Scenarios to validate:
# [ ] Google OAuth flow (success and failure cases)
# [ ] GitHub OAuth flow (success and failure cases)
# [ ] PKCE implementation and validation
# [ ] CSRF protection mechanisms
# [ ] Rate limiting under load
# [ ] Token refresh and expiration
# [ ] Account linking and unlinking
# [ ] Security headers and CORS
# [ ] Error handling and logging
# [ ] Performance under concurrent users

