# Production Environment Variables for Schlep-Engine
# IMPORTANT: Copy this to .env and NEVER commit the actual values

# Authentication & Security
JWT_SECRET=<GENERATE_64_CHAR_SECRET>
API_KEY_MASTER=<GENERATE_API_KEY>
GRAFANA_PASSWORD=<SECURE_GRAFANA_PASSWORD>

# Database Configuration
POSTGRES_DB=schlep_engine_prod
POSTGRES_USER=schlep_user
POSTGRES_PASSWORD=<STRONG_32_CHAR_PASSWORD>

# Redis Configuration
REDIS_PASSWORD=<STRONG_24_CHAR_PASSWORD>

# Service Secrets (generate these with strong values)
ML_SERVICE_SECRET_KEY=<GENERATE_64_CHAR_SECRET>
ENCRYPTION_KEY=<GENERATE_32_CHAR_ENCRYPTION_KEY>

# External Service Keys (if using)
SENTRY_DSN=<YOUR_SENTRY_DSN>
SLACK_WEBHOOK_URL=<YOUR_SLACK_WEBHOOK>

# Certificates (if using custom SSL)
SSL_CERT_PATH=/etc/nginx/ssl/server.crt
SSL_KEY_PATH=/etc/nginx/ssl/server.key
