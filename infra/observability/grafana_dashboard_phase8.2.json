{
  "dashboard": {
    "title": "Phase 8.2 Production Hardening - Adaptive Orchestration",
    "tags": ["phase-8.2", "canary", "adaptive-orchestration", "production"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "30s",
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Cache Hit Rate - Canary vs Stable",
        "type": "graph",
        "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(schlep_cache_hits_total{endpoint=\"canary\"}[5m]) / rate(schlep_cache_requests_total{endpoint=\"canary\"}[5m])",
            "legendFormat": "Canary (Phase 10)",
            "refId": "A"
          },
          {
            "expr": "rate(schlep_cache_hits_total{endpoint=\"stable\"}[5m]) / rate(schlep_cache_requests_total{endpoint=\"stable\"}[5m])",
            "legendFormat": "Stable (Phase 8)",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "percentunit", "min": 0, "max": 1}
        ],
        "alert": {
          "conditions": [
            {
              "evaluator": {"params": [0.85], "type": "lt"},
              "query": {"params": ["A", "5m", "now"]},
              "type": "query"
            }
          ],
          "name": "Cache Hit Rate Below Target"
        }
      },
      {
        "id": 2,
        "title": "P99 Latency - Canary vs Stable",
        "type": "graph",
        "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.99, rate(schlep_inference_latency_ms_bucket{endpoint=\"canary\"}[5m]))",
            "legendFormat": "Canary P99",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.99, rate(schlep_inference_latency_ms_bucket{endpoint=\"stable\"}[5m]))",
            "legendFormat": "Stable P99",
            "refId": "B"
          },
          {
            "expr": "150",
            "legendFormat": "Target (150ms)",
            "refId": "C"
          }
        ],
        "yaxes": [
          {"format": "ms", "min": 0}
        ]
      },
      {
        "id": 3,
        "title": "Error Rate - Canary vs Stable",
        "type": "graph",
        "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(schlep_inference_errors_total{endpoint=\"canary\"}[5m])",
            "legendFormat": "Canary Errors/sec",
            "refId": "A"
          },
          {
            "expr": "rate(schlep_inference_errors_total{endpoint=\"stable\"}[5m])",
            "legendFormat": "Stable Errors/sec",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "short", "min": 0}
        ]
      },
      {
        "id": 4,
        "title": "Policy Updates & Rollbacks",
        "type": "graph",
        "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(schlep_policy_updates_total{status=\"success\"}[5m])",
            "legendFormat": "Successful Updates",
            "refId": "A"
          },
          {
            "expr": "rate(schlep_policy_updates_total{status=\"rejected\"}[5m])",
            "legendFormat": "Rejected Updates",
            "refId": "B"
          },
          {
            "expr": "rate(schlep_rollbacks_triggered_total[5m])",
            "legendFormat": "Rollbacks Triggered",
            "refId": "C"
          }
        ]
      },
      {
        "id": 5,
        "title": "Drift Monitor - Anomaly Detection",
        "type": "graph",
        "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "schlep_drift_percent",
            "legendFormat": "Current Drift %",
            "refId": "A"
          },
          {
            "expr": "5.0",
            "legendFormat": "Rollback Threshold (5%)",
            "refId": "B"
          },
          {
            "expr": "rate(schlep_drift_events_total{severity=\"high\"}[5m])",
            "legendFormat": "High Severity Drift Events",
            "refId": "C"
          }
        ],
        "yaxes": [
          {"format": "percent"}
        ]
      },
      {
        "id": 6,
        "title": "Feedback Loop - Reward Score",
        "type": "graph",
        "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "schlep_reward_score",
            "legendFormat": "Current Reward",
            "refId": "A"
          },
          {
            "expr": "rate(schlep_optimization_iterations[5m])",
            "legendFormat": "Optimization Iterations",
            "refId": "B"
          }
        ]
      },
      {
        "id": 7,
        "title": "Batch Size Adaptation",
        "type": "graph",
        "gridPos": {"x": 0, "y": 24, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "schlep_batch_size{endpoint=\"canary\"}",
            "legendFormat": "Canary Batch Size",
            "refId": "A"
          },
          {
            "expr": "schlep_batch_size{endpoint=\"stable\"}",
            "legendFormat": "Stable Batch Size",
            "refId": "B"
          }
        ]
      },
      {
        "id": 8,
        "title": "Traffic Split - Canary vs Stable",
        "type": "piechart",
        "gridPos": {"x": 12, "y": 24, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "sum(rate(schlep_inference_requests_total{endpoint=\"canary\"}[5m]))",
            "legendFormat": "Canary (10%)",
            "refId": "A"
          },
          {
            "expr": "sum(rate(schlep_inference_requests_total{endpoint=\"stable\"}[5m]))",
            "legendFormat": "Stable (90%)",
            "refId": "B"
          }
        ]
      },
      {
        "id": 9,
        "title": "Telemetry Synthesizer - Events Processed",
        "type": "stat",
        "gridPos": {"x": 0, "y": 32, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "rate(schlep_telemetry_events_ingested_total[5m])",
            "refId": "A"
          }
        ],
        "options": {
          "reduceOptions": {"calcs": ["lastNotNull"]},
          "text": {"titleSize": 16, "valueSize": 48}
        }
      },
      {
        "id": 10,
        "title": "Uptime (72h)",
        "type": "stat",
        "gridPos": {"x": 6, "y": 32, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "avg_over_time(up{job=\"inference-canary\"}[72h])",
            "refId": "A"
          }
        ],
        "options": {
          "reduceOptions": {"calcs": ["lastNotNull"]},
          "text": {"titleSize": 16, "valueSize": 48},
          "thresholds": {
            "steps": [
              {"color": "red", "value": 0},
              {"color": "yellow", "value": 0.999},
              {"color": "green", "value": 0.9999}
            ]
          }
        }
      },
      {
        "id": 11,
        "title": "Recovery Time (Chaos Tests)",
        "type": "stat",
        "gridPos": {"x": 12, "y": 32, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(schlep_recovery_duration_seconds_bucket[5m]))",
            "refId": "A"
          }
        ],
        "options": {
          "unit": "s",
          "thresholds": {
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 2.0},
              {"color": "red", "value": 5.0}
            ]
          }
        }
      },
      {
        "id": 12,
        "title": "Policy Confidence Score",
        "type": "gauge",
        "gridPos": {"x": 18, "y": 32, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "schlep_policy_confidence_score",
            "refId": "A"
          }
        ],
        "options": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "steps": [
              {"color": "red", "value": 0},
              {"color": "yellow", "value": 0.85},
              {"color": "green", "value": 0.95}
            ]
          }
        }
      }
    ],
    "annotations": {
      "list": [
        {
          "name": "Deployments",
          "datasource": "Prometheus",
          "expr": "changes(schlep_deployment_info[5m]) > 0",
          "tagKeys": "phase,version"
        },
        {
          "name": "Chaos Tests",
          "datasource": "Prometheus",
          "expr": "schlep_chaos_test_active == 1",
          "iconColor": "red"
        },
        {
          "name": "Policy Changes",
          "datasource": "Prometheus",
          "expr": "changes(schlep_policy_version[1m]) > 0",
          "iconColor": "blue"
        }
      ]
    }
  }
}
