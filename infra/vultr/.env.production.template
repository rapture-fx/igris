# =============================================================================
# SCHLEP ENGINE - VULTR PRODUCTION ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env.production and fill in your values

# =============================================================================
# CORE CONFIGURATION
# =============================================================================
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
APP_VERSION=1.0.0

# =============================================================================
# SECURITY KEYS (GENERATE UNIQUE VALUES)
# =============================================================================
# Generate with: openssl rand -hex 32
SECRET_KEY=your-32-character-secret-key-here
JWT_SECRET_KEY=your-32-character-jwt-secret-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_URL=postgresql://schlep_user:your-db-password@postgres:5432/schlep_engine
POSTGRES_USER=schlep_user
POSTGRES_PASSWORD=your-secure-database-password-here
POSTGRES_DB=schlep_engine

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# =============================================================================
# DOMAIN AND CORS CONFIGURATION
# =============================================================================
# Your Vultr VPS IP
VPS_IP=45.77.44.216

# Allowed origins for CORS
ALLOWED_ORIGINS=https://schlep-engine.com,https://admin.schlep-engine.com,https://docs.schlep-engine.com,https://api.schlep-engine.com

# Allowed hosts
ALLOWED_HOSTS=schlep-engine.com,api.schlep-engine.com,admin.schlep-engine.com,docs.schlep-engine.com,*.schlep-engine.com,45.77.44.216

# Application URLs
API_URL=https://api.schlep-engine.com
FRONTEND_URL=https://schlep-engine.com
ADMIN_URL=https://admin.schlep-engine.com
DOCS_URL=https://docs.schlep-engine.com

# =============================================================================
# STORAGE CONFIGURATION
# =============================================================================
UPLOAD_MAX_SIZE=100MB
STORAGE_PATH=/app/storage

# =============================================================================
# ML AND AI CONFIGURATION
# =============================================================================
ML_WORKERS=2
ML_BATCH_SIZE=16
TENSORFLOW_INTER_OP_PARALLELISM_THREADS=2
TENSORFLOW_INTRA_OP_PARALLELISM_THREADS=2

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_ML_PROCESSING=true
ENABLE_DOCUMENT_EXTRACTION=true
ENABLE_VECTOR_SEARCH=true

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_PERIOD=60

# =============================================================================
# MONITORING AND LOGGING
# =============================================================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# =============================================================================
# EMAIL CONFIGURATION (Optional)
# =============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
FROM_EMAIL=noreply@schlep-engine.com

# =============================================================================
# CLOUDFLARE CONFIGURATION (Optional)
# =============================================================================
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=7

# =============================================================================
# SYSTEM CONFIGURATION
# =============================================================================
HOST=0.0.0.0
PORT=3001

# Worker configuration for production
WORKERS=2
WORKER_CLASS=uvicorn.workers.UvicornWorker
WORKER_TIMEOUT=120
KEEPALIVE=2

# =============================================================================
# INSTRUCTIONS
# =============================================================================
# 1. Copy this file to .env.production
# 2. Generate secrets: openssl rand -hex 32
# 3. Replace all placeholder values
# 4. Set secure database password
# 5. Configure your domain settings
# 6. Enable features as needed
# =============================================================================