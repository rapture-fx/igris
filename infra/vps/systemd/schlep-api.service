[Unit]
Description=Schlep API Service
After=network.target redis.service
Wants=redis.service

[Service]
Type=simple
User=schlep
Group=schlep
WorkingDirectory=/opt/schlep
ExecStart=/usr/local/bin/schlep-api
EnvironmentFile=/opt/schlep/.env
Restart=always
RestartSec=10s

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/schlep/logs

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target
