{
  "dashboard": {
    "id": null,
    "title": "Schlep-engine Business Impact Alerting Dashboard",
    "tags": ["schlep-engine", "alerts", "business-impact"],
    "style": "dark",
    "timezone": "browser",
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "templating": {
      "list": [
        {
          "name": "severity",
          "type": "custom",
          "options": [
            { "text": "All", "value": ".*" },
            { "text": "Critical", "value": "critical" },
            { "text": "High", "value": "high" },
            { "text": "Medium", "value": "medium" },
            { "text": "Low", "value": "low" }
          ],
          "current": { "text": "All", "value": ".*" }
        },
        {
          "name": "service",
          "type": "query",
          "query": "label_values(ALERTS, service)",
          "refresh": 1,
          "sort": 1
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "title": "Active Alerts by Severity",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "count by (severity) (ALERTS{alertstate=\"firing\", severity=~\"$severity\"})",
            "legendFormat": "{{ severity }}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 1 },
                { "color": "orange", "value": 3 },
                { "color": "red", "value": 5 }
              ]
            }
          }
        },
        "options": {
          "colorMode": "background",
          "reduceOptions": {
            "calcs": ["lastNotNull"]
          }
        }
      },
      {
        "id": 2,
        "title": "Business Impact Score",
        "type": "gauge",
        "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
        "targets": [
          {
            "expr": "avg(business_impact_score)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 1,
            "thresholds": {
              "steps": [
                { "color": "green", "value": 0 },
                { "color": "yellow", "value": 0.3 },
                { "color": "orange", "value": 0.6 },
                { "color": "red", "value": 0.8 }
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "Revenue Impact (Estimated)",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
        "targets": [
          {
            "expr": "sum(estimated_revenue_loss_per_hour)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                { "color": "green", "value": 0 },
                { "color": "yellow", "value": 1000 },
                { "color": "orange", "value": 5000 },
                { "color": "red", "value": 10000 }
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "SLA Compliance Status",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
        "targets": [
          {
            "expr": "avg_over_time(up[30d]) * 100",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "decimals": 3,
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                { "color": "red", "value": 0 },
                { "color": "orange", "value": 99 },
                { "color": "yellow", "value": 99.5 },
                { "color": "green", "value": 99.9 }
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "title": "Alert Timeline",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 4 },
        "targets": [
          {
            "expr": "ALERTS{alertstate=\"firing\", severity=~\"$severity\"}",
            "legendFormat": "{{ alertname }} ({{ severity }})",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "bars",
              "lineInterpolation": "stepAfter",
              "barAlignment": 0,
              "fillOpacity": 80,
              "gradientMode": "none",
              "hideFrom": {
                "legend": false,
                "tooltip": false,
                "vis": false
              },
              "lineWidth": 1,
              "pointSize": 5,
              "scaleDistribution": {
                "type": "linear"
              },
              "showPoints": "never",
              "spanNulls": false,
              "stacking": {
                "group": "A",
                "mode": "normal"
              },
              "thresholdsStyle": {
                "mode": "off"
              }
            },
            "color": {
              "mode": "palette-classic"
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byRegexp",
                "options": ".*critical.*"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "red"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byRegexp",
                "options": ".*high.*"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "orange"
                  }
                }
              ]
            }
          ]
        }
      },
      {
        "id": 6,
        "title": "Alert Summary Table",
        "type": "table",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
        "targets": [
          {
            "expr": "ALERTS{alertstate=\"firing\", severity=~\"$severity\", service=~\"$service\"}",
            "format": "table",
            "instant": true,
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "align": "auto",
              "displayMode": "auto"
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "severity"
              },
              "properties": [
                {
                  "id": "custom.displayMode",
                  "value": "color-background"
                },
                {
                  "id": "color",
                  "value": {
                    "mode": "thresholds"
                  }
                },
                {
                  "id": "thresholds",
                  "value": {
                    "steps": [
                      { "color": "green", "value": null },
                      { "color": "yellow", "value": "medium" },
                      { "color": "orange", "value": "high" },
                      { "color": "red", "value": "critical" }
                    ]
                  }
                }
              ]
            }
          ]
        },
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {
                "__name__": true,
                "job": true,
                "instance": true
              },
              "indexByName": {
                "alertname": 0,
                "severity": 1,
                "service": 2,
                "description": 3,
                "business_impact": 4
              }
            }
          }
        ]
      },
      {
        "id": 7,
        "title": "Business Impact Heatmap",
        "type": "heatmap",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
        "targets": [
          {
            "expr": "increase(ALERTS_FOR_STATE{alertstate=\"firing\"}[1h])",
            "legendFormat": "{{ severity }}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "hideFrom": {
                "legend": false,
                "tooltip": false,
                "vis": false
              },
              "scaleDistribution": {
                "type": "linear"
              }
            }
          }
        }
      },
      {
        "id": 8,
        "title": "Alert Response Metrics",
        "type": "timeseries",
        "gridPos": { "h": 6, "w": 8, "x": 0, "y": 20 },
        "targets": [
          {
            "expr": "avg(alert_response_time_seconds)",
            "legendFormat": "Avg Response Time",
            "refId": "A"
          },
          {
            "expr": "avg(alert_resolution_time_seconds)",
            "legendFormat": "Avg Resolution Time",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "lineWidth": 2,
              "fillOpacity": 10,
              "gradientMode": "none",
              "showPoints": "auto",
              "pointSize": 5
            }
          }
        }
      },
      {
        "id": 9,
        "title": "Escalation Statistics",
        "type": "stat",
        "gridPos": { "h": 6, "w": 8, "x": 8, "y": 20 },
        "targets": [
          {
            "expr": "sum(rate(alert_escalations_total[1h]))",
            "legendFormat": "Escalations/hour",
            "refId": "A"
          },
          {
            "expr": "avg(alert_escalation_level)",
            "legendFormat": "Avg Escalation Level",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 1 },
                { "color": "orange", "value": 3 },
                { "color": "red", "value": 5 }
              ]
            }
          }
        }
      },
      {
        "id": 10,
        "title": "Customer Impact Distribution",
        "type": "piechart",
        "gridPos": { "h": 6, "w": 8, "x": 16, "y": 20 },
        "targets": [
          {
            "expr": "count by (customer_facing) (ALERTS{alertstate=\"firing\"})",
            "legendFormat": "{{ customer_facing }}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "hideFrom": {
                "legend": false,
                "tooltip": false,
                "vis": false
              }
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "true"
              },
              "properties": [
                {
                  "id": "displayName",
                  "value": "Customer Facing"
                },
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "red"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "false"
              },
              "properties": [
                {
                  "id": "displayName",
                  "value": "Internal Only"
                },
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "green"
                  }
                }
              ]
            }
          ]
        }
      },
      {
        "id": 11,
        "title": "Service Health Overview",
        "type": "stat",
        "gridPos": { "h": 4, "w": 24, "x": 0, "y": 26 },
        "targets": [
          {
            "expr": "up{job=\"api\"} * 100",
            "legendFormat": "API",
            "refId": "A"
          },
          {
            "expr": "up{job=\"database\"} * 100",
            "legendFormat": "Database",
            "refId": "B"
          },
          {
            "expr": "up{job=\"redis\"} * 100",
            "legendFormat": "Redis",
            "refId": "C"
          },
          {
            "expr": "up{job=\"ml-pipeline\"} * 100",
            "legendFormat": "ML Pipeline",
            "refId": "D"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                { "color": "red", "value": 0 },
                { "color": "yellow", "value": 50 },
                { "color": "green", "value": 100 }
              ]
            }
          }
        },
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "auto"
        }
      }
    ]
  }
}