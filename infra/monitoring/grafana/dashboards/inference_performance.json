{
  "dashboard": {
    "title": "Schlep-Engine: ML Inference Performance",
    "tags": ["ml", "inference", "performance"],
    "timezone": "browser",
    "refresh": "10s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Inference Latency by Model (P99)",
        "type": "graph",
        "gridPos": {"x": 0, "y": 0, "w": 24, "h": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.99, rate(ml_inference_latency_milliseconds_bucket[5m]))",
            "legendFormat": "{{model_id}} ({{model_version}}) P99",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "ms", "label": "Latency"}
        ],
        "alert": {
          "name": "High Inference Latency",
          "conditions": [
            {
              "type": "query",
              "query": {"params": ["A", "5m", "now"]},
              "reducer": {"type": "max"},
              "evaluator": {"type": "gt", "params": [100]}
            }
          ],
          "executionErrorState": "alerting",
          "frequency": "1m",
          "handler": 1,
          "message": "Inference P99 latency exceeded 100ms threshold",
          "noDataState": "no_data"
        }
      },
      {
        "id": 2,
        "title": "Inference Request Rate (per model)",
        "type": "graph",
        "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(ml_inference_requests_total[5m])",
            "legendFormat": "{{model_id}} - {{status}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "reqps", "label": "Requests/sec"}
        ]
      },
      {
        "id": 3,
        "title": "Inference Error Rate",
        "type": "graph",
        "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(ml_inference_errors_total[5m]) / rate(ml_inference_requests_total[5m])",
            "legendFormat": "{{model_id}} error rate",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "percentunit", "label": "Error Rate"}
        ]
      },
      {
        "id": 4,
        "title": "Model Load Time",
        "type": "graph",
        "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(model_load_time_milliseconds_bucket[5m]))",
            "legendFormat": "{{model_id}} ({{model_version}}) P95",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "ms", "label": "Load Time"}
        ]
      },
      {
        "id": 5,
        "title": "Model Hot Reloads",
        "type": "graph",
        "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(model_reloads_total[5m])",
            "legendFormat": "{{model_id}} - {{status}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "ops", "label": "Reloads/sec"}
        ]
      }
    ]
  }
}
