    "annotations": {
      "list": [
        {
          "name": "Cost Alerts",
          "datasource": "Prometheus",
          "enable": true,
          "expr": "ALERTS{alertname=~\".*Cost.*|.*Budget.*\"}",
          "iconColor": "red",
          "tags": ["cost", "budget"]
        }
      ]
    },
    "templating": {
      "list": [
        {
          "name": "service",
          "type": "query",
          "datasource": "Prometheus",
          "query": "label_values(cost_current_month_dollars, service)",
          "refresh": 1,
          "includeAll": true,
          "allValue": ".*",
          "multi": true
        },
        {
          "name": "timerange",
          "type": "interval",
          "query": "1h,6h,12h,1d,7d,30d",
          "current": {
            "text": "1h",
            "value": "1h"
          }
        }
      ]
    },
    "links": [
      {
        "title": "Cost Optimization Runbook",
        "url": "https://docs.schlep-engine.com/runbooks/cost-management",
