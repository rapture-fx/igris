        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
        "options": {
          "tooltip": {
            "mode": "multi"
          },
          "legend": {
            "calcs": ["lastNotNull"],
            "displayMode": "table",
            "placement": "bottom"
          }
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "axisLabel": "",
              "axisPlacement": "auto",
              "drawStyle": "line",
              "fillOpacity": 20,
              "gradientMode": "none",
              "lineInterpolation": "linear",
              "lineWidth": 2,
              "pointSize": 5,
              "showPoints": "never",
              "spanNulls": false,
              "stacking": {
                "group": "A",
                "mode": "none"
              },
              "thresholdsStyle": {
                "mode": "line"
              }
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 145
                },
                {
                  "color": "red",
                  "value": 160
                }
              ]
            },
            "unit": "currencyUSD"
          }
        }
      },
      {
        "id": 7,
        "title": "Usage Metrics Overview",
        "type": "table",
        "targets": [
          {
            "expr": "api_requests_monthly",
            "legendFormat": "API Requests",
            "refId": "A",
            "format": "table"
          },
          {
            "expr": "storage_used_gb",
            "legendFormat": "Storage Used (GB)",
            "refId": "B",
            "format": "table"
          },
          {
            "expr": "database_active_connections",
            "legendFormat": "DB Connections",
            "refId": "C",
            "format": "table"
          },
          {
            "expr": "redis_memory_used_mb",
            "legendFormat": "Redis Memory (MB)",
            "refId": "D",
            "format": "table"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
        "options": {
          "showHeader": true
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "custom": {
              "align": "auto",
              "displayMode": "color-background"
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
