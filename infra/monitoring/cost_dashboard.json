                {
                  "color": "yellow",
                  "value": 80
                },
                {
                  "color": "red",
                  "value": 95
                }
              ]
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "API Requests"
              },
              "properties": [
                {
                  "id": "max",
                  "value": 50000
                },
                {
                  "id": "unit",
                  "value": "short"
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Storage Used (GB)"
              },
              "properties": [
                {
                  "id": "max",
                  "value": 100
                },
                {
                  "id": "unit",
                  "value": "bytes"
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "DB Connections"
              },
              "properties": [
                {
                  "id": "max",
                  "value": 100
                },
                {
                  "id": "unit",
                  "value": "short"
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
