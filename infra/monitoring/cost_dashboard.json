      {
        "id": 11,
        "title": "Active Cost Alerts",
        "type": "table",
        "targets": [
          {
            "expr": "ALERTS{alertname=~\".*Cost.*|.*Budget.*\"}",
            "legendFormat": "",
            "refId": "A",
            "format": "table"
