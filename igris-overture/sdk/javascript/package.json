{
  "name": "igris-inertial",
  "version": "1.0.0",
  "description": "Official Igris Inertial JavaScript SDK - Intelligent AI routing, Thompson Sampling, and cost optimization with Rust WASM acceleration",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./wasm": {
      "import": "./wasm/escapevector_wasm.js",
      "types": "./wasm/escapevector_wasm.d.ts"
    }
  },
  "files": [
    "dist",
    "wasm",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs && npm run build:types",
    "build:esm": "esbuild src/index.ts --bundle --platform=node --target=node16 --format=esm --outfile=dist/index.js --external:node-fetch",
    "build:cjs": "esbuild src/index.ts --bundle --platform=node --target=node16 --format=cjs --outfile=dist/index.cjs --external:node-fetch",
    "build:types": "tsc --declaration --emitDeclarationOnly --outDir dist",
    "test": "jest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "igris",
    "igris-inertial",
    "ai-routing",
    "llm",
    "openai",
    "anthropic",
    "cost-optimization",
    "thompson-sampling",
    "wasm",
    "byok"
  ],
  "author": "Igris Inertial Team <support@igrisinertial.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Igris-inertial/system.git",
    "directory": "igris-overture/sdk/javascript"
  },
  "bugs": {
    "url": "https://github.com/Igris-inertial/system/issues"
  },
  "homepage": "https://docs.igrisinertial.com/sdk/javascript",
  "dependencies": {
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/node-fetch": "^2.6.11",
    "esbuild": "^0.19.0",
    "typescript": "^5.0.0",
    "jest": "^29.0.0",
    "@types/jest": "^29.0.0",
    "ts-jest": "^29.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
