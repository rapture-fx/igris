{
  "name": "igris",
  "version": "1.0.0-rc1",
  "description": "Official Igris Overture JavaScript SDK for intelligent AI routing and cost optimization",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs && npm run build:types",
    "build:esm": "esbuild src/index.ts --bundle --platform=node --target=node14 --format=esm --outfile=dist/index.js --external:node-fetch",
    "build:cjs": "esbuild src/index.ts --bundle --platform=node --target=node14 --format=cjs --outfile=dist/index.cjs --external:node-fetch",
    "build:types": "tsc --declaration --emitDeclarationOnly --outDir dist",
    "test": "jest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "igris",
    "igris-overture",
    "ai-routing",
    "llm",
    "openai",
    "anthropic",
    "cost-optimization",
    "byok"
  ],
  "author": "Igris Overture Team <hello@igris-overture.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Schlep-engine/igris-inertial.git",
    "directory": "igris-overture/sdk/javascript"
  },
  "bugs": {
    "url": "https://github.com/Schlep-engine/igris-inertial/issues"
  },
  "homepage": "https://github.com/Schlep-engine/igris-inertial#readme",
  "dependencies": {
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/node-fetch": "^2.6.11",
    "esbuild": "^0.19.0",
    "typescript": "^5.0.0",
    "jest": "^29.0.0",
    "@types/jest": "^29.0.0",
    "ts-jest": "^29.0.0"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
