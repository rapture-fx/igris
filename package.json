{
  "name": "schlep-engine-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Schlep-engine - The Data Schlep Handler. We handle the schlep so you don't have to",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"@schlep-engine/*\" --filter \"!@schlep-engine/config\" dev",
    "dev:backend": "cd apps/api && uvicorn app.main:app --reload --port 8000 --host 0.0.0.0",
    "dev:admin": "pnpm --filter @schlep-engine/web-admin dev",
    "dev:landing": "pnpm --filter @schlep-engine/web-landing dev",
    "dev:docs": "pnpm --filter @schlep-engine/web-docs dev",
    "dev:console": "pnpm --filter @schlep-engine/web-console dev",
    "dev:website": "./start-servers.sh",
    "dev:persistent": "./start-dev-server.sh start",
    "dev:stop": "./start-dev-server.sh stop",
    "dev:status": "./start-dev-server.sh status",
    "dev:restart": "./start-dev-server.sh restart",
    "build": "pnpm --parallel --filter \"@schlep-engine/*\" build",
    "build:clean": "pnpm --parallel --filter \"@schlep-engine/*\" -- \"pnpm run clean && pnpm run build\"",
    "start": "pnpm --parallel --filter \"@schlep-engine/*\" start",
    "clean": "pnpm --parallel --filter \"@schlep-engine/*\" clean",
    "lint": "pnpm --parallel --filter \"@schlep-engine/*\" lint",
    "test": "pnpm --parallel --filter \"@schlep-engine/*\" test",
    "test:oauth": "cypress run --spec 'cypress/e2e/oauth/**/*.cy.ts'",
    "test:oauth:open": "cypress open --config specPattern='cypress/e2e/oauth/**/*.cy.ts'",
    "test:oauth:performance": "cypress run --spec 'cypress/e2e/oauth/**/*.cy.ts' --env performance=true",
    "test:auth": "pnpm --filter @schlep-engine/ui test --testPathPattern=auth",
    "type-check": "pnpm --parallel --filter \"@schlep-engine/*\" type-check",
    "deps:check": "node scripts/check-dependencies.js",
    "deps:sync": "node scripts/sync-dependencies.js",
    "deps:audit": "pnpm audit --audit-level moderate",
    "deps:update": "pnpm update --latest --interactive",
    "deps:outdated": "pnpm outdated --recursive",
    "security:scan": "pnpm audit && node scripts/security-scan.js",
    "security:scan:python": "python3 scripts/check-python-dependencies.py",
    "security:scan:all": "pnpm security:scan && pnpm security:scan:python",
    "postinstall": "node scripts/post-install.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "@pnpm/find-workspace-packages": "^6.0.9",
    "semver": "^7.6.3",
    "chalk": "^5.3.0",
    "ora": "^8.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wiramahendra/Schlep-engine"
  },
  "keywords": [
    "data-processing",
    "data-cleaning",
    "csv-handler",
    "data-schlep",
    "data-preparation",
    "etl",
    "data-pipeline"
  ],
  "author": "Schlep-engine Team",
  "homepage": "https://schlep-engine.com",
  "dependencyVersions": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.29",
    "lucide-react": "^0.294.0",
    "next": "14.2.29",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.8.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  }
}