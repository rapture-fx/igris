    "@hookform/resolvers": "3.9.1",
    "@radix-ui/react-dialog": "1.1.2",
    "@radix-ui/react-dropdown-menu": "2.1.2",
    "@supabase/supabase-js": "^2.50.0",
    "@tanstack/react-query": "5.80.7",
    "@tanstack/react-query-devtools": "5.80.0",
    "@types/three": "^0.177.0",
    "axios": "1.7.9",
    "clsx": "2.1.1",
    "js-cookie": "3.0.5",
    "lucide-react": "0.468.0",
    "next": "14.2.29",
    "react": "18.3.1",
    "react-dom": "18.3.1",
