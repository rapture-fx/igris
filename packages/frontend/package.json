{
  "name": "pollarbase-web",
  "version": "1.0.0",
  "description": "Pollarbase AI-Powered Data Intelligence - Enterprise Data Intelligence Web Interface",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf .next && rm -rf node_modules/.cache",
    "fresh-install": "rm -rf node_modules && rm -rf pnpm-lock.yaml && pnpm install",
    "dev:clean": "pnpm run clean && pnpm run dev",
    "build:clean": "pnpm run clean && pnpm run build",
    "check-deps": "pnpm audit",
    "update-deps": "pnpm update --latest",
    "health-check": "node scripts/health-check.js"
  },
  "keywords": [
    "ai",
    "data-intelligence",
    "enterprise",
    "analytics",
    "next.js"
  ],
  "author": "Pollarbase AI Team",
  "license": "MIT",
