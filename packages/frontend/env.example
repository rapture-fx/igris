# =============================================================================
# SHERRINGFORDS AI PLATFORM - ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================
# Copy this file to .env.local for development
# Set these variables in Vercel dashboard for production/preview

# =============================================================================
# APPLICATION ENVIRONMENT
# =============================================================================
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_NAME="Sherringfords AI Platform"
NEXT_PUBLIC_APP_VERSION=1.0.0

# =============================================================================
# API CONFIGURATION
# =============================================================================
# Backend API URL (FastAPI server)
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_API_URL=http://localhost:8000

# External API endpoints
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# =============================================================================
# DATABASE CONFIGURATION (SUPABASE)
# =============================================================================
# Supabase Project Settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database Connection
DATABASE_URL=postgresql://user:password@host:port/database

# =============================================================================
# AUTHENTICATION & security
# =============================================================================
# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_IN=30d

# NextAuth.js (if using)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here

# =============================================================================
# THIRD-PARTY SERVICES
# =============================================================================
# Email Service (e.g., SendGrid, Resend)
EMAIL_FROM=noreply@sherringfords.com
SENDGRID_API_KEY=your-sendgrid-api-key
RESEND_API_KEY=your-resend-api-key

# File Storage (if using cloud storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=sherringfords-uploads

# Analytics & Monitoring
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX
SENTRY_DSN=https://your-sentry-dsn
VERCEL_ANALYTICS_ID=your-vercel-analytics-id

# =============================================================================
# FEATURE FLAGS
# =============================================================================
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_ERROR_REPORTING=true
NEXT_PUBLIC_ENABLE_BETA_FEATURES=false
NEXT_PUBLIC_MAINTENANCE_MODE=false

# =============================================================================
# DEVELOPMENT ONLY
# =============================================================================
# Debug settings (development only)
DEBUG=false
NEXT_PUBLIC_DEBUG_MODE=false
DISABLE_SSL_VERIFY=false

# =============================================================================
# ENVIRONMENT-SPECIFIC OVERRIDES
# =============================================================================
# These will be different for each environment:

# DEVELOPMENT
# NEXT_PUBLIC_API_URL=http://localhost:8000
# DATABASE_URL=postgresql://localhost:5432/sherringfords_dev

# STAGING/PREVIEW
# NEXT_PUBLIC_API_URL=https://api-staging.sherringfords.com
# DATABASE_URL=postgresql://staging-db-url

# PRODUCTION
# NEXT_PUBLIC_API_URL=https://api.sherringfords.com
# DATABASE_URL=postgresql://production-db-url 