# Pollarbase Production Environment Configuration
# Copy this file to environment.production and fill in the values

# Database Configuration
POSTGRES_PASSWORD=your_secure_postgres_password_here
DATABASE_URL=postgresql://pollarbase:your_secure_postgres_password_here@postgres:5432/pollarbase_prod

# Redis Configuration
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_URL=redis://:your_secure_redis_password_here@redis:6379/0

# JWT & Security
JWT_SECRET_KEY=your_very_secure_jwt_secret_key_at_least_64_characters_long_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
ENCRYPTION_KEY=your_32_character_encryption_key_here

# Application Settings
ENVIRONMENT=production
DEBUG=false
PROJECT_NAME=Pollarbase
API_V1_STR=/api/v1

# CORS Settings
BACKEND_CORS_ORIGINS=https://your-frontend-domain.com,https://www.your-frontend-domain.com

# File Upload & Storage
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=500MB
ALLOWED_FILE_TYPES=csv,json,xlsx,xls,txt,parquet,avro

# AWS S3 Configuration (for file storage)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=your-pollarbase-bucket
AWS_REGION=us-east-1

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Monitoring & Logging
GRAFANA_PASSWORD=your_secure_grafana_password
LOG_LEVEL=INFO

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# Email Configuration (for notifications)
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
FROM_EMAIL=noreply@your-domain.com

# Webhook Configuration
WEBHOOK_SECRET=your_webhook_secret_key

# Feature Flags
ENABLE_AI_PROCESSING=true
ENABLE_REAL_TIME_PROCESSING=true
ENABLE_ADVANCED_ANALYTICS=true

# Performance Settings
CELERY_WORKER_CONCURRENCY=4
UVICORN_WORKERS=4
MAX_CONNECTIONS=1000 