# ==================== DEVELOPMENT ENVIRONMENT CONFIGURATION ====================
# This file contains development-specific configuration values.
# DO NOT commit secrets to version control - use .env.development.local for secrets.

# ==================== CORE APPLICATION SETTINGS ====================
ENVIRONMENT=development
DEBUG=true
TESTING_MODE=false

# ==================== DATABASE SETTINGS ====================
# Database connection URL (update with your local PostgreSQL details)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/schlep_engine_dev

# Database connection components (for backward compatibility)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=schlep_engine_dev

# Connection pooling settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ==================== REDIS SETTINGS ====================
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ==================== JWT SETTINGS ====================
# IMPORTANT: Generate a secure secret key for development
# You can generate one using: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=dev_jwt_secret_key_change_in_production_2024_development_only
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==================== SECURITY SETTINGS ====================
# IMPORTANT: Generate a secure encryption key for development
# You can generate one using: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=dev_encryption_key_32_chars_long_development_only

# Rate limiting (relaxed for development)
RATE_LIMIT_PER_MINUTE=1000
RATE_LIMIT_PER_HOUR=10000

# Security features
ENHANCED_AUTH_ENABLED=true

# ==================== CORS SETTINGS ====================
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://127.0.0.1:3000

# ==================== FILE UPLOAD SETTINGS ====================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=100MB
ALLOWED_FILE_TYPES=csv,json,xlsx,xls,txt,parquet

# ==================== CLOUD STORAGE SETTINGS ====================
# Google Cloud Storage Configuration
CLOUD_STORAGE_ENABLED=false
CLOUD_STORAGE_PROVIDER=gcs
GCS_BUCKET_NAME=schlep-engine-dev-uploads
GCS_PROJECT_ID=your-gcs-project-id
GCS_CREDENTIALS_PATH=./gcs-credentials.json
GCS_REGION=us-central1

# File retention and cleanup settings
FILE_RETENTION_DAYS=30
ENABLE_AUTOMATIC_CLEANUP=true
CLEANUP_BATCH_SIZE=100

# ==================== CDN SETTINGS ====================
# CDN Configuration (optional for development)
CDN_ENABLED=false
CDN_PROVIDER=cloudflare
CDN_DOMAIN=your-cdn-domain.com
CDN_API_TOKEN=your-cdn-api-token

# Cache settings
CDN_CACHE_DURATION=3600
CDN_CACHE_HEADERS=true

# ==================== CELERY SETTINGS ====================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ==================== EXTERNAL SERVICES ====================
# Stripe (leave empty for development unless testing payments)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# AI Model Settings
MODEL_PATH=models/
BATCH_SIZE=32

# ==================== MONITORING SETTINGS ====================
ENABLE_METRICS=true
PROMETHEUS_MULTIPROC_DIR=/tmp

# ==================== SSL/TLS CONFIGURATION ====================
# SSL is optional in development - set these if you want HTTPS
# SSL_CERT_PATH=./ssl/development.crt
# SSL_KEY_PATH=./ssl/development.key
# SSL_CA_PATH=./ssl/development_ca.crt

# ==================== SECURITY FEATURE FLAGS ====================
# Development-specific security settings (relaxed for easier development)
SECURITY_ENCRYPTION_ENABLED=false
SECURITY_AUDIT_ENABLED=true
SECURITY_MFA_ENABLED=false
SECURITY_MONITORING_ENABLED=false
SECURITY_PERMISSIONS_ENABLED=true
SECURITY_RATE_LIMITING_ENABLED=false
SECURITY_HEADERS_ENABLED=true
SECURITY_PII_DETECTION_ENABLED=true
SECURITY_COMPLIANCE_ENABLED=false
SECURITY_DATA_CLASSIFICATION_ENABLED=false 