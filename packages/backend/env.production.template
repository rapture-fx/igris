# ==================== PRODUCTION ENVIRONMENT CONFIGURATION ====================
# This file contains production-specific configuration values.
# DO NOT commit secrets to version control - use environment variables or secrets manager.

# ==================== CORE APPLICATION SETTINGS ====================
ENVIRONMENT=production
DEBUG=false
TESTING_MODE=false

# ==================== DATABASE SETTINGS ====================
# Database connection URL (set via environment variable in deployment)
DATABASE_URL=postgresql://postgres:password@production-db:5432/schlep_engine_prod

# Database connection components (for backward compatibility)
DB_HOST=production-db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=schlep_engine_prod

# Connection pooling settings (optimized for production)
DB_POOL_SIZE=50
DB_MAX_OVERFLOW=100

# ==================== REDIS SETTINGS ====================
REDIS_URL=redis://production-redis:6379/0
REDIS_HOST=production-redis
REDIS_PORT=6379
REDIS_DB=0

# ==================== JWT SETTINGS ====================
# IMPORTANT: Set these via environment variables or secrets manager
JWT_SECRET_KEY=your_production_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==================== SECURITY SETTINGS ====================
# IMPORTANT: Set these via environment variables or secrets manager
ENCRYPTION_KEY=your_production_encryption_key_here

# Rate limiting (strict for production)
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Security features
ENHANCED_AUTH_ENABLED=true

# ==================== CORS SETTINGS ====================
BACKEND_CORS_ORIGINS=https://schlep-engine.com,https://www.schlep-engine.com,https://admin.schlep-engine.com

# ==================== FILE UPLOAD SETTINGS ====================
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=100MB
ALLOWED_FILE_TYPES=csv,json,xlsx,xls,txt,parquet

# ==================== CELERY SETTINGS ====================
CELERY_BROKER_URL=redis://production-redis:6379/0
CELERY_RESULT_BACKEND=redis://production-redis:6379/1

# ==================== EXTERNAL SERVICES ====================
# Stripe (use production keys)
STRIPE_API_KEY=sk_live_your_production_stripe_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_production_webhook_secret_here

# AI Model Settings
MODEL_PATH=/app/models/
BATCH_SIZE=128

# ==================== MONITORING SETTINGS ====================
ENABLE_METRICS=true
PROMETHEUS_MULTIPROC_DIR=/tmp

# ==================== SSL/TLS CONFIGURATION ====================
# SSL is required in production - set these via environment variables or secrets manager
# SSL_CERT_PATH=/path/to/production.crt
# SSL_KEY_PATH=/path/to/production.key
# SSL_CA_PATH=/path/to/production_ca.crt

# ==================== SECURITY FEATURE FLAGS ====================
# Production-specific security settings (maximum security)
SECURITY_ENCRYPTION_ENABLED=true
SECURITY_AUDIT_ENABLED=true
SECURITY_MFA_ENABLED=false
SECURITY_MONITORING_ENABLED=true
SECURITY_PERMISSIONS_ENABLED=true
SECURITY_RATE_LIMITING_ENABLED=true
SECURITY_HEADERS_ENABLED=true
SECURITY_PII_DETECTION_ENABLED=true
SECURITY_COMPLIANCE_ENABLED=true
SECURITY_DATA_CLASSIFICATION_ENABLED=true 