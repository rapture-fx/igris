{
  // Server configuration
  server: {
    host: "0.0.0.0",
    port: 8080
  },

  // Storage configuration
  storage: {
    path: "igris.db"
  },

  // Local LLM fallback (NEW in v1.1)
  local_fallback: {
    enabled: false,  // Set to true after downloading model
    model_path: "models/phi-3-mini-4k-instruct-q4.gguf",
    context_size: 4096,
    threads: 4,
    max_tokens: 512,
    temperature: 0.7,
    cost_per_1k_tokens: 0.0
  },

  // Cloud providers (add your API keys)
  providers: [
    {
      id: "openai-gpt4",
      name: "OpenAI GPT-4 Turbo",
      endpoint: "https://api.openai.com/v1",
      model: "gpt-4-turbo-preview",
      api_key_env: "OPENAI_API_KEY",
      cost_per_1k_input: 0.01,
      cost_per_1k_output: 0.03,
      capabilities: ["reasoning", "coding"]
    },
    {
      id: "anthropic-sonnet",
      name: "Claude 3.5 Sonnet",
      endpoint: "https://api.anthropic.com/v1",
      model: "claude-3-5-sonnet-20241022",
      api_key_env: "ANTHROPIC_API_KEY",
      cost_per_1k_input: 0.003,
      cost_per_1k_output: 0.015,
      capabilities: ["reasoning", "coding", "long_context"]
    },
    {
      id: "groq-llama70b",
      name: "Groq Llama 3 70B",
      endpoint: "https://api.groq.com/openai/v1",
      model: "llama3-70b-8192",
      api_key_env: "GROQ_API_KEY",
      cost_per_1k_input: 0.0007,
      cost_per_1k_output: 0.0008,
      capabilities: ["fast", "coding"]
    }
  ],

  // Routing configuration
  routing: {
    thompson_sampling: {
      enabled: true,
      exploration_rate: 0.1
    },
    speculative: {
      enabled: true,
      max_providers: 3,
      first_token_timeout_ms: 5000
    },
    council: {
      enabled: true,
      chairman: "anthropic-sonnet"
    }
  },

  // Authentication
  auth: {
    api_key: "igris-dev-key-change-in-production"
  }
}
